<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <%- include('../partials/head') %>

  <!-- Google Fonts: Plus Jakarta Sans, Outfit & Cinzel (Tipografia Gótica / Dark Fantasy) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Google Material Symbols Oficial (Sem Emojis) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Biblioteca SweetAlert2 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    /* ==========================================================================
       JOKER RPG — CAMPO DE BATALHA DARK FANTASY (DESIGN CHAPADO DIABLO / MMO)
       Molduras em Ferro Forjado, HUD de Combate Tático e Orbe Elemental Central
       ========================================================================== */

    :root[data-theme="dark"] {
      --gothic-bg: #070303;
      --gothic-frame-bg: #140707;
      --gothic-panel: #0d0404;
      --gothic-panel-card: linear-gradient(180deg, #180808 0%, #0d0303 100%);
      --gothic-border-outer: #381010;
      --gothic-border-gold: #b38b4d;
      --gothic-border-gold-glow: rgba(179, 139, 77, 0.45);
      --gothic-filigree: #8a6530;
      --gothic-text: #eae0d5;
      --gothic-text-gold: #d4af37;
      --gothic-text-muted: #8e7a6d;
      --gothic-red-glow: rgba(220, 38, 38, 0.7);
      --gothic-slot-bg: #190505;
      --gothic-slot-border: #4a1515;
      --gothic-hotbar-bg: #100505;
    }

    :root[data-theme="light"] {
      --gothic-bg: #ece6dc;
      --gothic-frame-bg: #dcd3c3;
      --gothic-panel: #f4eee2;
      --gothic-panel-card: linear-gradient(180deg, #ffffff 0%, #f1e9dc 100%);
      --gothic-border-outer: #8a6e55;
      --gothic-border-gold: #966f2d;
      --gothic-border-gold-glow: rgba(150, 111, 45, 0.3);
      --gothic-filigree: #78531e;
      --gothic-text: #261c14;
      --gothic-text-gold: #825a17;
      --gothic-text-muted: #6e5a4c;
      --gothic-red-glow: rgba(185, 28, 28, 0.4);
      --gothic-slot-bg: #e2d7c5;
      --gothic-slot-border: #9c846e;
      --gothic-hotbar-bg: #cfc2ad;
    }

    body {
      background: var(--gothic-bg) !important;
      color: var(--gothic-text);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      user-select: none;
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    .material-symbols-outlined {
      font-family: 'Material Symbols Outlined';
      font-weight: 500;
      font-size: 20px;
      line-height: 1;
      display: inline-block;
      vertical-align: middle;
    }

    .gothic-battle-wrapper {
      max-width: 1400px;
      margin: 15px auto 40px auto;
      padding: 0 16px;
    }

    /* Moldura Principal de Ferro e Pedra */
    .gothic-main-frame {
      background: var(--gothic-frame-bg);
      border: 4px solid var(--gothic-border-outer);
      border-radius: 4px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.95), inset 0 0 30px rgba(0, 0, 0, 0.85);
      position: relative;
      padding: 8px;
    }

    /* Cantoneiras Metálicas */
    .gothic-corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border: 2.5px solid var(--gothic-border-gold);
      z-index: 10;
      pointer-events: none;
    }
    .gothic-corner.top-left { top: 2px; left: 2px; border-right: none; border-bottom: none; }
    .gothic-corner.top-right { top: 2px; right: 2px; border-left: none; border-bottom: none; }
    .gothic-corner.bottom-left { bottom: 2px; left: 2px; border-right: none; border-top: none; }
    .gothic-corner.bottom-right { bottom: 2px; right: 2px; border-left: none; border-top: none; }

    /* Barra Superior do HUD da Sala */
    .gothic-hud-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #2d0b0b;
      background: #090202;
      padding: 8px 16px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .hud-meta-badge {
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 1.5px;
      padding: 3px 10px;
      background: #190505;
      border: 1px solid var(--gothic-border-gold);
      color: var(--gothic-text-gold);
      border-radius: 2px;
    }

    .hud-turn-indicator {
      font-family: 'Cinzel', serif;
      font-size: 0.95rem;
      font-weight: 800;
      letter-spacing: 2px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .turn-status-pill {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 1.5px;
      padding: 2px 10px;
      border-radius: 2px;
    }

    .turn-status-pill.my-turn {
      background: #0284c7;
      color: #fff;
      box-shadow: 0 0 10px rgba(2, 132, 199, 0.7);
    }

    .turn-status-pill.opp-turn {
      background: #990000;
      color: #fff;
      box-shadow: 0 0 10px rgba(153, 0, 0, 0.7);
    }

    /* Zonas dos Combatentes (Oponente no Topo & Jogador na Base) */
    .combatant-stone-panel {
      background: var(--gothic-panel);
      border: 2px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.9);
      padding: 14px 18px;
      margin: 10px;
      position: relative;
      transition: all 0.2s ease;
    }

    .combatant-stone-panel.active-turn {
      border-color: #ffaa00;
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.8), 0 0 16px var(--gothic-border-gold-glow);
    }

    .combatant-stone-panel.broken {
      border-color: #ff2222 !important;
      animation: gothicBreakGlow 0.8s infinite alternate ease-in-out;
    }

    @keyframes gothicBreakGlow {
      0% { box-shadow: 0 0 6px rgba(255, 34, 34, 0.5); }
      100% { box-shadow: 0 0 20px rgba(255, 34, 34, 0.9); }
    }

    .combatant-portrait-frame {
      width: 76px;
      height: 76px;
      border-radius: 4px;
      border: 2px solid var(--gothic-border-gold);
      overflow: hidden;
      background: #000;
      flex-shrink: 0;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.8);
    }

    .combatant-portrait-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }

    /* Barras de Vida e Postura (Gauges Góticas de Sangue e Ouro) */
    .gothic-gauge-row {
      margin-bottom: 6px;
    }

    .gothic-gauge-meta {
      display: flex;
      justify-content: space-between;
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      letter-spacing: 1px;
      font-weight: 700;
      margin-bottom: 2px;
    }

    .gothic-gauge-track {
      height: 11px;
      background: #050101;
      border: 1px solid var(--gothic-border-gold);
      border-radius: 2px;
      position: relative;
      overflow: hidden;
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.9);
    }

    .gothic-gauge-fill-hp {
      height: 100%;
      background: linear-gradient(90deg, #7a0808 0%, #dc2626 70%, #ef4444 100%);
      box-shadow: 0 0 8px rgba(220, 38, 38, 0.7);
      transition: width 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .gothic-gauge-fill-break {
      height: 100%;
      background: linear-gradient(90deg, #b45309 0%, #f59e0b 70%, #fde047 100%);
      box-shadow: 0 0 8px rgba(245, 158, 11, 0.7);
      transition: width 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .gothic-gauge-fill-energy {
      height: 100%;
      background: linear-gradient(90deg, #0369a1 0%, #0284c7 70%, #38bdf8 100%);
      box-shadow: 0 0 8px rgba(2, 132, 199, 0.7);
      transition: width 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    /* Terminal Central de Telemetria e Logs */
    .gothic-log-terminal {
      background: #060101;
      border: 1px solid rgba(179, 139, 77, 0.3);
      border-radius: 2px;
      padding: 10px 14px;
      margin: 4px 10px;
      height: 115px;
      overflow-y: auto;
      font-family: var(--font-mono);
      font-size: 0.76rem;
      color: var(--gothic-text-muted);
      display: flex;
      flex-direction: column;
      gap: 3px;
      box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.95);
    }

    .log-entry-line {
      line-height: 1.35;
    }

    /* Controles de Posturas Defensivas */
    .gothic-stances-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin: 8px 10px;
      flex-wrap: wrap;
    }

    .gothic-btn-stance {
      font-family: 'Cinzel', serif;
      font-weight: 800;
      font-size: 0.76rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 6px 16px;
      border-radius: 2px;
      border: 1px solid var(--gothic-border-gold);
      background: linear-gradient(180deg, #3d1414 0%, #170505 100%);
      color: #ffffff;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
      transition: all 0.15s ease;
    }

    .gothic-btn-stance:hover:not(:disabled) {
      background: linear-gradient(180deg, #6c1c1c 0%, #2e0909 100%);
      border-color: #ffaa00;
      color: #ffdd44;
      transform: translateY(-2px);
    }

    .gothic-btn-stance:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      border-color: var(--gothic-border-outer);
    }

    /* Mão de Cartas Táticas do Jogador (Com card1, card2, card3) */
    .gothic-hand-tray {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding: 10px 4px;
      justify-content: center;
      align-items: center;
      min-height: 200px;
      margin: 0 10px;
    }

    .gothic-battle-card {
      flex: 0 0 138px;
      height: 190px;
      background: #000;
      border: 2px solid var(--gothic-border-gold);
      border-radius: 2px;
      position: relative;
      overflow: hidden;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.8);
      transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .gothic-battle-card:hover {
      transform: translateY(-16px) scale(1.06);
      border-color: #ffaa00;
      box-shadow: 0 0 18px var(--gothic-border-gold-glow), 0 14px 28px rgba(0, 0, 0, 0.9);
      z-index: 50;
    }

    .gothic-battle-card.unplayable {
      opacity: 0.4;
      filter: grayscale(0.85);
      cursor: not-allowed;
    }

    .gothic-battle-card.unplayable:hover {
      transform: none;
      box-shadow: none;
    }

    .battle-card-bg-art {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.72;
      transition: transform 0.3s ease;
      z-index: 1;
    }

    .gothic-battle-card:hover .battle-card-bg-art {
      transform: scale(1.08);
      opacity: 0.88;
    }

    .battle-card-overlay-data {
      position: relative;
      z-index: 2;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 6px;
      background: linear-gradient(180deg, rgba(10, 2, 2, 0.85) 0%, transparent 40%, rgba(10, 2, 2, 0.95) 85%);
    }

    /* Barra Inferior com Orbe da Facção Estilo Diablo */
    .gothic-bottom-hotbar {
      background: var(--gothic-hotbar-bg);
      border-top: 2px solid #3d0c0c;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      margin-top: 10px;
    }

    .gothic-orb-assembly {
      position: absolute;
      left: 50%;
      top: -24px;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 25;
    }

    .gothic-orb-sphere {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      box-shadow: 0 0 25px var(--orb-glow), inset 0 -6px 14px rgba(0, 0, 0, 0.8);
      position: relative;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease;
    }

    .gothic-orb-sphere:hover {
      transform: scale(1.08);
    }

    /* Variações do Orbe por Elemento */
    .gothic-orb-sphere.FIRE {
      background: radial-gradient(circle at 35% 30%, #ff7700 0%, #cc1100 50%, #440000 100%);
      --orb-glow: rgba(255, 60, 0, 0.85);
    }
    .gothic-orb-sphere.WATER {
      background: radial-gradient(circle at 35% 30%, #38bdf8 0%, #0284c7 50%, #082f49 100%);
      --orb-glow: rgba(56, 189, 248, 0.85);
    }
    .gothic-orb-sphere.DARK {
      background: radial-gradient(circle at 35% 30%, #c084fc 0%, #7e22ce 50%, #2e1065 100%);
      --orb-glow: rgba(192, 132, 252, 0.85);
    }
    .gothic-orb-sphere.WIND {
      background: radial-gradient(circle at 35% 30%, #34d399 0%, #059669 50%, #022c22 100%);
      --orb-glow: rgba(52, 211, 153, 0.85);
    }
    .gothic-orb-sphere.EARTH {
      background: radial-gradient(circle at 35% 30%, #fbbf24 0%, #b45309 50%, #451a03 100%);
      --orb-glow: rgba(251, 191, 36, 0.85);
    }
    .gothic-orb-sphere.LIGHTNING {
      background: radial-gradient(circle at 35% 30%, #fde047 0%, #eab308 50%, #713f12 100%);
      --orb-glow: rgba(253, 224, 71, 0.85);
    }
    .gothic-orb-sphere.LIGHT {
      background: radial-gradient(circle at 35% 30%, #ffffff 0%, #fef08a 50%, #a16207 100%);
      --orb-glow: rgba(254, 240, 138, 0.95);
    }

    .gothic-orb-element-img {
      width: 32px;
      height: 32px;
      object-fit: contain;
      filter: drop-shadow(0 0 6px #ffffff);
    }

    @media (max-width: 768px) {
      .gothic-hud-topbar {
        flex-direction: column;
        align-items: flex-start;
      }
      .gothic-battle-card {
        flex: 0 0 115px;
        height: 165px;
      }
      .gothic-orb-assembly {
        position: static;
        transform: none;
        margin: 10px auto;
      }
      .gothic-bottom-hotbar {
        flex-direction: column;
        gap: 16px;
      }
    }
  </style>
</head>
<body>
  <!-- Helper EJS para Mapear Imagens dos Heróis e das Cartas -->
  <%
    function getHeroLocalImage(name, id) {
      if (!name) return `/images/character/${id}`;
      const n = name.toLowerCase();
      let slug = 'default-avatar';
      if (n.includes('kage')) slug = 'kage';
      else if (n.includes('ignis')) slug = 'ignis';
      else if (n.includes('aegis')) slug = 'aegis';
      else if (n.includes('sylph')) slug = 'sylph';
      else if (n.includes('raikou')) slug = 'raikou';
      else if (n.includes('lumina')) slug = 'lumina';
      else if (n.includes('aqua')) slug = 'aqua';
      return `/images/characters/${slug}.png`;
    }

    function getCardArtByType(type) {
      if (type === 'ATTACK') return '/images/cards/card1.png';
      if (type === 'DEFENSE') return '/images/cards/card2.png';
      return '/images/cards/card3.png';
    }

    const playerHeroImg = getHeroLocalImage(player.characterName, player.characterId);
    const oppHeroImg = getHeroLocalImage(opponent.characterName, opponent.characterId);
    const playerElement = player.element ? player.element.toUpperCase() : 'FIRE';
  %>

  <!-- ========================================================================
       HUD DE COMBATE TÁTICO GÓTICO (BATTLE ROOM)
       ======================================================================== -->
  <main class="gothic-battle-wrapper">
    <div class="gothic-main-frame">
      <!-- Cantoneiras Ornamentais de Ferro e Ouro -->
      <span class="gothic-corner top-left"></span>
      <span class="gothic-corner top-right"></span>
      <span class="gothic-corner bottom-left"></span>
      <span class="gothic-corner bottom-right"></span>

      <!-- 1. Header do HUD: Sala, Modo, Rodada e Botão de Rendição -->
      <header class="gothic-hud-topbar">
        <div class="d-flex align-items-center gap-2">
          <span class="hud-meta-badge"><%= battleMode %></span>
          <span class="font-monospace small text-dim">SALA: <strong class="text-main">#<%= battleId.slice(0, 8) %></strong></span>
        </div>

        <!-- Indicador Central de Turno -->
        <div class="hud-turn-indicator">
          <span class="text-dim">RODADA</span>
          <span class="text-warning fw-bold" id="turnCounterText">#<%= turnNumber %></span>
          <span class="turn-status-pill <%= isMyTurn ? 'my-turn' : 'opp-turn' %>" id="turnIndicatorBadge">
            <%= isMyTurn ? 'SEU TURNO' : 'TURNO DO OPONENTE' %>
          </span>
        </div>

        <div class="d-flex align-items-center gap-2">
          <button type="button" class="gothic-theme-toggle-btn" onclick="toggleGothicTheme()" title="Alternar Modo Claro e Escuro">
            <span class="material-symbols-outlined" style="font-size: 16px;">contrast</span>
          </button>

          <button class="gothic-btn-stance" style="border-color: #990000; color: #ff6666;" onclick="concedeBattle()">
            <span class="material-symbols-outlined" style="font-size: 16px;">flag</span> Render-se
          </button>
        </div>
      </header>

      <!-- 2. ZONA DO OPONENTE (TOPO) -->
      <section class="combatant-stone-panel <%= !isMyTurn ? 'active-turn' : '' %> <%= opponent.isBroken ? 'broken' : '' %>" id="opponentZone">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
          <!-- Identidade e Retrato do Oponente -->
          <div class="d-flex align-items-center gap-3">
            <div class="combatant-portrait-frame">
              <img 
                src="<%= oppHeroImg %>" 
                alt="<%= opponent.characterName %>" 
                class="combatant-portrait-img" 
                onerror="this.onerror=null; this.src='/images/character-avatar/<%= opponent.characterId %>'; if(this.src.endsWith('/default-avatar.png')) this.src='/images/default-avatar.png';"
              >
            </div>
            <div>
              <div class="d-flex align-items-center gap-2">
                <span class="font-monospace fw-bold text-main fs-6"><%= opponent.username %></span>
                <img src="/images/icons/<%= (opponent.element || 'fire').toLowerCase() %>.png" alt="<%= opponent.element %>" style="width: 16px; height: 16px; object-fit: contain;" onerror="this.style.display='none'">
              </div>
              <div class="font-monospace small text-dim">
                <span><%= opponent.characterName %></span> &bull; <span><%= opponent.characterClass %></span>
              </div>
              <div class="d-flex gap-1 mt-1" id="opponentStatusBadges">
                <% if (opponent.isBroken) { %>
                  <span class="badge bg-danger font-monospace" style="font-size: 0.65rem;">BREAK!</span>
                <% } %>
                <% if (opponent.defensiveStance && opponent.defensiveStance !== 'NONE') { %>
                  <span class="badge font-monospace" style="background: #b38b4d; color: #000; font-size: 0.65rem;"><%= opponent.defensiveStance %></span>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Barras de HP e Break do Oponente -->
          <div class="flex-grow-1" style="max-width: 480px;">
            <!-- HP Oponente -->
            <div class="gothic-gauge-row">
              <div class="gothic-gauge-meta">
                <span class="text-danger"><span class="material-symbols-outlined" style="font-size: 14px;">favorite</span> HP OPONENTE</span>
                <span id="opponentHpText"><%= opponent.hp %> / <%= opponent.maxHp %></span>
              </div>
              <div class="gothic-gauge-track">
                <div class="gothic-gauge-fill-hp" id="opponentHpBar" style="width: <%= Math.max(0, (opponent.hp / opponent.maxHp) * 100) %>%;"></div>
              </div>
            </div>

            <!-- Break Gauge Oponente -->
            <div class="gothic-gauge-row mb-0">
              <div class="gothic-gauge-meta">
                <span class="text-warning"><span class="material-symbols-outlined" style="font-size: 14px;">bolt</span> POSTURA (BREAK)</span>
                <span id="opponentBreakText"><%= opponent.breakGauge %>%</span>
              </div>
              <div class="gothic-gauge-track">
                <div class="gothic-gauge-fill-break" id="opponentBreakBar" style="width: <%= Math.max(0, opponent.breakGauge) %>%;"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. ZONA CENTRAL: TERMINAL DE TELEMETRIA E LOGS -->
      <section class="gothic-log-terminal" id="combatLogTerminal">
        <% if (logs && logs.length > 0) { %>
          <% logs.forEach(function(l) { %>
            <div class="log-entry-line">&gt; <%= l %></div>
          <% }); %>
        <% } %>
      </section>

      <!-- 4. ZONA DO JOGADOR (BASE) -->
      <section class="combatant-stone-panel <%= isMyTurn ? 'active-turn' : '' %> <%= player.isBroken ? 'broken' : '' %>" id="playerZone">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
          <!-- Identidade e Retrato do Jogador -->
          <div class="d-flex align-items-center gap-3">
            <div class="combatant-portrait-frame">
              <img 
                src="<%= playerHeroImg %>" 
                alt="<%= player.characterName %>" 
                class="combatant-portrait-img" 
                onerror="this.onerror=null; this.src='/images/character-avatar/<%= player.characterId %>'; if(this.src.endsWith('/default-avatar.png')) this.src='/images/default-avatar.png';"
              >
            </div>
            <div>
              <div class="d-flex align-items-center gap-2">
                <span class="font-monospace fw-bold text-main fs-6"><%= player.username %></span>
                <img src="/images/icons/<%= (player.element || 'fire').toLowerCase() %>.png" alt="<%= player.element %>" style="width: 16px; height: 16px; object-fit: contain;" onerror="this.style.display='none'">
              </div>
              <div class="font-monospace small text-dim">
                <span><%= player.characterName %></span> &bull; 
                <span class="text-warning fw-bold" id="playerEnergyDisplay">⚡ <%= player.energy %>/10 ENERGIA</span>
              </div>
              <div class="d-flex gap-1 mt-1" id="playerStatusBadges">
                <% if (player.isBroken) { %>
                  <span class="badge bg-danger font-monospace" style="font-size: 0.65rem;">BREAK!</span>
                <% } %>
                <% if (player.defensiveStance && player.defensiveStance !== 'NONE') { %>
                  <span class="badge font-monospace" style="background: #b38b4d; color: #000; font-size: 0.65rem;"><%= player.defensiveStance %></span>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Barras de HP, Break e Energia do Jogador -->
          <div class="flex-grow-1" style="max-width: 480px;">
            <!-- HP Jogador -->
            <div class="gothic-gauge-row">
              <div class="gothic-gauge-meta">
                <span class="text-danger"><span class="material-symbols-outlined" style="font-size: 14px;">favorite</span> MEU HP</span>
                <span id="playerHpText"><%= player.hp %> / <%= player.maxHp %></span>
              </div>
              <div class="gothic-gauge-track">
                <div class="gothic-gauge-fill-hp" id="playerHpBar" style="width: <%= Math.max(0, (player.hp / player.maxHp) * 100) %>%;"></div>
              </div>
            </div>

            <!-- Break Gauge Jogador -->
            <div class="gothic-gauge-row">
              <div class="gothic-gauge-meta">
                <span class="text-warning"><span class="material-symbols-outlined" style="font-size: 14px;">bolt</span> MINHA POSTURA</span>
                <span id="playerBreakText"><%= player.breakGauge %>%</span>
              </div>
              <div class="gothic-gauge-track">
                <div class="gothic-gauge-fill-break" id="playerBreakBar" style="width: <%= Math.max(0, player.breakGauge) %>%;"></div>
              </div>
            </div>

            <!-- Energia Jogador -->
            <div class="gothic-gauge-row mb-0">
              <div class="gothic-gauge-meta">
                <span class="text-info"><span class="material-symbols-outlined" style="font-size: 14px;">battery_charging_full</span> ENERGIA TÁTICA</span>
                <span id="playerEnergyBarText"><%= player.energy %> / 10</span>
              </div>
              <div class="gothic-gauge-track">
                <div class="gothic-gauge-fill-energy" id="playerEnergyBar" style="width: <%= Math.min(100, (player.energy / 10) * 100) %>%;"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. Controles Rápidos de Postura Defensiva -->
      <div class="gothic-stances-controls">
        <button class="gothic-btn-stance" id="blockBtn" onclick="executeTacticalAction('BLOCK')" <%= (!isMyTurn || player.energy < 1 || player.isBroken) ? 'disabled' : '' %>>
          <span class="material-symbols-outlined" style="font-size: 16px;">shield</span> BLOCK (1⚡)
        </button>
        <button class="gothic-btn-stance" id="dodgeBtn" onclick="executeTacticalAction('DODGE')" <%= (!isMyTurn || player.energy < 1 || player.isBroken) ? 'disabled' : '' %>>
          <span class="material-symbols-outlined" style="font-size: 16px;">air</span> DODGE (1⚡)
        </button>
        <button class="gothic-btn-stance" id="counterBtn" onclick="executeTacticalAction('COUNTER')" <%= (!isMyTurn || player.energy < 2 || player.isBroken) ? 'disabled' : '' %>>
          <span class="material-symbols-outlined" style="font-size: 16px;">replay</span> COUNTER (2⚡)
        </button>
        <button class="gothic-btn-stance" id="passTurnBtn" style="border-color: #ffaa00; color: #ffcc00;" onclick="passTurn()" <%= (!isMyTurn) ? 'disabled' : '' %>>
          <span class="material-symbols-outlined" style="font-size: 16px;">hourglass_empty</span> PASSAR TURNO
        </button>
      </div>

      <!-- 6. Mão de Cartas Táticas do Jogador (Com card1.png, card2.png, card3.png) -->
      <div class="gothic-hand-tray" id="playerHandContainer">
        <% if (player.hand && player.hand.length > 0) { %>
          <% player.hand.forEach(function(card) { %>
            <% 
              const canPlay = isMyTurn && player.energy >= card.energy_cost; 
              const artPath = getCardArtByType(card.type);
            %>
            <div 
              class="gothic-battle-card <%= !canPlay ? 'unplayable' : '' %>"
              id="handCard_<%= card.id %>"
              onclick="playCardAction('<%= card.id %>', '<%= card.type %>', <%= card.energy_cost %>)"
            >
              <!-- Ilustração Real card1, card2 ou card3 da Pasta /images/cards/ -->
              <img src="<%= artPath %>" alt="<%= card.name %>" class="battle-card-bg-art" onerror="this.onerror=null; this.src='/images/card-back.png';">

              <div class="battle-card-overlay-data">
                <div class="d-flex justify-content-between align-items-center font-monospace" style="font-size: 0.65rem;">
                  <span class="text-warning fw-bold">⚡ <%= card.energy_cost %></span>
                  <img src="/images/icons/<%= (card.element || 'fire').toLowerCase() %>.png" alt="<%= card.element %>" style="width: 14px; height: 14px; object-fit: contain;" onerror="this.style.display='none'">
                </div>

                <div class="text-center">
                  <span class="fw-bold text-main d-block font-monospace text-truncate" style="font-size: 0.7rem;"><%= card.name %></span>
                  <span class="text-dim font-monospace" style="font-size: 0.6rem;"><%= card.type %></span>
                </div>

                <div class="d-flex justify-content-between font-monospace text-dim" style="font-size: 0.62rem;">
                  <span class="text-danger fw-bold">⚔ <%= card.damage || 0 %></span>
                  <span class="text-warning fw-bold">💥 <%= card.break_damage || 0 %></span>
                </div>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>

      <!-- 7. Barra Inferior com Orbe Elemental Central Estilo Diablo -->
      <footer class="gothic-bottom-hotbar">
        <div class="d-flex align-items-center gap-2">
          <a href="/battle" class="gothic-tab-link" title="Sair da Sala">
            <span class="material-symbols-outlined" style="font-size: 22px;">arrow_back</span>
          </a>
          <a href="/decks" class="gothic-tab-link" title="Baralhos">
            <span class="material-symbols-outlined" style="font-size: 22px;">backpack</span>
          </a>
        </div>

        <!-- ORBE ELEMENTAL CENTRAL CONFORME A FACÇÃO DO JOGADOR -->
        <div class="gothic-orb-assembly">
          <div class="gothic-orb-sphere <%= playerElement %>" title="Facção Elemental: <%= playerElement %>">
            <img 
              src="/images/icons/<%= playerElement.toLowerCase() %>.png" 
              alt="<%= playerElement %>" 
              class="gothic-orb-element-img"
              onerror="this.style.display='none'"
            >
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/history" class="gothic-tab-link" title="Histórico">
            <span class="material-symbols-outlined" style="font-size: 22px;">history</span>
          </a>
          <a href="/dashboard" class="gothic-tab-link" title="Quartel-General">
            <span class="material-symbols-outlined" style="font-size: 22px;">dashboard</span>
          </a>
        </div>
      </footer>
    </div>
  </main>

  <!-- ========================================================================
       LÓGICA JAVASCRIPT: SOCKET.IO, MOTOR DE TEMA E CONTROLES DE COMBATE
       ======================================================================== -->
  <script>
    const battleId = "<%= battleId %>";
    const currentUserId = "<%= player.userId %>";
    let isMyTurn = <%= isMyTurn ? 'true' : 'false' %>;
    let playerEnergy = <%= player.energy %>;
    let isProcessingAction = false;
    let socket = null;

    // 1. Motor de Alternância de Tema Claro e Escuro
    function applyGothicTheme() {
      const theme = localStorage.getItem('joker_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
    }

    function toggleGothicTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('joker_theme', next);

      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playUiClick();
      }
    }

    applyGothicTheme();

    // 2. Conexão em Tempo Real via Socket.IO
    if (typeof io !== 'undefined') {
      socket = io({
        transports: ['websocket', 'polling'],
        withCredentials: true
      });

      socket.on('connect', () => {
        socket.emit('battle:join_room', { battleId });
      });

      socket.on('battle:state_update', (data) => {
        applyStateUpdate(data.battle);
      });

      socket.on('battle:turn_changed', (data) => {
        applyStateUpdate(data.battle);
      });

      socket.on('battle:finished', (data) => {
        handleBattleFinished(data);
      });

      socket.on('battle:error', (data) => {
        Swal.fire({
          title: 'Atenção Tática',
          text: data.message || 'Falha ao executar manobra de combate.',
          icon: 'warning',
          confirmButtonColor: '#781c2f',
          background: '#140707',
          color: '#eae0d5'
        });
        isProcessingAction = false;
      });
    }

    function scrollTerminalToBottom() {
      const term = document.getElementById('combatLogTerminal');
      if (term) term.scrollTop = term.scrollHeight;
    }

    scrollTerminalToBottom();

    function getCardArtByType(type) {
      if (type === 'ATTACK') return '/images/cards/card1.png';
      if (type === 'DEFENSE') return '/images/cards/card2.png';
      return '/images/cards/card3.png';
    }

    // 3. Atualização Reativa do DOM com o Novo Estado
    function applyStateUpdate(battle) {
      if (!battle || !battle.participants) return;

      const p = battle.participants[currentUserId];
      const opponentId = Object.keys(battle.participants).find(id => id !== currentUserId);
      const o = battle.participants[opponentId];

      if (!p || !o) return;

      isMyTurn = battle.activePlayerId === currentUserId;
      playerEnergy = p.energy;

      // Atualiza Indicador Central de Turno
      document.getElementById('turnCounterText').textContent = `#${battle.turnNumber}`;
      const turnBadge = document.getElementById('turnIndicatorBadge');
      if (turnBadge) {
        if (isMyTurn) {
          turnBadge.textContent = 'SEU TURNO';
          turnBadge.className = 'turn-status-pill my-turn';
        } else {
          turnBadge.textContent = 'TURNO DO OPONENTE';
          turnBadge.className = 'turn-status-pill opp-turn';
        }
      }

      // Atualiza Oponente
      document.getElementById('opponentHpText').textContent = `${o.hp} / ${o.maxHp}`;
      document.getElementById('opponentHpBar').style.width = `${Math.max(0, (o.hp / o.maxHp) * 100)}%`;
      document.getElementById('opponentBreakText').textContent = `${o.breakGauge}%`;
      document.getElementById('opponentBreakBar').style.width = `${Math.max(0, o.breakGauge)}%`;

      const oppZone = document.getElementById('opponentZone');
      if (oppZone) {
        if (!isMyTurn) oppZone.classList.add('active-turn');
        else oppZone.classList.remove('active-turn');

        if (o.isBroken) oppZone.classList.add('broken');
        else oppZone.classList.remove('broken');
      }

      // Atualiza Jogador
      document.getElementById('playerHpText').textContent = `${p.hp} / ${p.maxHp}`;
      document.getElementById('playerHpBar').style.width = `${Math.max(0, (p.hp / p.maxHp) * 100)}%`;
      document.getElementById('playerBreakText').textContent = `${p.breakGauge}%`;
      document.getElementById('playerBreakBar').style.width = `${Math.max(0, p.breakGauge)}%`;
      document.getElementById('playerEnergyDisplay').textContent = `⚡ ${p.energy}/10 ENERGIA`;
      document.getElementById('playerEnergyBarText').textContent = `${p.energy} / 10`;
      document.getElementById('playerEnergyBar').style.width = `${Math.min(100, (p.energy / 10) * 100)}%`;

      const plyZone = document.getElementById('playerZone');
      if (plyZone) {
        if (isMyTurn) plyZone.classList.add('active-turn');
        else plyZone.classList.remove('active-turn');

        if (p.isBroken) plyZone.classList.add('broken');
        else plyZone.classList.remove('broken');
      }

      // Atualiza Terminal de Logs
      if (battle.logs && Array.isArray(battle.logs)) {
        const term = document.getElementById('combatLogTerminal');
        term.innerHTML = '';
        battle.logs.forEach(l => {
          const div = document.createElement('div');
          div.className = 'log-entry-line';
          div.textContent = `> ${l}`;
          term.appendChild(div);
        });
        scrollTerminalToBottom();
      }

      // Atualiza Mão de Cartas
      renderPlayerHand(p.hand);

      // Atualiza Botões Defensivos
      document.getElementById('blockBtn').disabled = (!isMyTurn || p.energy < 1 || p.isBroken);
      document.getElementById('dodgeBtn').disabled = (!isMyTurn || p.energy < 1 || p.isBroken);
      document.getElementById('counterBtn').disabled = (!isMyTurn || p.energy < 2 || p.isBroken);
      document.getElementById('passTurnBtn').disabled = (!isMyTurn);

      isProcessingAction = false;
    }

    function renderPlayerHand(hand) {
      const container = document.getElementById('playerHandContainer');
      if (!container || !Array.isArray(hand)) return;

      container.innerHTML = '';
      hand.forEach(card => {
        const canPlay = isMyTurn && playerEnergy >= card.energy_cost;
        const artPath = getCardArtByType(card.type);

        const cardEl = document.createElement('div');
        cardEl.className = `gothic-battle-card ${!canPlay ? 'unplayable' : ''}`;
        cardEl.id = `handCard_${card.id}`;
        cardEl.innerHTML = `
          <img src="${artPath}" alt="${card.name}" class="battle-card-bg-art" onerror="this.onerror=null; this.src='/images/card-back.png';">
          <div class="battle-card-overlay-data">
            <div class="d-flex justify-content-between align-items-center font-monospace" style="font-size: 0.65rem;">
              <span class="text-warning fw-bold">⚡ ${card.energy_cost}</span>
              <img src="/images/icons/${(card.element || 'fire').toLowerCase()}.png" alt="${card.element}" style="width: 14px; height: 14px; object-fit: contain;" onerror="this.style.display='none'">
            </div>
            <div class="text-center">
              <span class="fw-bold text-main d-block font-monospace text-truncate" style="font-size: 0.7rem;">${card.name}</span>
              <span class="text-dim font-monospace" style="font-size: 0.6rem;">${card.type}</span>
            </div>
            <div class="d-flex justify-content-between font-monospace text-dim" style="font-size: 0.62rem;">
              <span class="text-danger fw-bold">⚔ ${card.damage || 0}</span>
              <span class="text-warning fw-bold">💥 ${card.break_damage || 0}</span>
            </div>
          </div>
        `;

        if (canPlay) {
          cardEl.onclick = () => playCardAction(card.id, card.type, card.energy_cost);
        }

        container.appendChild(cardEl);
      });
    }

    // 4. Executa Ação de Jogar Carta
    async function playCardAction(cardId, actionType, energyCost) {
      if (!isMyTurn || isProcessingAction) return;

      if (playerEnergy < energyCost) {
        Swal.fire({
          title: 'Energia Insuficiente',
          text: `Esta manobra exige ${energyCost} ponto(s) de energia.`,
          icon: 'warning',
          confirmButtonColor: '#b38b4d',
          background: '#140707',
          color: '#eae0d5'
        });
        return;
      }

      isProcessingAction = true;
      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playAttack();
      }

      if (socket && socket.connected) {
        socket.emit('battle:action', { battleId, actionType, cardId });
      } else {
        try {
          const res = await fetch('/battle/action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ battleId, actionType, cardId })
          });
          const data = await res.json();
          if (data.success) {
            if (data.finished) handleBattleFinished(data);
            else applyStateUpdate(data.battle);
          } else {
            Swal.fire({ title: 'Atenção', text: data.error, icon: 'error', confirmButtonColor: '#781c2f', background: '#140707', color: '#eae0d5' });
            isProcessingAction = false;
          }
        } catch (e) {
          console.error(e);
          isProcessingAction = false;
        }
      }
    }

    // 5. Executa Postura Defensiva
    async function executeTacticalAction(actionType) {
      if (!isMyTurn || isProcessingAction) return;

      isProcessingAction = true;
      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playCardSelect();
      }

      if (socket && socket.connected) {
        socket.emit('battle:action', { battleId, actionType, cardId: null });
      } else {
        try {
          const res = await fetch('/battle/action', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ battleId, actionType, cardId: null })
          });
          const data = await res.json();
          if (data.success) {
            applyStateUpdate(data.battle);
          } else {
            Swal.fire({ title: 'Atenção', text: data.error, icon: 'error', confirmButtonColor: '#781c2f', background: '#140707', color: '#eae0d5' });
            isProcessingAction = false;
          }
        } catch (e) {
          console.error(e);
          isProcessingAction = false;
        }
      }
    }

    // 6. Passar Turno
    async function passTurn() {
      if (!isMyTurn || isProcessingAction) return;

      isProcessingAction = true;
      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playUiClick();
      }

      if (socket && socket.connected) {
        socket.emit('battle:pass', { battleId });
      } else {
        try {
          const res = await fetch('/battle/pass', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ battleId })
          });
          const data = await res.json();
          if (data.success) {
            if (data.finished) handleBattleFinished(data);
            else applyStateUpdate(data.battle);
          } else {
            Swal.fire({ title: 'Atenção', text: data.error, icon: 'error', confirmButtonColor: '#781c2f', background: '#140707', color: '#eae0d5' });
            isProcessingAction = false;
          }
        } catch (e) {
          console.error(e);
          isProcessingAction = false;
        }
      }
    }

    // 7. Rendição Voluntária
    function concedeBattle() {
      Swal.fire({
        title: 'Declarar Rendição?',
        text: 'Esta manobra concederá vitória imediata ao oponente.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Sim, Retirar-me',
        cancelButtonText: 'Continuar no Combate',
        confirmButtonColor: '#781c2f',
        cancelButtonColor: '#b38b4d',
        background: '#140707',
        color: '#eae0d5'
      }).then(async (result) => {
        if (result.isConfirmed) {
          if (socket && socket.connected) {
            socket.emit('battle:concede', { battleId });
          } else {
            try {
              const res = await fetch('/battle/concede', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ battleId })
              });
              const data = await res.json();
              if (data.success) handleBattleFinished(data);
            } catch (e) {
              console.error(e);
            }
          }
        }
      });
    }

    // 8. Término do Combate
    function handleBattleFinished(data) {
      if (window.Joker && window.Joker.Audio) {
        if (data.winnerId === currentUserId) window.Joker.Audio.playVictory();
        else window.Joker.Audio.playDefeat();
      }

      setTimeout(() => {
        window.location.href = `/battle/result/${battleId}`;
      }, 900);
    }
  </script>

  <!-- Rodapé Oficial -->
  <%- include('../partials/footer') %>
</body>
</html>