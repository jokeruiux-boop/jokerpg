  </main>

  <!-- ========================================================================
       MODAL DE CRIAÇÃO DE CARTA TÁTICA COM UPLOAD BYTEA
       ======================================================================== -->
  <div class="modal fade" id="createCardModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content" style="background: #140707; border: 2px solid #b38b4d; color: #eae0d5;">
        <form action="/admin/cards" method="POST" enctype="multipart/form-data">
          <div class="modal-header border-secondary border-opacity-25">
            <h5 class="modal-title font-monospace fw-bold" style="font-family: 'Cinzel', serif;">Forjar Nova Carta Tática</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
          </div>
          <div class="modal-body p-4">
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <label class="form-label small font-monospace text-uppercase" style="color: var(--gothic-text-gold);">Nome da Carta</label>
                <input type="text" class="gothic-input" name="name" required minlength="2" maxlength="100">
              </div>

              <div class="col-12 col-md-6">
                <label class="form-label small font-monospace text-uppercase" style="color: var(--gothic-text-gold);">Tipo da Manobra</label>
                <select name="type" class="gothic-select" required>
                  <% Object.values(constants.CARD_TYPES).forEach(function(t) { %>
                    <option value="<%= t %>"><%= t %></option>
                  <% }); %>
                </select>
              </div>

              <div class="col-12 col-md-6">
                <label class="form-label small font-monospace text-uppercase" style="color: var(--gothic-text-gold);">Elemento Primordial</label>
                <select name="element" class="gothic-select" required>
                  <% Object.values(constants.ELEMENTS).forEach(function(elem) { %>
                    <option value="<%= elem %>"><%= elem %></option>
                  <% }); %>
                </select>
              </div>

              <div class="col-12 col-md-6">
                <label class="form-label small font-monospace text-uppercase" style="color: var(--gothic-text-gold);">Raridade</label>
                <select name="rarity" class="gothic-select" required>
                  <% Object.values(constants.RARITIES).forEach(function(rar) { %>
                    <option value="<%= rar %>"><%= rar %></option>
                  <% }); %>
                </select>
              </div>

              <div class="col-12">
                <label class="form-label small font-monospace text-uppercase" style="color: var(--gothic-text-gold);">Descrição dos Efeitos</label>
                <textarea class="gothic-textarea" name="description" rows="2" required minlength="5"></textarea>
              </div>

              <div class="col-6 col-md-3">
                <label class="form-label small font-monospace text-uppercase" style="color: var(--gothic-text-gold);">Custo de Energia</label>
                <input type="number" class="gothic-input" name="energy_cost" value="1" min="0" max="10" required>
              </div>

              <div class="col-6 col-md-3">
                <label class="form-label small font-monospace text-uppercase" style="color: var(--gothic-text-gold);">Dano Base</label>
                <input type="number" class="gothic-input" name="damage" value="100" min="0" max="3000" required>
              </div>

              <div class="col-6 col-md-3">
                <label class="form-label small font-monospace text-uppercase" style="color: var(--gothic-text-gold);">Defesa</label>
                <input type="number" class="gothic-input" name="defense" value="0" min="0" max="3000" required>
              </div>

              <div class="col-6 col-md-3">
                <label class="form-label small font-monospace text-uppercase" style="color: var(--gothic-text-gold);">Quebra Postura</label>
                <input type="number" class="gothic-input" name="break_damage" value="15" min="0" max="500" required>
              </div>

              <div class="col-6 col-md-4">
                <label class="form-label small font-monospace text-uppercase" style="color: var(--gothic-text-gold);">Código do Efeito</label>
                <input type="text" class="gothic-input" name="effect_code" value="NONE" placeholder="ex: APPLY_BURN">
              </div>

              <div class="col-6 col-md-4">
                <label class="form-label small font-monospace text-uppercase" style="color: var(--gothic-text-gold);">Recarga (Cooldown)</label>
                <input type="number" class="gothic-input" name="cooldown" value="0" min="0" max="10" required>
              </div>

              <div class="col-12 col-md-4">
                <label class="form-label small font-monospace text-uppercase" style="color: var(--gothic-text-gold);">Modificador de Combo</label>
                <input type="text" class="gothic-input" name="combo_modifier" value="STANDARD">
              </div>

              <div class="col-12">
                <label class="form-label small font-monospace text-uppercase" style="color: var(--gothic-text-gold);">Ilustração da Carta (BYTEA - Opcional)</label>
                <input type="file" class="gothic-input" name="image" accept="image/png, image/jpeg, image/webp">
              </div>
            </div>
          </div>
          <div class="modal-footer border-secondary border-opacity-25">
            <button type="button" class="gothic-btn secondary py-1 px-3" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="gothic-btn py-1 px-4">Salvar Carta</button>
          </div>
        </form>
      </div>
    </div>
  </div>

