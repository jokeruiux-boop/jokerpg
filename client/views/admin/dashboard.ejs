<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <%- include('../partials/head') %>

  <!-- Google Fonts: Plus Jakarta Sans, Outfit & Cinzel (Tipografia Gótica / Dark Fantasy) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Google Material Symbols Oficial (Sem Emojis) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Biblioteca SweetAlert2 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    /* ==========================================================================
       JOKER RPG — PAINEL ADMINISTRATIVO SUPREMO DARK FANTASY (DIABLO / MMO HUD)
       Molduras de Ferro Forjado, Estandartes de Comando e Métricas em Pedra
       ========================================================================== */

    :root[data-theme="dark"] {
      --gothic-bg: #090404;
      --gothic-bg-overlay: radial-gradient(circle at 50% 30%, rgba(50, 15, 15, 0.6) 0%, rgba(10, 3, 3, 0.92) 65%, #050101 100%);
      --gothic-frame-bg: #140707;
      --gothic-panel: #0d0404;
      --gothic-panel-card: linear-gradient(180deg, #180808 0%, #0d0303 100%);
      --gothic-border-outer: #381010;
      --gothic-border-gold: #b38b4d;
      --gothic-border-gold-glow: rgba(179, 139, 77, 0.45);
      --gothic-filigree: #8a6530;
      --gothic-text: #eae0d5;
      --gothic-text-gold: #d4af37;
      --gothic-text-muted: #8e7a6d;
      --gothic-red-glow: rgba(220, 38, 38, 0.7);
      --gothic-slot-bg: #190505;
      --gothic-slot-border: #4a1515;
      --gothic-hotbar-bg: #100505;
    }

    :root[data-theme="light"] {
      --gothic-bg: #ece6dc;
      --gothic-bg-overlay: radial-gradient(circle at 50% 30%, rgba(240, 230, 218, 0.75) 0%, rgba(215, 200, 185, 0.9) 65%, #c8bcae 100%);
      --gothic-frame-bg: #dcd3c3;
      --gothic-panel: #f4eee2;
      --gothic-panel-card: linear-gradient(180deg, #ffffff 0%, #f1e9dc 100%);
      --gothic-border-outer: #8a6e55;
      --gothic-border-gold: #966f2d;
      --gothic-border-gold-glow: rgba(150, 111, 45, 0.3);
      --gothic-filigree: #78531e;
      --gothic-text: #261c14;
      --gothic-text-gold: #825a17;
      --gothic-text-muted: #6e5a4c;
      --gothic-red-glow: rgba(185, 28, 28, 0.4);
      --gothic-slot-bg: #e2d7c5;
      --gothic-slot-border: #9c846e;
      --gothic-hotbar-bg: #cfc2ad;
    }

    body {
      background: var(--gothic-bg) !important;
      color: var(--gothic-text);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      margin: 0;
      padding: 0;
      transition: background-color 0.25s ease, color 0.25s ease;
      user-select: none;
      position: relative;
    }

    .material-symbols-outlined {
      font-family: 'Material Symbols Outlined';
      font-weight: 500;
      font-size: 20px;
      line-height: 1;
      display: inline-block;
      vertical-align: middle;
    }

    /* Cenário de Fundo da Arena */
    .gothic-viewport-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-image: var(--gothic-bg-overlay), url('/images/backgrounds/arena-bg.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: 1;
      pointer-events: none;
    }

    .gothic-admin-wrapper {
      position: relative;
      z-index: 10;
      max-width: 1440px;
      margin: 20px auto 50px auto;
      padding: 0 16px;
    }

    /* Moldura Principal de Ferro e Pedra */
    .gothic-main-frame {
      background: var(--gothic-frame-bg);
      border: 4px solid var(--gothic-border-outer);
      border-radius: 4px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.95), inset 0 0 30px rgba(0, 0, 0, 0.85);
      position: relative;
      padding: 8px;
    }

    /* Cantoneiras Metálicas Ornamentais */
    .gothic-corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border: 2.5px solid var(--gothic-border-gold);
      z-index: 10;
      pointer-events: none;
    }
    .gothic-corner.top-left { top: 2px; left: 2px; border-right: none; border-bottom: none; }
    .gothic-corner.top-right { top: 2px; right: 2px; border-left: none; border-bottom: none; }
    .gothic-corner.bottom-left { bottom: 2px; left: 2px; border-right: none; border-top: none; }
    .gothic-corner.bottom-right { bottom: 2px; right: 2px; border-left: none; border-top: none; }

    /* Barra Superior de Abas do Admin */
    .gothic-nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #2d0b0b;
      background: #090202;
      padding: 6px 16px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .gothic-tabs-group {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .gothic-tab-link {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.86rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #634f47;
      text-decoration: none;
      padding: 6px 10px;
      position: relative;
      transition: all 0.2s ease;
    }

    .gothic-tab-link:hover {
      color: #b58d60;
    }

    .gothic-tab-link.active {
      color: #ffffff;
      text-shadow: 0 0 10px var(--gothic-red-glow), 0 0 20px rgba(255, 30, 0, 0.8);
    }

    .gothic-tab-link.active::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent 0%, #ff3b30 50%, transparent 100%);
      box-shadow: 0 0 8px #ff3b30;
    }

    .gothic-theme-toggle-btn {
      background: transparent;
      border: 1px solid var(--gothic-filigree);
      color: var(--gothic-text-gold);
      padding: 4px 10px;
      border-radius: 2px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Cinzel', serif;
      font-size: 0.74rem;
      transition: all 0.15s ease;
    }

    /* Cabeçalho de Comando */
    .gothic-admin-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 2px solid #2d0b0b;
      position: relative;
      flex-wrap: wrap;
      gap: 16px;
    }

    .gothic-header-title-box {
      text-align: left;
    }

    .gothic-header-main-title {
      font-family: 'Cinzel', serif;
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--gothic-text);
      line-height: 1.1;
      margin: 0;
    }

    .gothic-header-sub {
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      letter-spacing: 2px;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
      margin-top: 4px;
    }

    .gothic-emblem-medallion {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: radial-gradient(circle, #2e0909 0%, #0d0202 100%);
      border: 2px solid #5a1818;
      box-shadow: inset 0 0 10px #000, 0 0 15px rgba(220, 38, 38, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .admin-status-indicator {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #190505;
      border: 1.5px solid var(--gothic-border-gold);
      border-radius: 20px;
      padding: 5px 14px;
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      font-weight: 800;
      color: #ffaa00;
      box-shadow: inset 0 0 8px #000;
    }

    .admin-beacon-pulse {
      width: 8px;
      height: 8px;
      background-color: #ffaa00;
      border-radius: 50%;
      box-shadow: 0 0 8px rgba(255, 170, 0, 0.9);
      animation: beaconFlash 2s infinite ease-in-out;
    }

    @keyframes beaconFlash {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.35; transform: scale(0.85); }
    }

    /* Grid dos 5 Blocos de Métricas em Pedra */
    .gothic-metrics-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
      padding: 14px;
    }

    .gothic-metric-tile {
      background: var(--gothic-panel);
      border: 2px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.85);
      border-radius: 2px;
      padding: 16px 14px;
      text-align: center;
      transition: transform 0.15s ease, border-color 0.15s ease;
    }

    .gothic-metric-tile:hover {
      transform: translateY(-2px);
      border-color: #ffaa00;
    }

    .metric-number-gold {
      font-family: 'Cinzel', serif;
      font-size: 1.6rem;
      font-weight: 900;
      color: #ffcc00;
      text-shadow: 0 0 8px rgba(255, 204, 0, 0.5);
      line-height: 1;
      margin-bottom: 4px;
    }

    .metric-label-gothic {
      font-family: 'Cinzel', serif;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 1px;
      color: var(--gothic-text-muted);
      text-transform: uppercase;
    }

    /* Atalhos Operacionais */
    .gothic-shortcuts-panel {
      background: var(--gothic-panel);
      border: 2px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.85);
      padding: 16px 20px;
      margin: 0 14px 14px 14px;
    }

    .gothic-shortcuts-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }

    .gothic-action-card-btn {
      background: var(--gothic-slot-bg);
      border: 1px solid var(--gothic-slot-border);
      border-radius: 2px;
      padding: 12px;
      text-decoration: none;
      color: var(--gothic-text);
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: all 0.15s ease;
    }

    .gothic-action-card-btn:hover {
      border-color: var(--gothic-border-gold);
      color: #ffcc00;
      background: #250808;
      transform: translateY(-2px);
    }

    /* Painéis Duplos: Batalhas Recentes & Logs de Auditoria */
    .gothic-supervision-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      padding: 0 14px 14px 14px;
    }

    .gothic-supervision-panel {
      background: var(--gothic-panel);
      border: 2px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.85);
      padding: 16px 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .supervision-panel-title {
      font-family: 'Cinzel', serif;
      font-weight: 800;
      font-size: 0.95rem;
      letter-spacing: 1.5px;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(179, 139, 77, 0.25);
      padding-bottom: 8px;
      margin-bottom: 12px;
    }

    .gothic-mini-row {
      background: var(--gothic-slot-bg);
      border: 1px solid var(--gothic-slot-border);
      border-radius: 2px;
      padding: 8px 12px;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: var(--font-mono);
      font-size: 0.78rem;
    }

    .gothic-btn {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.76rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 6px 14px;
      border-radius: 2px;
      border: 1px solid var(--gothic-border-gold);
      background: linear-gradient(180deg, #3d1414 0%, #170505 100%);
      color: #ffffff;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
      transition: all 0.15s ease;
    }

    .gothic-btn:hover {
      background: linear-gradient(180deg, #6c1c1c 0%, #2e0909 100%);
      border-color: #ffaa00;
      color: #ffdd44;
      transform: scale(1.02);
    }

    /* Barra Inferior com Orbe de Comando */
    .gothic-bottom-hotbar {
      background: var(--gothic-hotbar-bg);
      border-top: 2px solid #3d0c0c;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
    }

    .gothic-orb-assembly {
      position: absolute;
      left: 50%;
      top: -24px;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 25;
    }

    .gothic-orb-sphere {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #ffaa00 0%, #cc7700 50%, #442200 100%);
      box-shadow: 0 0 25px rgba(255, 170, 0, 0.85), inset 0 -6px 14px rgba(0, 0, 0, 0.8);
      position: relative;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease;
    }

    .gothic-orb-sphere:hover {
      transform: scale(1.08);
    }

    @media (max-width: 991px) {
      .gothic-metrics-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .gothic-shortcuts-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .gothic-supervision-grid {
        grid-template-columns: 1fr;
      }
      .gothic-orb-assembly {
        position: static;
        transform: none;
        margin: 10px auto;
      }
      .gothic-bottom-hotbar {
        flex-direction: column;
        gap: 16px;
      }
      .gothic-admin-header {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <!-- Fundo Atmosférico Real da Pasta /images/backgrounds/arena-bg.jpg -->
  <div class="gothic-viewport-bg"></div>

  <!-- Barra Superior de Navegação -->
  <%- include('../partials/navbar') %>

  <!-- ========================================================================
       JANELA GÓTICA CHAPADA DO ADMIN SUPREMO (COMMAND THRONE ROOM)
       ======================================================================== -->
  <main class="gothic-admin-wrapper">
    <!-- Alertas Globais -->
    <%- include('../partials/messages') %>

    <div class="gothic-main-frame">
      <!-- Cantoneiras Ornamentais de Ferro e Ouro -->
      <span class="gothic-corner top-left"></span>
      <span class="gothic-corner top-right"></span>
      <span class="gothic-corner bottom-left"></span>
      <span class="gothic-corner bottom-right"></span>

      <!-- 1. Abas Superiores do Admin -->
      <header class="gothic-nav-bar">
        <div class="gothic-tabs-group">
          <a href="/admin" class="gothic-tab-link active">CONSOLE (DASHBOARD)</a>
          <a href="/admin/users" class="gothic-tab-link">JOGADORES</a>
          <a href="/admin/characters" class="gothic-tab-link">HERÓIS</a>
          <a href="/admin/cards" class="gothic-tab-link">CARTAS</a>
          <a href="/admin/battles" class="gothic-tab-link">BATALHAS</a>
          <a href="/admin/missions" class="gothic-tab-link">MISSÕES</a>
          <a href="/admin/logs" class="gothic-tab-link">AUDITORIA</a>
        </div>

        <button type="button" class="gothic-theme-toggle-btn" onclick="toggleGothicTheme()" title="Alternar Modo Claro e Escuro">
          <span class="material-symbols-outlined" style="font-size: 16px;">contrast</span>
          <span id="themeText">DARK</span>
        </button>
      </header>

      <!-- 2. Cabeçalho de Comando Supremo -->
      <section class="gothic-admin-header">
        <div class="gothic-header-title-box">
          <h1 class="gothic-header-main-title">Conselho Supremo de Comando</h1>
          <div class="gothic-header-sub">Supervisão Autoritativa &bull; Moderação e Gestão Global</div>
        </div>

        <div class="gothic-emblem-medallion">
          <span class="material-symbols-outlined" style="font-size: 28px; color: #ff3333; filter: drop-shadow(0 0 6px rgba(255,51,51,0.8));">shield_person</span>
        </div>

        <div class="admin-status-indicator">
          <span class="admin-beacon-pulse"></span>
          <span>AUTORIDADE TOTAL ATIVA</span>
        </div>
      </section>

      <!-- 3. Grid dos 5 Blocos de Métricas em Pedra -->
      <section class="gothic-metrics-grid">
        <!-- Jogadores Registrados -->
        <div class="gothic-metric-tile">
          <div class="metric-number-gold"><%= metrics.totalUsers %></div>
          <div class="metric-label-gothic">JOGADORES</div>
          <span class="text-dim font-monospace" style="font-size: 0.65rem;">Contas Ativas</span>
        </div>

        <!-- Heróis no Catálogo -->
        <div class="gothic-metric-tile">
          <div class="metric-number-gold" style="color: #00d2ff;"><%= metrics.totalCharacters %></div>
          <div class="metric-label-gothic">COMBATENTES</div>
          <span class="text-dim font-monospace" style="font-size: 0.65rem;">Catálogo Mestre</span>
        </div>

        <!-- Cartas Táticas -->
        <div class="gothic-metric-tile">
          <div class="metric-number-gold" style="color: #a855f7;"><%= metrics.totalCards %></div>
          <div class="metric-label-gothic">CARTAS</div>
          <span class="text-dim font-monospace" style="font-size: 0.65rem;">Arsenal Registrado</span>
        </div>

        <!-- Batalhas Disputadas -->
        <div class="gothic-metric-tile">
          <div class="metric-number-gold" style="color: #ff4444;"><%= metrics.totalBattles %></div>
          <div class="metric-label-gothic">CONFRONTOS</div>
          <span class="text-dim font-monospace" style="font-size: 0.65rem;">Duelos Concluídos</span>
        </div>

        <!-- Missões Oficiais -->
        <div class="gothic-metric-tile">
          <div class="metric-number-gold" style="color: #10b981;"><%= metrics.totalMissions %></div>
          <div class="metric-label-gothic">MISSÕES</div>
          <span class="text-dim font-monospace" style="font-size: 0.65rem;">Metas Ativas</span>
        </div>
      </section>

      <!-- 4. Atalhos Operacionais em Pedra -->
      <section class="gothic-shortcuts-panel">
        <div class="gothic-shortcuts-grid">
          <a href="/admin/characters" class="gothic-action-card-btn">
            <span class="material-symbols-outlined text-warning">person_add</span>
            <span>Cadastrar Heróis</span>
          </a>
          <a href="/admin/cards" class="gothic-action-card-btn">
            <span class="material-symbols-outlined text-info">style</span>
            <span>Cadastrar Cartas</span>
          </a>
          <a href="/admin/users" class="gothic-action-card-btn">
            <span class="material-symbols-outlined text-danger">shield_lock</span>
            <span>Moderar Contas</span>
          </a>
          <a href="/admin/missions" class="gothic-action-card-btn">
            <span class="material-symbols-outlined text-success">task_alt</span>
            <span>Forjar Missões</span>
          </a>
        </div>
      </section>

      <!-- 5. Painéis de Supervisão: Duelos Recentes & Logs de Auditoria -->
      <section class="gothic-supervision-grid">
        <!-- Batalhas Recentes -->
        <div class="gothic-supervision-panel">
          <div>
            <div class="supervision-panel-title">
              <span>Duelos Recentes em Andamento</span>
              <a href="/admin/battles" class="small text-decoration-none" style="color: var(--gothic-text-gold); font-size: 0.72rem;">Ver Todas</a>
            </div>

            <% if (recentBattles && recentBattles.length > 0) { %>
              <div class="d-flex flex-column">
                <% recentBattles.forEach(function(b) { %>
                  <div class="gothic-mini-row">
                    <div>
                      <strong class="text-success"><%= b.winner_username || 'Autômato IA' %></strong>
                      <span class="text-dim">derrotou</span>
                      <strong class="text-danger"><%= b.loser_username || 'Autômato IA' %></strong>
                    </div>
                    <div class="text-dim font-monospace" style="font-size: 0.7rem;">
                      <%= b.mode %> &bull; <%= b.total_turns %> Turnos
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <p class="text-muted font-monospace small mb-0 py-3 text-center">Nenhum combate registrado recentemente.</p>
            <% } %>
          </div>

          <div class="pt-2 text-end">
            <a href="/admin/battles" class="gothic-btn">Supervisão Completa</a>
          </div>
        </div>

        <!-- Trilha de Auditoria Recente -->
        <div class="gothic-supervision-panel">
          <div>
            <div class="supervision-panel-title">
              <span>Trilha de Auditoria Administrativa</span>
              <a href="/admin/logs" class="small text-decoration-none" style="color: var(--gothic-text-gold); font-size: 0.72rem;">Ver Trilha</a>
            </div>

            <% if (recentLogs && recentLogs.length > 0) { %>
              <div class="d-flex flex-column">
                <% recentLogs.forEach(function(l) { %>
                  <div class="gothic-mini-row">
                    <div>
                      <span class="badge" style="background: #250808; border: 1px solid var(--gothic-border-gold); color: var(--gothic-text-gold); font-size: 0.65rem;">
                        <%= l.action_name %>
                      </span>
                      <span class="text-main ms-1"><%= l.target_entity %></span>
                    </div>
                    <div class="text-dim font-monospace" style="font-size: 0.7rem;">
                      <%= l.admin_username || 'ADMIN' %> &bull; <%= new Date(l.created_at).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <p class="text-muted font-monospace small mb-0 py-3 text-center">Nenhum evento registrado na auditoria.</p>
            <% } %>
          </div>

          <div class="pt-2 text-end">
            <a href="/admin/logs" class="gothic-btn">Ver Histórico de Logs</a>
          </div>
        </div>
      </section>

      <!-- 6. Barra Inferior com Orbe de Comando -->
      <footer class="gothic-bottom-hotbar">
        <div class="d-flex align-items-center gap-2">
          <a href="/dashboard" class="gothic-tab-link" title="Retornar ao Jogo">
            <span class="material-symbols-outlined" style="font-size: 22px;">sports_esports</span>
          </a>
          <a href="/admin/users" class="gothic-tab-link" title="Jogadores">
            <span class="material-symbols-outlined" style="font-size: 22px;">group</span>
          </a>
        </div>

        <!-- ORBE CENTRAL DE COMANDO -->
        <div class="gothic-orb-assembly">
          <div class="gothic-orb-sphere" title="Conselho Supremo">
            <span class="material-symbols-outlined text-white" style="font-size: 32px; filter: drop-shadow(0 0 8px #ffffff);">shield_person</span>
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/admin/battles" class="gothic-tab-link" title="Batalhas">
            <span class="material-symbols-outlined" style="font-size: 22px;">swords</span>
          </a>
          <a href="/admin/logs" class="gothic-tab-link" title="Logs">
            <span class="material-symbols-outlined" style="font-size: 22px;">receipt_long</span>
          </a>
        </div>
      </footer>
    </div>
  </main>

  <!-- Lógica JavaScript do Tema -->
  <script>
    function applyGothicTheme() {
      const theme = localStorage.getItem('joker_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = theme === 'dark' ? 'DARK' : 'LIGHT';
    }

    function toggleGothicTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('joker_theme', next);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = next === 'dark' ? 'DARK' : 'LIGHT';

      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playUiClick();
      }
    }

    applyGothicTheme();
  </script>

  <!-- Rodapé Oficial -->
  <%- include('../partials/footer') %>
</body>
</html>