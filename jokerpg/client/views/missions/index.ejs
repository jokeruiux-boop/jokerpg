<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <%- include('../partials/head') %>

  <!-- Google Fonts: Plus Jakarta Sans, Outfit & Cinzel (Tipografia Gótica / Dark Fantasy) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Google Material Symbols Oficial (Sem Emojis) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Biblioteca SweetAlert2 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    /* ==========================================================================
       JOKER RPG — QUADRO DE MISSÕES DARK FANTASY (DESIGN CHAPADO DIABLO / MMO)
       Molduras em Ferro Forjado, Tábuas de Recompensas e Cantoneiras de Ouro
       ========================================================================== */

    :root[data-theme="dark"] {
      --gothic-bg: #090404;
      --gothic-frame-bg: #140707;
      --gothic-panel: #0d0404;
      --gothic-panel-card: linear-gradient(180deg, #180808 0%, #0d0303 100%);
      --gothic-border-outer: #381010;
      --gothic-border-gold: #b38b4d;
      --gothic-border-gold-glow: rgba(179, 139, 77, 0.45);
      --gothic-filigree: #8a6530;
      --gothic-text: #eae0d5;
      --gothic-text-gold: #d4af37;
      --gothic-text-muted: #8e7a6d;
      --gothic-red-glow: rgba(220, 38, 38, 0.7);
      --gothic-slot-bg: #190505;
      --gothic-slot-border: #4a1515;
      --gothic-hotbar-bg: #100505;
    }

    :root[data-theme="light"] {
      --gothic-bg: #ece6dc;
      --gothic-frame-bg: #dcd3c3;
      --gothic-panel: #f4eee2;
      --gothic-panel-card: linear-gradient(180deg, #ffffff 0%, #f1e9dc 100%);
      --gothic-border-outer: #8a6e55;
      --gothic-border-gold: #966f2d;
      --gothic-border-gold-glow: rgba(150, 111, 45, 0.3);
      --gothic-filigree: #78531e;
      --gothic-text: #261c14;
      --gothic-text-gold: #825a17;
      --gothic-text-muted: #6e5a4c;
      --gothic-red-glow: rgba(185, 28, 28, 0.4);
      --gothic-slot-bg: #e2d7c5;
      --gothic-slot-border: #9c846e;
      --gothic-hotbar-bg: #cfc2ad;
    }

    body {
      background: var(--gothic-bg) !important;
      color: var(--gothic-text);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      margin: 0;
      padding: 0;
      transition: background-color 0.25s ease, color 0.25s ease;
      user-select: none;
    }

    .material-symbols-outlined {
      font-family: 'Material Symbols Outlined';
      font-weight: 500;
      font-size: 20px;
      line-height: 1;
      display: inline-block;
      vertical-align: middle;
    }

    .gothic-missions-wrapper {
      max-width: 1400px;
      margin: 20px auto 50px auto;
      padding: 0 16px;
    }

    /* Moldura Principal de Pedra de Ferro */
    .gothic-main-frame {
      background: var(--gothic-frame-bg);
      border: 4px solid var(--gothic-border-outer);
      border-radius: 4px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.95), inset 0 0 30px rgba(0, 0, 0, 0.8);
      position: relative;
      padding: 8px;
    }

    /* Cantoneiras Metálicas Ornamentais */
    .gothic-corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border: 2.5px solid var(--gothic-border-gold);
      z-index: 10;
      pointer-events: none;
    }
    .gothic-corner.top-left { top: 2px; left: 2px; border-right: none; border-bottom: none; }
    .gothic-corner.top-right { top: 2px; right: 2px; border-left: none; border-bottom: none; }
    .gothic-corner.bottom-left { bottom: 2px; left: 2px; border-right: none; border-top: none; }
    .gothic-corner.bottom-right { bottom: 2px; right: 2px; border-left: none; border-top: none; }

    /* Barra Superior de Abas */
    .gothic-nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #2d0b0b;
      background: #090202;
      padding: 6px 16px;
    }

    .gothic-tabs-group {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .gothic-tab-link {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.92rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #634f47;
      text-decoration: none;
      padding: 6px 12px;
      position: relative;
      transition: all 0.2s ease;
    }

    .gothic-tab-link:hover {
      color: #b58d60;
    }

    .gothic-tab-link.active {
      color: #ffffff;
      text-shadow: 0 0 10px var(--gothic-red-glow), 0 0 20px rgba(255, 30, 0, 0.8);
    }

    .gothic-tab-link.active::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent 0%, #ff3b30 50%, transparent 100%);
      box-shadow: 0 0 8px #ff3b30;
    }

    .gothic-theme-toggle-btn {
      background: transparent;
      border: 1px solid var(--gothic-filigree);
      color: var(--gothic-text-gold);
      padding: 4px 10px;
      border-radius: 2px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Cinzel', serif;
      font-size: 0.74rem;
      transition: all 0.15s ease;
    }

    .gothic-theme-toggle-btn:hover {
      box-shadow: 0 0 8px var(--gothic-border-gold-glow);
    }

    /* Cabeçalho de Status / Livro de Desafios */
    .gothic-missions-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 2px solid #2d0b0b;
      position: relative;
      flex-wrap: wrap;
      gap: 16px;
    }

    .gothic-header-title-box {
      text-align: left;
    }

    .gothic-header-main-title {
      font-family: 'Cinzel', serif;
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--gothic-text);
      line-height: 1.1;
      margin: 0;
    }

    .gothic-header-sub {
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      letter-spacing: 2px;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
      margin-top: 4px;
    }

    .gothic-emblem-medallion {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: radial-gradient(circle, #2e0909 0%, #0d0202 100%);
      border: 2px solid #5a1818;
      box-shadow: inset 0 0 10px #000, 0 0 15px rgba(220, 38, 38, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .gothic-stats-summary {
      font-family: 'Cinzel', serif;
      text-align: right;
    }

    .gothic-stats-numbers {
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: 1px;
    }

    /* Seções das Categorias de Missões */
    .gothic-mission-category-block {
      background: var(--gothic-panel);
      border: 2px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.85);
      padding: 16px 20px;
      margin: 14px;
    }

    .gothic-category-title {
      font-family: 'Cinzel', serif;
      font-weight: 800;
      font-size: 1rem;
      letter-spacing: 2px;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid rgba(179, 139, 77, 0.25);
      padding-bottom: 8px;
      margin-bottom: 14px;
    }

    /* Tábua Individual de Missão */
    .gothic-mission-tile {
      background: var(--gothic-panel-card);
      border: 1px solid var(--gothic-slot-border);
      border-radius: 2px;
      padding: 14px 18px;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 14px;
      transition: all 0.15s ease;
      position: relative;
    }

    .gothic-mission-tile:hover {
      border-color: var(--gothic-border-gold);
      transform: translateY(-2px);
    }

    .gothic-mission-tile.claimable {
      border-color: #10b981;
      background: linear-gradient(90deg, rgba(16, 185, 129, 0.08) 0%, rgba(20, 5, 5, 0.9) 100%);
      box-shadow: 0 0 14px rgba(16, 185, 129, 0.2);
    }

    .gothic-mission-tile.claimed {
      opacity: 0.55;
    }

    .mission-meta-info {
      flex: 1;
      min-width: 260px;
    }

    .mission-title-text {
      font-family: 'Cinzel', serif;
      font-weight: 800;
      font-size: 0.95rem;
      letter-spacing: 1px;
      color: var(--gothic-text);
      margin: 0 0 4px 0;
    }

    .mission-desc-text {
      font-size: 0.8rem;
      color: var(--gothic-text-muted);
      margin: 0 0 8px 0;
      line-height: 1.4;
    }

    /* Barra de Progresso Gótica */
    .gothic-progress-track {
      width: 100%;
      max-width: 320px;
      height: 10px;
      background: #000;
      border: 1px solid var(--gothic-border-gold);
      border-radius: 2px;
      position: relative;
      overflow: hidden;
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.8);
    }

    .gothic-progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #990000 0%, #ff2a2a 70%, #ff7744 100%);
      transition: width 0.4s ease;
    }

    .gothic-progress-fill.done {
      background: linear-gradient(90deg, #065f46 0%, #10b981 100%);
      box-shadow: 0 0 10px rgba(16, 185, 129, 0.8);
    }

    /* Recompensas da Missão */
    .gothic-rewards-cluster {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'Cinzel', serif;
      font-size: 0.75rem;
      font-weight: 700;
    }

    .gothic-reward-pill {
      background: #190505;
      border: 1px solid var(--gothic-border-gold);
      color: #ffaa00;
      padding: 3px 10px;
      border-radius: 2px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .gothic-reward-pill.xp {
      border-color: #ef4444;
      color: #ff6666;
    }

    /* Botão de Resgate Estilo Selo / Medalhão */
    .gothic-btn-claim {
      font-family: 'Cinzel', serif;
      font-weight: 800;
      font-size: 0.78rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 7px 18px;
      border-radius: 2px;
      border: 1px solid #10b981;
      background: linear-gradient(180deg, #10593b 0%, #062b1c 100%);
      color: #ffffff;
      cursor: pointer;
      box-shadow: 0 0 12px rgba(16, 185, 129, 0.4);
      transition: all 0.15s ease;
    }

    .gothic-btn-claim:hover {
      background: linear-gradient(180deg, #167a51 0%, #0a472f 100%);
      transform: scale(1.04);
      box-shadow: 0 0 18px rgba(16, 185, 129, 0.7);
    }

    .gothic-btn-claimed {
      font-family: 'Cinzel', serif;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 1px;
      padding: 7px 14px;
      background: transparent;
      border: 1px solid rgba(179, 139, 77, 0.3);
      color: var(--gothic-text-muted);
      border-radius: 2px;
      cursor: default;
    }

    /* Barra Inferior com Orbe da Facção */
    .gothic-bottom-hotbar {
      background: var(--gothic-hotbar-bg);
      border-top: 2px solid #3d0c0c;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
    }

    .gothic-orb-assembly {
      position: absolute;
      left: 50%;
      top: -24px;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 25;
    }

    .gothic-orb-sphere {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #ff7700 0%, #cc1100 50%, #440000 100%);
      box-shadow: 0 0 25px rgba(255, 60, 0, 0.85), inset 0 -6px 14px rgba(0, 0, 0, 0.8);
      position: relative;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease;
    }

    .gothic-orb-sphere:hover {
      transform: scale(1.08);
    }

    @media (max-width: 768px) {
      .gothic-mission-tile {
        flex-direction: column;
        align-items: flex-start;
      }
      .gothic-missions-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .gothic-nav-bar {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
      }
      .gothic-orb-assembly {
        position: static;
        transform: none;
        margin: 10px auto;
      }
      .gothic-bottom-hotbar {
        flex-direction: column;
        gap: 16px;
      }
    }
  </style>
</head>
<body>
  <!-- Barra de Navegação Superior Integrada -->
  <%- include('../partials/navbar') %>

  <!-- ========================================================================
       JANELA GÓTICA CHAPADA DE MISSÕES (DIABLO / CLASSIC RPG SHELL)
       ======================================================================== -->
  <main class="gothic-missions-wrapper">
    <!-- Alertas Globais -->
    <%- include('../partials/messages') %>

    <div class="gothic-main-frame">
      <!-- Cantoneiras Ornamentais de Ferro e Ouro -->
      <span class="gothic-corner top-left"></span>
      <span class="gothic-corner top-right"></span>
      <span class="gothic-corner bottom-left"></span>
      <span class="gothic-corner bottom-right"></span>

      <!-- 1. Abas Superiores Idênticas à Referência -->
      <header class="gothic-nav-bar">
        <div class="gothic-tabs-group">
          <a href="/missions" class="gothic-tab-link active">QUESTS (MISSÕES)</a>
          <a href="/battle" class="gothic-tab-link">ARENA</a>
          <a href="/characters" class="gothic-tab-link">HEROES</a>
          <a href="/decks" class="gothic-tab-link">DECKS</a>
          <a href="/dashboard" class="gothic-tab-link">COMMAND (QG)</a>
        </div>

        <button type="button" class="gothic-theme-toggle-btn" onclick="toggleGothicTheme()" title="Alternar Modo Claro e Escuro">
          <span class="material-symbols-outlined" style="font-size: 16px;">contrast</span>
          <span id="themeText">DARK</span>
        </button>
      </header>

      <!-- 2. Cabeçalho de Status: Título, Medalhão Central e Estatísticas de Resgates -->
      <section class="gothic-missions-header">
        <div class="gothic-header-title-box">
          <h1 class="gothic-header-main-title">Livro de Diretrizes e Desafios</h1>
          <div class="gothic-header-sub">Metas de Batalha &bull; Recompensas Atômicas de Experiência e Ouro</div>
        </div>

        <div class="gothic-emblem-medallion">
          <span class="material-symbols-outlined" style="font-size: 28px; color: #ff3333; filter: drop-shadow(0 0 6px rgba(255,51,51,0.8));">task_alt</span>
        </div>

        <div class="gothic-stats-summary">
          <div class="gothic-stats-numbers text-success">
            <%= totalClaimable %> RESGATE(S)
          </div>
          <div class="small font-monospace" style="color: var(--gothic-text-gold); font-size: 0.68rem;">RECOMPENSAS PENDENTES</div>
        </div>
      </section>

      <!-- 3. Seções de Missões em Tábuas Góticas -->

      <!-- CATEGORIA 1: MISSÕES DIÁRIAS -->
      <section class="gothic-mission-category-block">
        <div class="gothic-category-title">
          <span class="material-symbols-outlined text-warning">event_repeat</span>
          <span>Missões Diárias &bull; Renovação de Ciclo</span>
        </div>

        <% if (dailyMissions && dailyMissions.length > 0) { %>
          <% dailyMissions.forEach(function(m) { %>
            <% const isClaimable = m.is_completed && !m.claimed_at; %>
            <% const isClaimed = Boolean(m.claimed_at); %>

            <article class="gothic-mission-tile <%= isClaimable ? 'claimable' : (isClaimed ? 'claimed' : '') %>">
              <div class="mission-meta-info">
                <h3 class="mission-title-text"><%= m.title %></h3>
                <p class="mission-desc-text"><%= m.description %></p>

                <div class="d-flex align-items-center gap-3">
                  <div class="gothic-progress-track">
                    <div class="gothic-progress-fill <%= isClaimable ? 'done' : '' %>" style="width: <%= m.progressPercent %>%;"></div>
                  </div>
                  <span class="font-monospace small" style="color: var(--gothic-text-gold);"><%= m.current_progress %>/<%= m.requirement_count %></span>
                </div>
              </div>

              <div class="d-flex align-items-center gap-3">
                <div class="gothic-rewards-cluster">
                  <span class="gothic-reward-pill xp">+<%= m.reward_xp %> XP</span>
                  <span class="gothic-reward-pill">
                    <span class="material-symbols-outlined" style="font-size: 14px;">monetization_on</span>
                    +<%= m.reward_coins %>
                  </span>
                </div>

                <% if (isClaimable) { %>
                  <form action="/missions/<%= m.mission_id %>/claim" method="POST" class="m-0" onsubmit="triggerClaimAudio()">
                    <button type="submit" class="gothic-btn-claim">
                      <span class="material-symbols-outlined" style="font-size: 15px;">redeem</span> Resgatar
                    </button>
                  </form>
                <% } else if (isClaimed) { %>
                  <div class="gothic-btn-claimed">
                    <span class="material-symbols-outlined" style="font-size: 15px;">done_all</span> Resgatada
                  </div>
                <% } else { %>
                  <div class="gothic-btn-claimed" style="border-color: #3d0c0c;">
                    Em Progresso
                  </div>
                <% } %>
              </div>
            </article>
          <% }); %>
        <% } else { %>
          <p class="text-muted small font-monospace mb-0 py-2">Nenhuma missão diária disponível no momento.</p>
        <% } %>
      </section>

      <!-- CATEGORIA 2: DESAFIOS TÁTICOS DE COMBATE -->
      <section class="gothic-mission-category-block">
        <div class="gothic-category-title">
          <span class="material-symbols-outlined text-danger">swords</span>
          <span>Desafios de Combate &bull; Domínio da Arena</span>
        </div>

        <% if (battleMissions && battleMissions.length > 0) { %>
          <% battleMissions.forEach(function(m) { %>
            <% const isClaimable = m.is_completed && !m.claimed_at; %>
            <% const isClaimed = Boolean(m.claimed_at); %>

            <article class="gothic-mission-tile <%= isClaimable ? 'claimable' : (isClaimed ? 'claimed' : '') %>">
              <div class="mission-meta-info">
                <h3 class="mission-title-text"><%= m.title %></h3>
                <p class="mission-desc-text"><%= m.description %></p>

                <div class="d-flex align-items-center gap-3">
                  <div class="gothic-progress-track">
                    <div class="gothic-progress-fill <%= isClaimable ? 'done' : '' %>" style="width: <%= m.progressPercent %>%;"></div>
                  </div>
                  <span class="font-monospace small" style="color: var(--gothic-text-gold);"><%= m.current_progress %>/<%= m.requirement_count %></span>
                </div>
              </div>

              <div class="d-flex align-items-center gap-3">
                <div class="gothic-rewards-cluster">
                  <span class="gothic-reward-pill xp">+<%= m.reward_xp %> XP</span>
                  <span class="gothic-reward-pill">
                    <span class="material-symbols-outlined" style="font-size: 14px;">monetization_on</span>
                    +<%= m.reward_coins %>
                  </span>
                </div>

                <% if (isClaimable) { %>
                  <form action="/missions/<%= m.mission_id %>/claim" method="POST" class="m-0" onsubmit="triggerClaimAudio()">
                    <button type="submit" class="gothic-btn-claim">
                      <span class="material-symbols-outlined" style="font-size: 15px;">redeem</span> Resgatar
                    </button>
                  </form>
                <% } else if (isClaimed) { %>
                  <div class="gothic-btn-claimed">
                    <span class="material-symbols-outlined" style="font-size: 15px;">done_all</span> Resgatada
                  </div>
                <% } else { %>
                  <div class="gothic-btn-claimed" style="border-color: #3d0c0c;">
                    Em Progresso
                  </div>
                <% } %>
              </div>
            </article>
          <% }); %>
        <% } else { %>
          <p class="text-muted small font-monospace mb-0 py-2">Nenhum desafio de combate registrado.</p>
        <% } %>
      </section>

      <!-- CATEGORIA 3: CONQUISTAS DE CARREIRA E PROGRESSÃO -->
      <section class="gothic-mission-category-block">
        <div class="gothic-category-title">
          <span class="material-symbols-outlined text-info">military_tech</span>
          <span>Conquistas de Carreira &bull; Marcos Históricos</span>
        </div>

        <% if (progressionMissions && progressionMissions.length > 0) { %>
          <% progressionMissions.forEach(function(m) { %>
            <% const isClaimable = m.is_completed && !m.claimed_at; %>
            <% const isClaimed = Boolean(m.claimed_at); %>

            <article class="gothic-mission-tile <%= isClaimable ? 'claimable' : (isClaimed ? 'claimed' : '') %>">
              <div class="mission-meta-info">
                <h3 class="mission-title-text"><%= m.title %></h3>
                <p class="mission-desc-text"><%= m.description %></p>

                <div class="d-flex align-items-center gap-3">
                  <div class="gothic-progress-track">
                    <div class="gothic-progress-fill <%= isClaimable ? 'done' : '' %>" style="width: <%= m.progressPercent %>%;"></div>
                  </div>
                  <span class="font-monospace small" style="color: var(--gothic-text-gold);"><%= m.current_progress %>/<%= m.requirement_count %></span>
                </div>
              </div>

              <div class="d-flex align-items-center gap-3">
                <div class="gothic-rewards-cluster">
                  <span class="gothic-reward-pill xp" style="border-color: #d946ef; color: #f0abfc;">+<%= m.reward_xp %> XP</span>
                  <span class="gothic-reward-pill">
                    <span class="material-symbols-outlined" style="font-size: 14px;">monetization_on</span>
                    +<%= m.reward_coins %>
                  </span>
                </div>

                <% if (isClaimable) { %>
                  <form action="/missions/<%= m.mission_id %>/claim" method="POST" class="m-0" onsubmit="triggerClaimAudio()">
                    <button type="submit" class="gothic-btn-claim">
                      <span class="material-symbols-outlined" style="font-size: 15px;">redeem</span> Resgatar
                    </button>
                  </form>
                <% } else if (isClaimed) { %>
                  <div class="gothic-btn-claimed">
                    <span class="material-symbols-outlined" style="font-size: 15px;">done_all</span> Resgatada
                  </div>
                <% } else { %>
                  <div class="gothic-btn-claimed" style="border-color: #3d0c0c;">
                    Em Progresso
                  </div>
                <% } %>
              </div>
            </article>
          <% }); %>
        <% } else { %>
          <p class="text-muted small font-monospace mb-0 py-2">Nenhuma conquista de carreira disponível.</p>
        <% } %>
      </section>

      <!-- 4. Barra Inferior com Orbe da Facção -->
      <footer class="gothic-bottom-hotbar">
        <div class="d-flex align-items-center gap-2">
          <a href="/battle" class="gothic-tab-link" title="Arena">
            <span class="material-symbols-outlined" style="font-size: 22px;">swords</span>
          </a>
          <a href="/decks" class="gothic-tab-link" title="Baralhos">
            <span class="material-symbols-outlined" style="font-size: 22px;">backpack</span>
          </a>
          <a href="/characters" class="gothic-tab-link" title="Heróis">
            <span class="material-symbols-outlined" style="font-size: 22px;">sports_martial_arts</span>
          </a>
        </div>

        <!-- ORBE CENTRAL -->
        <div class="gothic-orb-assembly">
          <div class="gothic-orb-sphere" title="Quadro de Missões">
            <span class="material-symbols-outlined text-white" style="font-size: 32px; filter: drop-shadow(0 0 8px #ffffff);">task_alt</span>
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/ranking" class="gothic-tab-link" title="Classificação">
            <span class="material-symbols-outlined" style="font-size: 22px;">military_tech</span>
          </a>
          <a href="/history" class="gothic-tab-link" title="Histórico">
            <span class="material-symbols-outlined" style="font-size: 22px;">history</span>
          </a>
          <a href="/dashboard" class="gothic-tab-link" title="Quartel-General">
            <span class="material-symbols-outlined" style="font-size: 22px;">dashboard</span>
          </a>
        </div>
      </footer>
    </div>
  </main>

  <!-- Lógica JavaScript: Tema e Som de Resgate -->
  <script>
    function applyGothicTheme() {
      const theme = localStorage.getItem('joker_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = theme === 'dark' ? 'DARK' : 'LIGHT';
    }

    function toggleGothicTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('joker_theme', next);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = next === 'dark' ? 'DARK' : 'LIGHT';

      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playUiClick();
      }
    }

    applyGothicTheme();

    function triggerClaimAudio() {
      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playVictory();
      }
    }
  </script>

  <!-- Rodapé Oficial -->
  <%- include('../partials/footer') %>
</body>
</html>