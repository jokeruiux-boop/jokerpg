<!-- Google Fonts: Cinzel & Plus Jakarta Sans -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800;900&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap" rel="stylesheet">

<!-- Google Material Symbols Oficial (Sem Emojis) -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

<footer class="joker-gothic-footer mt-auto">
  <!-- Filete Superior de Ouro Forjado e Ferro Escuro -->
  <div class="gothic-footer-trim"></div>

  <!-- Corpo Principal do Rodapé — LOGO CENTRALIZADO EM LINHA ÚNICA -->
  <div class="gothic-footer-body py-4">
    <div class="container-fluid px-3 px-lg-4">
      <div class="footer-centered-stage">
        <!-- LOGO SECUNDÁRIO OFICIAL (logo2.png) — PROTAGONISTA ABSOLUTO -->
        <img src="/images/logo2.png" alt="JOKER RPG" class="footer-brand-logo">
      </div>
    </div>
  </div>

  <!-- Faixa Carmesim Inferior com Filigranas -->
  <div class="footer-crimson-subbar py-2">
    <div class="container-fluid px-3 px-lg-4 d-flex align-items-center justify-content-between">
      <div class="footer-ornament-glyphs">&#10070;&#10070;&#10070;</div>
      <div class="footer-motto-text">ARENA TÁTICA &bull; COMBOS ELEMENTAIS &bull; BREAK SYSTEM</div>
      <div class="footer-ornament-glyphs">&#10070;&#10070;&#10070;</div>
    </div>
  </div>
</footer>

<!-- Bootstrap 5.3 Bundle JavaScript Oficial -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<style>
  /* ========================================================================
     ESTILIZAÇÃO TOTAL AUTOCONTIDA: RODAPÉ GÓTICO DARK FANTASY ENXUTO
     ======================================================================== */

  .joker-gothic-footer {
    width: 100%;
    position: relative;
    background: #090202;
    z-index: 100;
    user-select: none;
  }

  /* Linha Superior com Ouro Forjado */
  .gothic-footer-trim {
    height: 3px;
    width: 100%;
    background: linear-gradient(90deg, 
      #200404 0%, 
      #6a190b 20%, 
      #b38b4d 50%, 
      #6a190b 80%, 
      #200404 100%
    );
    box-shadow: 0 0 12px rgba(179, 139, 77, 0.5);
  }

  /* Corpo Principal — Estágio Centralizado */
  .gothic-footer-body {
    background: 
      radial-gradient(ellipse at 50% 50%, rgba(179, 139, 77, 0.12) 0%, transparent 75%),
      linear-gradient(180deg, #120404 0%, #070202 100%);
    border-bottom: 2px solid #2d0b0b;
  }

  .footer-centered-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px 0;
  }

  /* ========================================================================
     LOGO SECUNDÁRIO OFICIAL (logo2.png) — PROTAGONISTA DO RODAPÉ
     ======================================================================== */
  .footer-brand-logo {
    height: 56px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
    filter: 
      drop-shadow(0 0 8px rgba(212, 175, 55, 0.9))
      drop-shadow(0 0 22px rgba(179, 139, 77, 0.65))
      drop-shadow(0 0 40px rgba(220, 38, 38, 0.35));
    transition: transform 0.3s ease, filter 0.3s ease;
    display: block;
  }

  .footer-brand-logo:hover {
    transform: scale(1.06);
    filter: 
      drop-shadow(0 0 12px rgba(255, 215, 100, 1))
      drop-shadow(0 0 28px rgba(212, 175, 55, 0.95))
      drop-shadow(0 0 55px rgba(220, 38, 38, 0.55));
  }

  /* Faixa Carmesim Inferior com Filigranas */
  .footer-crimson-subbar {
    background: linear-gradient(180deg, #450608 0%, #290305 100%);
    border-top: 1px solid #630c0e;
  }

  .footer-ornament-glyphs {
    color: #b38b4d;
    font-size: 0.85rem;
    letter-spacing: 2px;
    opacity: 0.75;
  }

  .footer-motto-text {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 2px;
    color: #fca5a5;
    text-transform: uppercase;
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer-ornament-glyphs {
      display: none;
    }
    .footer-motto-text {
      font-size: 0.65rem;
      margin: 0 auto;
    }
    .footer-brand-logo {
      height: 42px;
      max-width: 180px;
    }
  }
</style>