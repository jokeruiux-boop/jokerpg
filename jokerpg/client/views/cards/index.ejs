<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <%- include('../partials/head') %>

  <!-- Google Fonts: Plus Jakarta Sans, Outfit & Cinzel (Tipografia Gótica / Dark Fantasy) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Google Material Symbols Oficial (Sem Emojis) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Biblioteca SweetAlert2 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    /* ==========================================================================
       JOKER RPG — ARSENAL DE CARTAS DARK FANTASY (DESIGN CHAPADO DIABLO / MMO)
       Molduras em Pedra de Ferro, Cantoneiras Douradas e Cards Táticos Chapados
       ========================================================================== */

    :root[data-theme="dark"] {
      --gothic-bg: #090404;
      --gothic-frame-bg: #140707;
      --gothic-panel: #0d0404;
      --gothic-panel-card: linear-gradient(180deg, #180808 0%, #0d0303 100%);
      --gothic-border-outer: #381010;
      --gothic-border-gold: #b38b4d;
      --gothic-border-gold-glow: rgba(179, 139, 77, 0.45);
      --gothic-filigree: #8a6530;
      --gothic-text: #eae0d5;
      --gothic-text-gold: #d4af37;
      --gothic-text-muted: #8e7a6d;
      --gothic-red-glow: rgba(220, 38, 38, 0.7);
      --gothic-slot-bg: #190505;
      --gothic-slot-border: #4a1515;
      --gothic-hotbar-bg: #100505;
    }

    :root[data-theme="light"] {
      --gothic-bg: #ece6dc;
      --gothic-frame-bg: #dcd3c3;
      --gothic-panel: #f4eee2;
      --gothic-panel-card: linear-gradient(180deg, #ffffff 0%, #f1e9dc 100%);
      --gothic-border-outer: #8a6e55;
      --gothic-border-gold: #966f2d;
      --gothic-border-gold-glow: rgba(150, 111, 45, 0.3);
      --gothic-filigree: #78531e;
      --gothic-text: #261c14;
      --gothic-text-gold: #825a17;
      --gothic-text-muted: #6e5a4c;
      --gothic-red-glow: rgba(185, 28, 28, 0.4);
      --gothic-slot-bg: #e2d7c5;
      --gothic-slot-border: #9c846e;
      --gothic-hotbar-bg: #cfc2ad;
    }

    body {
      background: var(--gothic-bg) !important;
      color: var(--gothic-text);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      margin: 0;
      padding: 0;
      transition: background-color 0.25s ease, color 0.25s ease;
      user-select: none;
    }

    .material-symbols-outlined {
      font-family: 'Material Symbols Outlined';
      font-weight: 500;
      font-size: 20px;
      line-height: 1;
      display: inline-block;
      vertical-align: middle;
    }

    .gothic-cards-wrapper {
      max-width: 1400px;
      margin: 20px auto 50px auto;
      padding: 0 16px;
    }

    /* Moldura Principal de Pedra de Ferro */
    .gothic-main-frame {
      background: var(--gothic-frame-bg);
      border: 4px solid var(--gothic-border-outer);
      border-radius: 4px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.95), inset 0 0 30px rgba(0, 0, 0, 0.8);
      position: relative;
      padding: 8px;
    }

    /* Cantoneiras Metálicas Ornamentais */
    .gothic-corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border: 2.5px solid var(--gothic-border-gold);
      z-index: 10;
      pointer-events: none;
    }
    .gothic-corner.top-left { top: 2px; left: 2px; border-right: none; border-bottom: none; }
    .gothic-corner.top-right { top: 2px; right: 2px; border-left: none; border-bottom: none; }
    .gothic-corner.bottom-left { bottom: 2px; left: 2px; border-right: none; border-top: none; }
    .gothic-corner.bottom-right { bottom: 2px; right: 2px; border-left: none; border-top: none; }

    /* Barra Superior de Abas */
    .gothic-nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #2d0b0b;
      background: #090202;
      padding: 6px 16px;
    }

    .gothic-tabs-group {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .gothic-tab-link {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.92rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #634f47;
      text-decoration: none;
      padding: 6px 12px;
      position: relative;
      transition: all 0.2s ease;
    }

    .gothic-tab-link:hover {
      color: #b58d60;
    }

    .gothic-tab-link.active {
      color: #ffffff;
      text-shadow: 0 0 10px var(--gothic-red-glow), 0 0 20px rgba(255, 30, 0, 0.8);
    }

    .gothic-tab-link.active::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent 0%, #ff3b30 50%, transparent 100%);
      box-shadow: 0 0 8px #ff3b30;
    }

    .gothic-theme-toggle-btn {
      background: transparent;
      border: 1px solid var(--gothic-filigree);
      color: var(--gothic-text-gold);
      padding: 4px 10px;
      border-radius: 2px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Cinzel', serif;
      font-size: 0.74rem;
      transition: all 0.15s ease;
    }

    .gothic-theme-toggle-btn:hover {
      box-shadow: 0 0 8px var(--gothic-border-gold-glow);
    }

    /* Cabeçalho de Status / Arsenal de Cartas */
    .gothic-cards-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 2px solid #2d0b0b;
      position: relative;
      flex-wrap: wrap;
      gap: 16px;
    }

    .gothic-header-title-box {
      text-align: left;
    }

    .gothic-header-main-title {
      font-family: 'Cinzel', serif;
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--gothic-text);
      line-height: 1.1;
      margin: 0;
    }

    .gothic-header-sub {
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      letter-spacing: 2px;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
      margin-top: 4px;
    }

    .gothic-emblem-medallion {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: radial-gradient(circle, #2e0909 0%, #0d0202 100%);
      border: 2px solid #5a1818;
      box-shadow: inset 0 0 10px #000, 0 0 15px rgba(220, 38, 38, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .gothic-stats-summary {
      font-family: 'Cinzel', serif;
      text-align: right;
    }

    .gothic-stats-numbers {
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: 1px;
    }

    /* Painel de Filtros Táticos Gótico */
    .gothic-filter-strip {
      background: var(--gothic-panel);
      border: 1px solid var(--gothic-border-gold);
      padding: 14px 18px;
      margin: 14px;
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.85);
    }

    .gothic-input, .gothic-select {
      background: var(--gothic-slot-bg);
      border: 1px solid var(--gothic-slot-border);
      color: var(--gothic-text);
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      letter-spacing: 1px;
      padding: 6px 12px;
      border-radius: 2px;
      outline: none;
      width: 100%;
      transition: all 0.15s ease;
    }

    .gothic-input:focus, .gothic-select:focus {
      border-color: var(--gothic-border-gold);
      box-shadow: 0 0 8px var(--gothic-border-gold-glow);
    }

    /* Grid de Cards das Cartas Táticas */
    .gothic-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 16px;
      padding: 0 14px 14px 14px;
    }

    /* Card Individual da Carta Tática (Moldura de Ferro e Ouro) */
    .gothic-tactical-card {
      background: var(--gothic-panel-card);
      border: 2px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.9), 0 8px 24px rgba(0, 0, 0, 0.7);
      border-radius: 2px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
      min-height: 420px;
    }

    .gothic-tactical-card:hover {
      transform: translateY(-4px);
      border-color: #ffaa00;
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.8), 0 12px 30px rgba(0, 0, 0, 0.9), 0 0 16px var(--gothic-border-gold-glow);
    }

    /* Topo do Card: Custo de Energia e Posse */
    .gothic-card-top-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }

    .gothic-energy-gem {
      width: 28px;
      height: 28px;
      background: radial-gradient(circle, #2e0909 0%, #0d0202 100%);
      border: 1.5px solid var(--gothic-border-gold);
      border-radius: 50%;
      color: #ffcc00;
      font-family: 'Cinzel', serif;
      font-size: 0.82rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 8px var(--gothic-border-gold-glow);
    }

    .gothic-possession-tag {
      font-family: 'Cinzel', serif;
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 1px;
      padding: 2px 8px;
      border-radius: 2px;
      text-transform: uppercase;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
    }

    .gothic-possession-tag.owned {
      background: #10b981;
      color: #000;
      border: 1px solid #059669;
    }

    .gothic-possession-tag.unowned {
      background: #250808;
      color: #8c6d6d;
      border: 1px solid #4a1515;
    }

    /* Vitrine Visual da Arte da Carta */
    .gothic-card-art-box {
      width: 100%;
      height: 160px;
      background: #000;
      border: 1.5px solid var(--gothic-border-gold);
      border-radius: 2px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 10px;
    }

    .gothic-card-art-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.4s ease;
    }

    .gothic-tactical-card:hover .gothic-card-art-img {
      transform: scale(1.05);
    }

    /* Informações e Título */
    .gothic-card-name {
      font-family: 'Cinzel', serif;
      font-weight: 800;
      font-size: 1.05rem;
      letter-spacing: 1px;
      color: var(--gothic-text);
      margin: 0 0 4px 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .gothic-card-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }

    .gothic-elem-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 2px 8px;
      background: #190505;
      border: 1px solid var(--gothic-border-gold);
      border-radius: 2px;
      font-family: 'Cinzel', serif;
      font-size: 0.68rem;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
    }

    .gothic-elem-icon {
      width: 14px;
      height: 14px;
      object-fit: contain;
    }

    .gothic-type-badge {
      font-family: 'Cinzel', serif;
      font-size: 0.68rem;
      color: var(--gothic-text-muted);
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* Faixa de Atributos Táticos (Dano, Defesa, Break) */
    .gothic-card-stats-band {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 4px;
      text-align: center;
      padding: 8px 0;
      border-top: 1px solid rgba(179, 139, 77, 0.25);
      border-bottom: 1px solid rgba(179, 139, 77, 0.25);
      background: rgba(0, 0, 0, 0.3);
      margin-bottom: 8px;
    }

    .gothic-stat-val-gold {
      font-family: 'Cinzel', serif;
      font-weight: 800;
      font-size: 0.95rem;
      color: #ffcc00;
      line-height: 1;
      margin-bottom: 2px;
    }

    .gothic-stat-lbl-mini {
      font-size: 0.62rem;
      color: var(--gothic-text-dim);
      font-family: 'Cinzel', serif;
      display: block;
    }

    /* Descrição */
    .gothic-card-desc {
      font-size: 0.78rem;
      color: var(--gothic-text-muted);
      line-height: 1.4;
      min-height: 40px;
      margin-bottom: 8px;
    }

    /* Rodapé da Carta */
    .gothic-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid rgba(179, 139, 77, 0.2);
      padding-top: 6px;
      font-family: 'Cinzel', serif;
      font-size: 0.68rem;
      color: var(--gothic-text-muted);
    }

    /* Botão Genérico Gótico */
    .gothic-btn {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.8rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 8px 16px;
      border-radius: 2px;
      border: 1px solid var(--gothic-border-gold);
      background: linear-gradient(180deg, #3d1414 0%, #170505 100%);
      color: #ffffff;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
      transition: all 0.15s ease;
    }

    .gothic-btn:hover {
      background: linear-gradient(180deg, #6c1c1c 0%, #2e0909 100%);
      border-color: #ffaa00;
      color: #ffdd44;
      transform: scale(1.02);
    }

    .gothic-btn.secondary {
      background: transparent;
      border-color: var(--gothic-border-gold);
      color: var(--gothic-text-gold);
    }

    .gothic-btn.secondary:hover {
      background: rgba(179, 139, 77, 0.15);
      color: #ffffff;
    }

    /* Paginação Gótica */
    .gothic-pagination-bar {
      padding: 16px 20px;
      border-top: 2px solid #2d0b0b;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
    }

    .gothic-page-link {
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--gothic-text-gold);
      border: 1px solid var(--gothic-border-gold);
      background: var(--gothic-slot-bg);
      padding: 5px 12px;
      text-decoration: none;
      border-radius: 2px;
      transition: all 0.15s ease;
    }

    .gothic-page-link:hover {
      background: #4a1515;
      color: #ffffff;
    }

    /* Barra Inferior com Orbe */
    .gothic-bottom-hotbar {
      background: var(--gothic-hotbar-bg);
      border-top: 2px solid #3d0c0c;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
    }

    .gothic-orb-assembly {
      position: absolute;
      left: 50%;
      top: -24px;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 25;
    }

    .gothic-orb-sphere {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #ff7700 0%, #cc1100 50%, #440000 100%);
      box-shadow: 0 0 25px rgba(255, 60, 0, 0.85), inset 0 -6px 14px rgba(0, 0, 0, 0.8);
      position: relative;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease;
    }

    .gothic-orb-sphere:hover {
      transform: scale(1.08);
    }

    @media (max-width: 768px) {
      .gothic-cards-grid {
        grid-template-columns: 1fr;
      }
      .gothic-cards-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .gothic-nav-bar {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
      }
      .gothic-orb-assembly {
        position: static;
        transform: none;
        margin: 10px auto;
      }
      .gothic-bottom-hotbar {
        flex-direction: column;
        gap: 16px;
      }
    }
  </style>
</head>
<body>
  <!-- Barra de Navegação Superior Integrada -->
  <%- include('../partials/navbar') %>

  <!-- ========================================================================
       JANELA GÓTICA CHAPADA DE CARTAS (DIABLO / CLASSIC RPG SHELL)
       ======================================================================== -->
  <main class="gothic-cards-wrapper">
    <!-- Alertas Globais -->
    <%- include('../partials/messages') %>

    <div class="gothic-main-frame">
      <!-- Cantoneiras Ornamentais de Ferro e Ouro -->
      <span class="gothic-corner top-left"></span>
      <span class="gothic-corner top-right"></span>
      <span class="gothic-corner bottom-left"></span>
      <span class="gothic-corner bottom-right"></span>

      <!-- 1. Abas Superiores Idênticas à Referência -->
      <header class="gothic-nav-bar">
        <div class="gothic-tabs-group">
          <a href="/cards" class="gothic-tab-link active">CARDS (ARSENAL)</a>
          <a href="/decks" class="gothic-tab-link">DECKS</a>
          <a href="/characters" class="gothic-tab-link">HEROES</a>
          <a href="/battle" class="gothic-tab-link">ARENA</a>
          <a href="/dashboard" class="gothic-tab-link">COMMAND (QG)</a>
        </div>

        <button type="button" class="gothic-theme-toggle-btn" onclick="toggleGothicTheme()" title="Alternar Modo Claro e Escuro">
          <span class="material-symbols-outlined" style="font-size: 16px;">contrast</span>
          <span id="themeText">DARK</span>
        </button>
      </header>

      <!-- 2. Cabeçalho de Status: Título, Medalhão Central e Estatísticas de Posse -->
      <section class="gothic-cards-header">
        <div class="gothic-header-title-box">
          <h1 class="gothic-header-main-title">Arsenal de Cartas Táticas</h1>
          <div class="gothic-header-sub">Catálogo de Manobras &bull; Poder e Sinergia Elemental</div>
        </div>

        <div class="gothic-emblem-medallion">
          <span class="material-symbols-outlined" style="font-size: 28px; color: #ff3333; filter: drop-shadow(0 0 6px rgba(255,51,51,0.8));">style</span>
        </div>

        <div class="gothic-stats-summary">
          <div class="gothic-stats-numbers">
            <span class="text-warning"><%= totalOwnedUnique %></span>
            <span style="color: var(--gothic-text-muted);">/</span>
            <span class="text-main"><%= pagination.total %></span>
          </div>
          <div class="small font-monospace" style="color: var(--gothic-text-gold); font-size: 0.68rem;">CARTAS COLECIONADAS</div>
        </div>
      </section>

      <!-- 3. Painel de Filtros Táticos Estilo HUD Gótico -->
      <section class="gothic-filter-strip">
        <form action="/cards" method="GET" class="row g-2 align-items-center">
          <!-- Busca por Nome ou Efeito -->
          <div class="col-12 col-md-4">
            <input 
              type="text" 
              class="gothic-input" 
              name="search" 
              placeholder="BUSCAR POR NOME OU EFEITO..." 
              value="<%= filters.search %>"
            >
          </div>

          <!-- Filtro de Tipo -->
          <div class="col-6 col-md-2">
            <select name="type" class="gothic-select">
              <option value="">TIPO: TODOS</option>
              <% Object.values(constants.CARD_TYPES).forEach(function(t) { %>
                <option value="<%= t %>" <%= filters.type === t ? 'selected' : '' %>><%= t %></option>
              <% }); %>
            </select>
          </div>

          <!-- Filtro de Elemento -->
          <div class="col-6 col-md-2">
            <select name="element" class="gothic-select">
              <option value="">ELEMENTO: TODOS</option>
              <% Object.values(constants.ELEMENTS).forEach(function(elem) { %>
                <option value="<%= elem %>" <%= filters.element === elem ? 'selected' : '' %>><%= elem %></option>
              <% }); %>
            </select>
          </div>

          <!-- Filtro de Raridade -->
          <div class="col-6 col-md-2">
            <select name="rarity" class="gothic-select">
              <option value="">RARIDADE: TODAS</option>
              <% Object.values(constants.RARITIES).forEach(function(rar) { %>
                <option value="<%= rar %>" <%= filters.rarity === rar ? 'selected' : '' %>><%= rar %></option>
              <% }); %>
            </select>
          </div>

          <!-- Botões de Filtragem -->
          <div class="col-6 col-md-2 d-flex gap-1">
            <button type="submit" class="gothic-btn w-100 py-1" style="font-size: 0.72rem;">
              <span class="material-symbols-outlined" style="font-size: 15px;">filter_alt</span> FILTRAR
            </button>
            <% if (filters.search || filters.type || filters.element || filters.rarity) { %>
              <a href="/cards" class="gothic-btn secondary py-1 px-2" title="Limpar Filtros" style="width: auto;">
                <span class="material-symbols-outlined" style="font-size: 15px;">close</span>
              </a>
            <% } %>
          </div>
        </form>
      </section>

      <!-- 4. Grid de Cards Táticos Chapados com Ícones Reais -->
      <% if (cards && cards.length > 0) { %>
        <section class="gothic-cards-grid">
          <% cards.forEach(function(card) { %>
            <% const quantityOwned = ownedQuantityMap[card.id] || 0; %>

            <article class="gothic-tactical-card" onclick="inspectCardDetails('<%= card.id %>')">
              <div>
                <!-- Topo da Carta: Custo de Energia e Tag de Posse -->
                <div class="gothic-card-top-bar">
                  <div class="gothic-energy-gem" title="Custo de Energia">
                    <%= card.energy_cost %>
                  </div>

                  <div class="gothic-possession-tag <%= quantityOwned > 0 ? 'owned' : 'unowned' %>">
                    <%= quantityOwned > 0 ? `POSSUI: x${quantityOwned}` : 'NÃO POSSUI' %>
                  </div>
                </div>

                <!-- Arte Real da Carta (Fallback Inteligente para card-back.png) -->
                <div class="gothic-card-art-box">
                  <img 
                    src="/images/card/<%= card.id %>" 
                    alt="<%= card.name %>" 
                    class="gothic-card-art-img" 
                    onerror="this.onerror=null; this.src='/images/card-back.png';"
                  >
                </div>

                <!-- Título e Identificação -->
                <h3 class="gothic-card-name" title="<%= card.name %>"><%= card.name %></h3>

                <!-- Linha de Metadados com Ícone Real do Elemento -->
                <div class="gothic-card-meta">
                  <div class="gothic-elem-badge">
                    <img 
                      src="/images/icons/<%= card.element.toLowerCase() %>.png" 
                      alt="<%= card.element %>" 
                      class="gothic-elem-icon"
                      onerror="this.style.display='none'"
                    >
                    <span><%= card.element %></span>
                  </div>
                  <span class="gothic-type-badge"><%= card.type %> &bull; <%= card.rarity %></span>
                </div>
              </div>

              <div>
                <!-- Faixa de Atributos Táticos (Dano, Defesa, Break) com Ícones Oficiais -->
                <div class="gothic-card-stats-band">
                  <div>
                    <div class="gothic-stat-val-gold" style="color: #ff4444;"><%= card.damage || 0 %></div>
                    <span class="gothic-stat-lbl-mini">DANO</span>
                  </div>
                  <div>
                    <div class="gothic-stat-val-gold" style="color: #00d2ff;"><%= card.defense || 0 %></div>
                    <span class="gothic-stat-lbl-mini">DEFESA</span>
                  </div>
                  <div>
                    <div class="gothic-stat-val-gold" style="color: #ffaa00;"><%= card.break_damage || 0 %></div>
                    <span class="gothic-stat-lbl-mini">BREAK</span>
                  </div>
                </div>

                <!-- Descrição dos Efeitos -->
                <p class="gothic-card-desc">
                  <%= card.description %>
                </p>

                <!-- Rodapé da Carta: Combo e Cooldown -->
                <div class="gothic-card-footer">
                  <span>COMBO: <%= card.combo_modifier || 'STANDARD' %></span>
                  <span>CD: <%= card.cooldown %>R</span>
                </div>
              </div>
            </article>
          <% }); %>
        </section>

        <!-- 5. Paginação Gótica -->
        <% if (pagination.totalPages > 1) { %>
          <div class="gothic-pagination-bar">
            <% if (pagination.currentPage > 1) { %>
              <a class="gothic-page-link" href="/cards?page=<%= pagination.currentPage - 1 %>&search=<%= filters.search %>&type=<%= filters.type %>&element=<%= filters.element %>&rarity=<%= filters.rarity %>">&laquo; ANTERIOR</a>
            <% } %>

            <span class="small font-monospace" style="color: var(--gothic-text-muted);">
              PÁGINA <%= pagination.currentPage %> DE <%= pagination.totalPages %>
            </span>

            <% if (pagination.currentPage < pagination.totalPages) { %>
              <a class="gothic-page-link" href="/cards?page=<%= pagination.currentPage + 1 %>&search=<%= filters.search %>&type=<%= filters.type %>&element=<%= filters.element %>&rarity=<%= filters.rarity %>">PRÓXIMA &raquo;</a>
            <% } %>
          </div>
        <% } %>
      <% } else { %>
        <div class="p-5 text-center text-muted font-monospace small">
          <span class="material-symbols-outlined" style="font-size: 48px; opacity: 0.3; margin-bottom: 12px;">style</span>
          <p class="mb-0">Nenhuma carta tática localizada para os filtros selecionados.</p>
        </div>
      <% } %>

      <!-- 6. Barra Inferior com Orbe da Facção -->
      <footer class="gothic-bottom-hotbar">
        <div class="d-flex align-items-center gap-2">
          <a href="/decks" class="gothic-tab-link" title="Baralhos">
            <span class="material-symbols-outlined" style="font-size: 22px;">backpack</span>
          </a>
          <a href="/characters" class="gothic-tab-link" title="Heróis">
            <span class="material-symbols-outlined" style="font-size: 22px;">sports_martial_arts</span>
          </a>
          <a href="/missions" class="gothic-tab-link" title="Missões">
            <span class="material-symbols-outlined" style="font-size: 22px;">task_alt</span>
          </a>
        </div>

        <!-- ORBE CENTRAL -->
        <div class="gothic-orb-assembly">
          <div class="gothic-orb-sphere" title="Arsenal de Cartas">
            <span class="material-symbols-outlined text-white" style="font-size: 32px; filter: drop-shadow(0 0 8px #ffffff);">style</span>
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/ranking" class="gothic-tab-link" title="Classificação">
            <span class="material-symbols-outlined" style="font-size: 22px;">military_tech</span>
          </a>
          <a href="/battle" class="gothic-tab-link" title="Arena de Combate">
            <span class="material-symbols-outlined" style="font-size: 22px;">swords</span>
          </a>
          <a href="/dashboard" class="gothic-tab-link" title="Quartel-General">
            <span class="material-symbols-outlined" style="font-size: 22px;">dashboard</span>
          </a>
        </div>
      </footer>
    </div>
  </main>

  <!-- ========================================================================
       MODAL DE INSPEÇÃO TÁTICA VIA SWEETALERT2
       ======================================================================== -->
  <script>
    // 1. Motor de Alternância de Tema Claro e Escuro
    function applyGothicTheme() {
      const theme = localStorage.getItem('joker_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = theme === 'dark' ? 'DARK' : 'LIGHT';
    }

    function toggleGothicTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('joker_theme', next);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = next === 'dark' ? 'DARK' : 'LIGHT';

      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playUiClick();
      }
    }

    applyGothicTheme();

    // 2. Inspeção Rápida da Carta com SweetAlert2
    async function inspectCardDetails(cardId) {
      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playCardSelect();
      }

      try {
        const res = await fetch(`/cards/${cardId}/details`);
        const data = await res.json();

        if (data.success && data.card) {
          const c = data.card;
          Swal.fire({
            title: `<span style="font-family: 'Cinzel', serif; letter-spacing: 2px;">${c.name}</span>`,
            html: `
              <div style="text-align: center; padding: 6px;">
                <img src="/images/card/${c.id}" onerror="this.onerror=null; this.src='/images/card-back.png';" style="max-height: 180px; border: 2px solid #b38b4d; border-radius: 4px; margin-bottom: 12px; box-shadow: 0 4px 14px rgba(0,0,0,0.8);">
                <div style="font-family: 'Cinzel', serif; font-size: 0.85rem; color: #ffaa00; margin-bottom: 10px;">
                  ${c.type} &bull; ${c.rarity} &bull; ${c.element}
                </div>
                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; background: #0d0202; border: 1px solid #b38b4d; padding: 8px; border-radius: 2px; font-family: 'Cinzel', serif; font-size: 0.8rem; margin-bottom: 12px;">
                  <div><span style="color: #ffcc00; font-weight: 800;">⚡ ${c.energy_cost}</span><br><small style="color: #888;">EN</small></div>
                  <div><span style="color: #ff4444; font-weight: 800;">⚔ ${c.damage || 0}</span><br><small style="color: #888;">DANO</small></div>
                  <div><span style="color: #00d2ff; font-weight: 800;">🛡 ${c.defense || 0}</span><br><small style="color: #888;">DEF</small></div>
                  <div><span style="color: #ffaa00; font-weight: 800;">💥 ${c.break_damage || 0}</span><br><small style="color: #888;">BRK</small></div>
                </div>
                <p style="font-family: 'Rajdhani', sans-serif; font-size: 0.95rem; color: #eae0d5; text-align: left; line-height: 1.5; margin: 0;">
                  ${c.description}
                </p>
              </div>
            `,
            confirmButtonText: 'Fechar',
            confirmButtonColor: '#781c2f',
            background: '#140707',
            color: '#eae0d5'
          });
        }
      } catch (err) {
        console.error('Falha ao inspecionar carta:', err);
      }
    }
  </script>

  <!-- Rodapé Oficial -->
  <%- include('../partials/footer') %>
</body>
</html>