<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <%- include('../partials/head') %>

  <!-- Google Fonts: Plus Jakarta Sans, Outfit & Cinzel (Tipografia Gótica / Dark Fantasy) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Google Material Symbols Oficial (Sem Emojis) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Biblioteca SweetAlert2 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    /* ==========================================================================
       JOKER RPG — GALERIA DE HERÓIS DARK FANTASY (DESIGN CHAPADO DIABLO / MMO)
       Molduras em Pedra de Ferro, Cantoneiras Douradas e Ícones Reais
       ========================================================================== */

    :root[data-theme="dark"] {
      --gothic-bg: #090404;
      --gothic-frame-bg: #140707;
      --gothic-panel: #0d0404;
      --gothic-panel-card: linear-gradient(180deg, #180808 0%, #0d0303 100%);
      --gothic-border-outer: #381010;
      --gothic-border-gold: #b38b4d;
      --gothic-border-gold-glow: rgba(179, 139, 77, 0.45);
      --gothic-filigree: #8a6530;
      --gothic-text: #eae0d5;
      --gothic-text-gold: #d4af37;
      --gothic-text-muted: #8e7a6d;
      --gothic-red-glow: rgba(220, 38, 38, 0.7);
      --gothic-slot-bg: #190505;
      --gothic-slot-border: #4a1515;
    }

    :root[data-theme="light"] {
      --gothic-bg: #ece6dc;
      --gothic-frame-bg: #dcd3c3;
      --gothic-panel: #f4eee2;
      --gothic-panel-card: linear-gradient(180deg, #ffffff 0%, #f1e9dc 100%);
      --gothic-border-outer: #8a6e55;
      --gothic-border-gold: #966f2d;
      --gothic-border-gold-glow: rgba(150, 111, 45, 0.3);
      --gothic-filigree: #78531e;
      --gothic-text: #261c14;
      --gothic-text-gold: #825a17;
      --gothic-text-muted: #6e5a4c;
      --gothic-red-glow: rgba(185, 28, 28, 0.4);
      --gothic-slot-bg: #e2d7c5;
      --gothic-slot-border: #9c846e;
    }

    body {
      background: var(--gothic-bg) !important;
      color: var(--gothic-text);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      margin: 0;
      padding: 0;
      transition: background-color 0.25s ease, color 0.25s ease;
      user-select: none;
    }

    .material-symbols-outlined {
      font-family: 'Material Symbols Outlined';
      font-weight: 500;
      font-size: 20px;
      line-height: 1;
      display: inline-block;
      vertical-align: middle;
    }

    /* Container Chapado da Janela Mestre */
    .gothic-gallery-wrapper {
      max-width: 1400px;
      margin: 20px auto 50px auto;
      padding: 0 16px;
    }

    /* Moldura Externa de Pedra e Ouro */
    .gothic-main-frame {
      background: var(--gothic-frame-bg);
      border: 4px solid var(--gothic-border-outer);
      border-radius: 4px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.95), inset 0 0 30px rgba(0, 0, 0, 0.8);
      position: relative;
      padding: 8px;
    }

    /* Cantoneiras Metálicas Ornamentais */
    .gothic-corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border: 2.5px solid var(--gothic-border-gold);
      z-index: 10;
      pointer-events: none;
    }
    .gothic-corner.top-left { top: 2px; left: 2px; border-right: none; border-bottom: none; }
    .gothic-corner.top-right { top: 2px; right: 2px; border-left: none; border-bottom: none; }
    .gothic-corner.bottom-left { bottom: 2px; left: 2px; border-right: none; border-top: none; }
    .gothic-corner.bottom-right { bottom: 2px; right: 2px; border-left: none; border-top: none; }

    /* Barra Superior de Navegação Gótica */
    .gothic-nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #2d0b0b;
      background: #090202;
      padding: 6px 16px;
    }

    .gothic-tabs-group {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .gothic-tab-link {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #634f47;
      text-decoration: none;
      padding: 6px 12px;
      position: relative;
      transition: all 0.2s ease;
    }

    .gothic-tab-link:hover {
      color: #b58d60;
    }

    .gothic-tab-link.active {
      color: #ffffff;
      text-shadow: 0 0 10px var(--gothic-red-glow), 0 0 20px rgba(255, 30, 0, 0.8);
    }

    .gothic-tab-link.active::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent 0%, #ff3b30 50%, transparent 100%);
      box-shadow: 0 0 8px #ff3b30;
    }

    .gothic-theme-toggle-btn {
      background: transparent;
      border: 1px solid var(--gothic-filigree);
      color: var(--gothic-text-gold);
      padding: 4px 10px;
      border-radius: 2px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Cinzel', serif;
      font-size: 0.74rem;
      transition: all 0.15s ease;
    }

    .gothic-theme-toggle-btn:hover {
      box-shadow: 0 0 8px var(--gothic-border-gold-glow);
    }

    /* Cabeçalho de Status / Visão Geral da Galeria */
    .gothic-gallery-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 2px solid #2d0b0b;
      position: relative;
      flex-wrap: wrap;
      gap: 16px;
    }

    .gothic-header-title-box {
      text-align: left;
    }

    .gothic-header-main-title {
      font-family: 'Cinzel', serif;
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--gothic-text);
      line-height: 1.1;
      margin: 0;
    }

    .gothic-header-sub {
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      letter-spacing: 2px;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
      margin-top: 4px;
    }

    .gothic-emblem-medallion {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: radial-gradient(circle, #2e0909 0%, #0d0202 100%);
      border: 2px solid #5a1818;
      box-shadow: inset 0 0 10px #000, 0 0 15px rgba(220, 38, 38, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Painel de Filtros Táticos Gótico */
    .gothic-filter-strip {
      background: var(--gothic-panel);
      border: 1px solid var(--gothic-border-gold);
      padding: 14px 18px;
      margin: 14px;
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.85);
    }

    .gothic-input, .gothic-select {
      background: var(--gothic-slot-bg);
      border: 1px solid var(--gothic-slot-border);
      color: var(--gothic-text);
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      letter-spacing: 1px;
      padding: 6px 12px;
      border-radius: 2px;
      outline: none;
      width: 100%;
      transition: all 0.15s ease;
    }

    .gothic-input:focus, .gothic-select:focus {
      border-color: var(--gothic-border-gold);
      box-shadow: 0 0 8px var(--gothic-border-gold-glow);
    }

    /* Grid de Cards dos Heróis */
    .gothic-hero-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 16px;
      padding: 0 14px 14px 14px;
    }

    /* Card Individual do Herói com Moldura Dupla */
    .gothic-hero-card {
      background: var(--gothic-panel-card);
      border: 2px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.9), 0 8px 24px rgba(0, 0, 0, 0.7);
      border-radius: 2px;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .gothic-hero-card:hover {
      transform: translateY(-4px);
      border-color: #ffaa00;
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.8), 0 12px 30px rgba(0, 0, 0, 0.9), 0 0 16px var(--gothic-border-gold-glow);
    }

    /* Retrato do Herói */
    .gothic-card-portrait {
      position: relative;
      width: 100%;
      height: 240px;
      background: #000;
      border-bottom: 2px solid var(--gothic-border-gold);
      overflow: hidden;
    }

    .gothic-card-portrait-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      transition: transform 0.4s ease;
    }

    .gothic-hero-card:hover .gothic-card-portrait-img {
      transform: scale(1.05);
    }

    /* Emblema de Status e Poder */
    .gothic-status-tag {
      position: absolute;
      top: 10px;
      left: 10px;
      font-family: 'Cinzel', serif;
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 1px;
      padding: 3px 8px;
      border-radius: 2px;
      text-transform: uppercase;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
      z-index: 5;
    }

    .gothic-status-tag.main {
      background: #10b981;
      color: #000;
      border: 1px solid #059669;
    }

    .gothic-status-tag.unlocked {
      background: #d4af37;
      color: #000;
      border: 1px solid #b38b4d;
    }

    .gothic-status-tag.locked {
      background: #250808;
      color: #8c6d6d;
      border: 1px solid #4a1515;
    }

    .gothic-card-power-pill {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(10, 2, 2, 0.9);
      border: 1px solid var(--gothic-border-gold);
      color: #ffaa00;
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 1px;
      padding: 2px 8px;
      border-radius: 2px;
      z-index: 5;
    }

    /* Corpo de Dados do Card */
    .gothic-card-body {
      padding: 14px 16px;
    }

    .gothic-card-title {
      font-family: 'Cinzel', serif;
      font-weight: 800;
      font-size: 1.15rem;
      letter-spacing: 1px;
      color: var(--gothic-text);
      margin: 0 0 6px 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .gothic-card-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
    }

    /* Badge do Elemento com Ícone Real */
    .gothic-elem-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 2px 8px;
      background: #190505;
      border: 1px solid var(--gothic-border-gold);
      border-radius: 2px;
      font-family: 'Cinzel', serif;
      font-size: 0.7rem;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
    }

    .gothic-elem-icon {
      width: 14px;
      height: 14px;
      object-fit: contain;
    }

    .gothic-class-badge {
      font-family: 'Cinzel', serif;
      font-size: 0.7rem;
      color: var(--gothic-text-muted);
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* Os 4 Números Dourados com Ícones (HP, ATK, DEF, SPD) */
    .gothic-card-stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 4px;
      text-align: center;
      padding: 10px 0;
      border-top: 1px solid rgba(179, 139, 77, 0.25);
      border-bottom: 1px solid rgba(179, 139, 77, 0.25);
      background: rgba(0, 0, 0, 0.3);
      margin-bottom: 12px;
    }

    .gothic-mini-gold-number {
      font-family: 'Cinzel', serif;
      font-weight: 800;
      font-size: 0.88rem;
      color: #ffcc00;
      line-height: 1;
      margin-bottom: 4px;
    }

    .gothic-mini-stat-icon {
      font-size: 15px;
      color: var(--gothic-border-gold);
    }

    /* Botões da Ficha */
    .gothic-card-actions {
      padding: 0 16px 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .gothic-card-btn {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.78rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 7px 14px;
      border-radius: 2px;
      border: 1px solid var(--gothic-border-gold);
      background: linear-gradient(180deg, #3d1414 0%, #170505 100%);
      color: #ffffff;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
      transition: all 0.15s ease;
      width: 100%;
    }

    .gothic-card-btn:hover {
      background: linear-gradient(180deg, #6c1c1c 0%, #2e0909 100%);
      border-color: #ffaa00;
      color: #ffdd44;
      transform: scale(1.02);
    }

    .gothic-card-btn.secondary {
      background: transparent;
      border-color: var(--gothic-border-gold);
      color: var(--gothic-text-gold);
    }

    .gothic-card-btn.secondary:hover {
      background: rgba(179, 139, 77, 0.15);
      color: #ffffff;
    }

    .gothic-card-btn.active-main {
      border-color: #10b981;
      color: #10b981;
      background: rgba(16, 185, 129, 0.1);
      cursor: default;
    }

    /* Paginação Gótica */
    .gothic-pagination-bar {
      padding: 16px 20px;
      border-top: 2px solid #2d0b0b;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
    }

    .gothic-page-link {
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--gothic-text-gold);
      border: 1px solid var(--gothic-border-gold);
      background: var(--gothic-slot-bg);
      padding: 5px 12px;
      text-decoration: none;
      border-radius: 2px;
      transition: all 0.15s ease;
    }

    .gothic-page-link:hover {
      background: #4a1515;
      color: #ffffff;
    }

    @media (max-width: 768px) {
      .gothic-hero-grid {
        grid-template-columns: 1fr;
      }
      .gothic-gallery-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .gothic-nav-tabs-bar {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
      }
    }
  </style>
</head>
<body>
  <!-- Barra de Navegação Superior Integrada -->
  <%- include('../partials/navbar') %>

  <!-- Mapeamento Fiel da Arte Real do Personagem -->
  <%
    function getHeroLocalImage(name, id) {
      if (!name) return `/images/character/${id}`;
      const n = name.toLowerCase();
      let slug = 'default-avatar';
      if (n.includes('kage')) slug = 'kage';
      else if (n.includes('ignis')) slug = 'ignis';
      else if (n.includes('aegis')) slug = 'aegis';
      else if (n.includes('sylph')) slug = 'sylph';
      else if (n.includes('raikou')) slug = 'raikou';
      else if (n.includes('lumina')) slug = 'lumina';
      else if (n.includes('aqua')) slug = 'aqua';
      return `/images/characters/${slug}.png`;
    }
  %>

  <!-- ========================================================================
       JANELA GÓTICA CHAPADA DE COMBATENTES (DIABLO / CLASSIC RPG SHELL)
       ======================================================================== -->
  <main class="gothic-gallery-wrapper">
    <!-- Alertas Globais -->
    <%- include('../partials/messages') %>

    <div class="gothic-main-frame">
      <!-- Cantoneiras Ornamentais de Ferro e Ouro -->
      <span class="gothic-corner top-left"></span>
      <span class="gothic-corner top-right"></span>
      <span class="gothic-corner bottom-left"></span>
      <span class="gothic-corner bottom-right"></span>

      <!-- 1. Abas Superiores Idênticas à Imagem -->
      <header class="gothic-nav-tabs-bar">
        <div class="gothic-tabs-group">
          <a href="/characters" class="gothic-tab-link active">TEAM</a>
          <a href="/cards" class="gothic-tab-link">SKILLS</a>
          <a href="/missions" class="gothic-tab-link">QUESTS</a>
          <a href="/battle" class="gothic-tab-link">ARENA</a>
        </div>

        <button type="button" class="gothic-theme-toggle-btn" onclick="toggleGothicTheme()" title="Alternar Modo Claro e Escuro">
          <span class="material-symbols-outlined" style="font-size: 16px;">contrast</span>
          <span id="themeText">DARK</span>
        </button>
      </header>

      <!-- 2. Cabeçalho de Status: Título, Medalhão e Total de Combatentes -->
      <section class="gothic-gallery-header">
        <div class="gothic-header-title-box">
          <h1 class="gothic-header-main-title">Panteão de Combatentes</h1>
          <div class="gothic-header-sub">Arsenal Completo de Heróis do Joker RPG</div>
        </div>

        <div class="gothic-emblem-medallion">
          <span class="material-symbols-outlined" style="font-size: 28px; color: #ff3333; filter: drop-shadow(0 0 6px rgba(255,51,51,0.8));">sports_martial_arts</span>
        </div>

        <div class="font-monospace small" style="color: var(--gothic-text-gold);">
          TOTAL: <strong class="text-main"><%= pagination.total %></strong> HEROIS
        </div>
      </section>

      <!-- 3. Painel de Filtros Táticos Estilo HUD Gótico -->
      <section class="gothic-filter-strip">
        <form action="/characters" method="GET" class="row g-2 align-items-center">
          <!-- Busca por Nome -->
          <div class="col-12 col-md-4">
            <input 
              type="text" 
              class="gothic-input" 
              name="search" 
              placeholder="BUSCAR POR NOME..." 
              value="<%= filters.search %>"
            >
          </div>

          <!-- Filtro de Elemento -->
          <div class="col-6 col-md-2">
            <select name="element" class="gothic-select">
              <option value="">ELEMENTO: TODOS</option>
              <% Object.values(constants.ELEMENTS).forEach(function(elem) { %>
                <option value="<%= elem %>" <%= filters.element === elem ? 'selected' : '' %>><%= elem %></option>
              <% }); %>
            </select>
          </div>

          <!-- Filtro de Classe -->
          <div class="col-6 col-md-2">
            <select name="class" class="gothic-select">
              <option value="">CLASSE: TODAS</option>
              <% Object.values(constants.CLASSES).forEach(function(cls) { %>
                <option value="<%= cls %>" <%= filters.class === cls ? 'selected' : '' %>><%= cls %></option>
              <% }); %>
            </select>
          </div>

          <!-- Filtro de Raridade -->
          <div class="col-6 col-md-2">
            <select name="rarity" class="gothic-select">
              <option value="">RARIDADE: TODAS</option>
              <% Object.values(constants.RARITIES).forEach(function(rar) { %>
                <option value="<%= rar %>" <%= filters.rarity === rar ? 'selected' : '' %>><%= rar %></option>
              <% }); %>
            </select>
          </div>

          <!-- Botões de Filtragem -->
          <div class="col-6 col-md-2 d-flex gap-1">
            <button type="submit" class="gothic-card-btn py-1" style="font-size: 0.72rem;">
              <span class="material-symbols-outlined" style="font-size: 15px;">filter_alt</span> FILTRAR
            </button>
            <% if (filters.search || filters.element || filters.class || filters.rarity) { %>
              <a href="/characters" class="gothic-card-btn secondary py-1 px-2" title="Limpar Filtros" style="width: auto;">
                <span class="material-symbols-outlined" style="font-size: 15px;">close</span>
              </a>
            <% } %>
          </div>
        </form>
      </section>

      <!-- 4. Grid de Cards dos Heróis no Estilo da Referência -->
      <% if (characters && characters.length > 0) { %>
        <section class="gothic-hero-grid">
          <% characters.forEach(function(c) { %>
            <% const isUnlocked = unlockedIds.has(c.id); %>
            <% const isMain = mainCharacterId === c.id; %>
            <% const heroImagePath = getHeroLocalImage(c.name, c.id); %>

            <article class="gothic-hero-card">
              <!-- Retrato do Herói com Imagem Real -->
              <div class="gothic-card-portrait">
                <img 
                  src="<%= heroImagePath %>" 
                  alt="<%= c.name %>" 
                  class="gothic-card-portrait-img" 
                  onerror="this.onerror=null; this.src='/images/character/<%= c.id %>'; if(this.src.endsWith('/default-avatar.png')) this.src='/images/default-avatar.png';"
                >

                <!-- Tag de Status de Posse -->
                <div class="gothic-status-tag <%= isMain ? 'main' : (isUnlocked ? 'unlocked' : 'locked') %>">
                  <%= isMain ? 'TITULAR' : (isUnlocked ? 'DESBLOQUEADO' : 'BLOQUEADO') %>
                </div>

                <!-- Poder de Combate -->
                <div class="gothic-card-power-pill">
                  <span><%= c.power_rating %> PWR</span>
                </div>
              </div>

              <!-- Informações Textuais e Elemento -->
              <div class="gothic-card-body">
                <h3 class="gothic-card-title" title="<%= c.name %>"><%= c.name %></h3>

                <!-- Linha com Ícone Real do Elemento e Classe -->
                <div class="gothic-card-meta">
                  <div class="gothic-elem-badge">
                    <img 
                      src="/images/icons/<%= c.element.toLowerCase() %>.png" 
                      alt="<%= c.element %>" 
                      class="gothic-elem-icon"
                      onerror="this.style.display='none'"
                    >
                    <span><%= c.element %></span>
                  </div>
                  <span class="gothic-class-badge"><%= c.class %> &bull; <%= c.rarity %></span>
                </div>

                <!-- Os 4 Valores Dourados com Ícones (HP, ATK, DEF, SPD) -->
                <div class="gothic-card-stats-row">
                  <div>
                    <div class="gothic-mini-gold-number"><%= c.base_hp %></div>
                    <span class="material-symbols-outlined gothic-mini-stat-icon text-danger">favorite</span>
                  </div>
                  <div>
                    <div class="gothic-mini-gold-number"><%= c.attack %></div>
                    <span class="material-symbols-outlined gothic-mini-stat-icon text-danger">swords</span>
                  </div>
                  <div>
                    <div class="gothic-mini-gold-number"><%= c.defense %></div>
                    <span class="material-symbols-outlined gothic-mini-stat-icon text-info">shield</span>
                  </div>
                  <div>
                    <div class="gothic-mini-gold-number"><%= c.speed %></div>
                    <span class="material-symbols-outlined gothic-mini-stat-icon text-warning">speed</span>
                  </div>
                </div>
              </div>

              <!-- Ações da Ficha Tática -->
              <div class="gothic-card-actions">
                <a href="/characters/<%= c.id %>" class="gothic-card-btn secondary">
                  <span class="material-symbols-outlined" style="font-size: 16px;">menu_book</span> Ficha Técnica
                </a>

                <% if (!isUnlocked) { %>
                  <form action="/characters/<%= c.id %>/unlock" method="POST" class="m-0">
                    <button type="submit" class="gothic-card-btn">
                      <span class="material-symbols-outlined" style="font-size: 16px;">lock_open</span> Desbloquear Herói
                    </button>
                  </form>
                <% } else if (!isMain) { %>
                  <form action="/characters/<%= c.id %>/select-main" method="POST" class="m-0">
                    <button type="submit" class="gothic-card-btn" style="border-color: #10b981; color: #10b981;">
                      <span class="material-symbols-outlined" style="font-size: 16px;">verified</span> Equipar como Titular
                    </button>
                  </form>
                <% } else { %>
                  <div class="gothic-card-btn active-main">
                    <span class="material-symbols-outlined" style="font-size: 16px;">verified</span> Titular no QG
                  </div>
                <% } %>
              </div>
            </article>
          <% }); %>
        </section>

        <!-- 5. Paginação Gótica -->
        <% if (pagination.totalPages > 1) { %>
          <div class="gothic-pagination-bar">
            <% if (pagination.currentPage > 1) { %>
              <a class="gothic-page-link" href="/characters?page=<%= pagination.currentPage - 1 %>&search=<%= filters.search %>&element=<%= filters.element %>&class=<%= filters.class %>&rarity=<%= filters.rarity %>">&laquo; ANTERIOR</a>
            <% } %>

            <span class="small font-monospace" style="color: var(--gothic-text-muted);">
              PÁGINA <%= pagination.currentPage %> DE <%= pagination.totalPages %>
            </span>

            <% if (pagination.currentPage < pagination.totalPages) { %>
              <a class="gothic-page-link" href="/characters?page=<%= pagination.currentPage + 1 %>&search=<%= filters.search %>&element=<%= filters.element %>&class=<%= filters.class %>&rarity=<%= filters.rarity %>">PRÓXIMA &raquo;</a>
            <% } %>
          </div>
        <% } %>
      <% } else { %>
        <div class="p-5 text-center text-muted font-monospace small">
          <span class="material-symbols-outlined" style="font-size: 48px; opacity: 0.3; margin-bottom: 12px;">person_off</span>
          <p class="mb-0">Nenhum combatente localizado para os filtros selecionados.</p>
        </div>
      <% } %>
    </div>
  </main>

  <!-- Lógica JavaScript do Tema -->
  <script>
    function applyGothicTheme() {
      const theme = localStorage.getItem('joker_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = theme === 'dark' ? 'DARK' : 'LIGHT';
    }

    function toggleGothicTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('joker_theme', next);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = next === 'dark' ? 'DARK' : 'LIGHT';

      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playUiClick();
      }
    }

    applyGothicTheme();
  </script>

  <!-- Rodapé Oficial -->
  <%- include('../partials/footer') %>
</body>
</html>