<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <%- include('../partials/head') %>

  <!-- Google Fonts: Plus Jakarta Sans, Outfit & Cinzel (Tipografia Gótica / Dark Fantasy) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Google Material Symbols Oficial (Sem Emojis) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Biblioteca SweetAlert2 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    /* ==========================================================================
       JOKER RPG — QUARTEL-GENERAL / DASHBOARD DARK FANTASY (DESIGN CHAPADO)
       Molduras de Ferro Forjado, Ouro Incandescente e Cards com Imagens Reais
       ========================================================================== */

    :root[data-theme="dark"] {
      --gothic-bg: #090404;
      --gothic-frame-bg: #140707;
      --gothic-panel: #0d0404;
      --gothic-panel-card: linear-gradient(180deg, #180808 0%, #0d0303 100%);
      --gothic-border-outer: #381010;
      --gothic-border-gold: #b38b4d;
      --gothic-border-gold-glow: rgba(179, 139, 77, 0.45);
      --gothic-filigree: #8a6530;
      --gothic-text: #eae0d5;
      --gothic-text-gold: #d4af37;
      --gothic-text-muted: #8e7a6d;
      --gothic-red-glow: rgba(220, 38, 38, 0.7);
      --gothic-slot-bg: #190505;
      --gothic-slot-border: #4a1515;
      --gothic-hotbar-bg: #100505;
    }

    :root[data-theme="light"] {
      --gothic-bg: #ece6dc;
      --gothic-frame-bg: #dcd3c3;
      --gothic-panel: #f4eee2;
      --gothic-panel-card: linear-gradient(180deg, #ffffff 0%, #f1e9dc 100%);
      --gothic-border-outer: #8a6e55;
      --gothic-border-gold: #966f2d;
      --gothic-border-gold-glow: rgba(150, 111, 45, 0.3);
      --gothic-filigree: #78531e;
      --gothic-text: #261c14;
      --gothic-text-gold: #825a17;
      --gothic-text-muted: #6e5a4c;
      --gothic-red-glow: rgba(185, 28, 28, 0.4);
      --gothic-slot-bg: #e2d7c5;
      --gothic-slot-border: #9c846e;
      --gothic-hotbar-bg: #cfc2ad;
    }

    body {
      background: var(--gothic-bg) !important;
      color: var(--gothic-text);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      margin: 0;
      padding: 0;
      transition: background-color 0.25s ease, color 0.25s ease;
      user-select: none;
    }

    .material-symbols-outlined {
      font-family: 'Material Symbols Outlined';
      font-weight: 500;
      font-size: 20px;
      line-height: 1;
      display: inline-block;
      vertical-align: middle;
    }

    .gothic-dashboard-wrapper {
      max-width: 1440px;
      margin: 20px auto 50px auto;
      padding: 0 16px;
    }

    /* Moldura Principal de Pedra de Ferro */
    .gothic-main-frame {
      background: var(--gothic-frame-bg);
      border: 4px solid var(--gothic-border-outer);
      border-radius: 4px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.95), inset 0 0 30px rgba(0, 0, 0, 0.8);
      position: relative;
      padding: 8px;
    }

    /* Cantoneiras Metálicas Ornamentais */
    .gothic-corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border: 2.5px solid var(--gothic-border-gold);
      z-index: 10;
      pointer-events: none;
    }
    .gothic-corner.top-left { top: 2px; left: 2px; border-right: none; border-bottom: none; }
    .gothic-corner.top-right { top: 2px; right: 2px; border-left: none; border-bottom: none; }
    .gothic-corner.bottom-left { bottom: 2px; left: 2px; border-right: none; border-top: none; }
    .gothic-corner.bottom-right { bottom: 2px; right: 2px; border-left: none; border-top: none; }

    /* Barra Superior de Abas */
    .gothic-nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #2d0b0b;
      background: #090202;
      padding: 6px 16px;
    }

    .gothic-tabs-group {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .gothic-tab-link {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.92rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #634f47;
      text-decoration: none;
      padding: 6px 12px;
      position: relative;
      transition: all 0.2s ease;
    }

    .gothic-tab-link:hover {
      color: #b58d60;
    }

    .gothic-tab-link.active {
      color: #ffffff;
      text-shadow: 0 0 10px var(--gothic-red-glow), 0 0 20px rgba(255, 30, 0, 0.8);
    }

    .gothic-tab-link.active::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent 0%, #ff3b30 50%, transparent 100%);
      box-shadow: 0 0 8px #ff3b30;
    }

    .gothic-theme-toggle-btn {
      background: transparent;
      border: 1px solid var(--gothic-filigree);
      color: var(--gothic-text-gold);
      padding: 4px 10px;
      border-radius: 2px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Cinzel', serif;
      font-size: 0.74rem;
      transition: all 0.15s ease;
    }

    .gothic-theme-toggle-btn:hover {
      box-shadow: 0 0 8px var(--gothic-border-gold-glow);
    }

    /* Cabeçalho de Status: Nível, Brasão Central e XP */
    .gothic-status-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 2px solid #2d0b0b;
      position: relative;
      flex-wrap: wrap;
      gap: 16px;
    }

    .gothic-level-block {
      text-align: left;
    }

    .gothic-level-number {
      font-family: 'Cinzel', serif;
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--gothic-text);
      line-height: 1;
      margin: 0;
    }

    .gothic-class-title {
      font-family: 'Cinzel', serif;
      font-size: 0.75rem;
      letter-spacing: 2px;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
      margin-top: 4px;
    }

    .gothic-emblem-medallion {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: radial-gradient(circle, #2e0909 0%, #0d0202 100%);
      border: 2px solid #5a1818;
      box-shadow: inset 0 0 10px #000, 0 0 15px rgba(220, 38, 38, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .gothic-xp-box {
      text-align: right;
      width: 260px;
    }

    .gothic-xp-track {
      height: 14px;
      background: #110505;
      border: 1.5px solid var(--gothic-border-gold);
      border-radius: 2px;
      position: relative;
      overflow: hidden;
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.9);
      margin-bottom: 4px;
    }

    .gothic-xp-fill {
      height: 100%;
      background: linear-gradient(90deg, #990000 0%, #ff2a2a 70%, #ff6666 100%);
      box-shadow: 0 0 10px rgba(255, 42, 42, 0.8);
      transition: width 0.4s ease;
    }

    .gothic-xp-label {
      font-family: 'Cinzel', serif;
      font-size: 0.7rem;
      letter-spacing: 1px;
      color: var(--gothic-text-muted);
      text-transform: uppercase;
    }

    /* Banner CTA da Arena de Combate */
    .gothic-arena-banner {
      background: linear-gradient(90deg, #3d0707 0%, #170404 60%, #290606 100%);
      border: 2px solid #751a1a;
      box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.8), 0 4px 15px rgba(220, 38, 38, 0.3);
      padding: 18px 24px;
      margin: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    .gothic-btn-cta {
      font-family: 'Cinzel', serif;
      font-weight: 800;
      font-size: 1rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      padding: 10px 28px;
      border-radius: 2px;
      border: 1px solid var(--gothic-border-gold);
      background: linear-gradient(180deg, #6c1c1c 0%, #2e0909 100%);
      color: #ffffff;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 0 15px rgba(220, 38, 38, 0.5);
      transition: all 0.2s ease;
    }

    .gothic-btn-cta:hover {
      background: linear-gradient(180deg, #991b1b 0%, #450a0a 100%);
      border-color: #ffaa00;
      color: #ffdd44;
      transform: scale(1.03);
      box-shadow: 0 0 25px rgba(220, 38, 38, 0.8);
    }

    /* Grid do Conteúdo Central */
    .gothic-dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      padding: 0 14px 14px 14px;
    }

    /* Painel do Herói Titular */
    .gothic-panel-box {
      background: var(--gothic-panel);
      border: 2px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.85);
      padding: 18px 20px;
      position: relative;
    }

    .gothic-panel-title {
      font-family: 'Cinzel', serif;
      font-weight: 800;
      font-size: 0.95rem;
      letter-spacing: 2px;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(179, 139, 77, 0.25);
      padding-bottom: 10px;
      margin-bottom: 14px;
    }

    .gothic-hero-portrait-frame {
      position: relative;
      width: 100%;
      height: 280px;
      background: #000;
      border: 2px solid var(--gothic-border-gold);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
    }

    .gothic-hero-portrait-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      transition: transform 0.4s ease;
    }

    .gothic-hero-portrait-frame:hover .gothic-hero-portrait-img {
      transform: scale(1.04);
    }

    .gothic-elem-pill-real {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      background: #190505;
      border: 1px solid var(--gothic-border-gold);
      border-radius: 2px;
      font-family: 'Cinzel', serif;
      font-size: 0.78rem;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
    }

    .gothic-elem-real-icon {
      width: 16px;
      height: 16px;
      object-fit: contain;
    }

    /* ==========================================================================
       SLOTS DO BARALHO ATIVO COM IMAGENS REAIS (card1.png, card2.png, card3.png)
       ========================================================================== */
    .gothic-deck-slots-row {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 8px;
      margin-bottom: 14px;
    }

    .gothic-slot-mini {
      aspect-ratio: 2 / 3;
      background: #000;
      border: 1.5px solid var(--gothic-border-gold);
      border-radius: 2px;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.7);
      transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
      cursor: pointer;
    }

    .gothic-slot-mini:hover {
      transform: translateY(-4px);
      border-color: #ffaa00;
      box-shadow: 0 0 12px var(--gothic-border-gold-glow);
    }

    /* Imagem Real de Fundo da Carta (card1, card2 ou card3) */
    .slot-mini-card-art {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.75;
      transition: transform 0.3s ease, opacity 0.3s ease;
      z-index: 1;
    }

    .gothic-slot-mini:hover .slot-mini-card-art {
      transform: scale(1.08);
      opacity: 0.92;
    }

    .slot-mini-overlay-data {
      position: relative;
      z-index: 2;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 4px;
      background: linear-gradient(180deg, rgba(10, 2, 2, 0.85) 0%, transparent 40%, rgba(10, 2, 2, 0.95) 85%);
      font-family: var(--font-mono);
      font-size: 0.65rem;
    }

    /* Lista de Missões em Andamento */
    .gothic-quest-row {
      background: rgba(18, 5, 5, 0.8);
      border: 1px solid rgba(179, 139, 77, 0.2);
      padding: 10px 14px;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .gothic-quest-btn-claim {
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      font-weight: 700;
      color: #000;
      background: #d4af37;
      border: 1px solid #b38b4d;
      padding: 3px 8px;
      border-radius: 2px;
      cursor: pointer;
    }

    /* Histórico de Confrontos Telemetria */
    .gothic-battle-row {
      background: rgba(18, 5, 5, 0.8);
      border-left: 3px solid var(--gothic-border-gold);
      padding: 8px 12px;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: var(--font-mono);
      font-size: 0.8rem;
    }

    .gothic-battle-row.win { border-left-color: #10b981; }
    .gothic-battle-row.loss { border-left-color: #ef4444; }

    /* Barra Inferior com Orbe da Facção */
    .gothic-bottom-hotbar {
      background: var(--gothic-hotbar-bg);
      border-top: 2px solid #3d0c0c;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      margin-top: 14px;
    }

    .gothic-orb-assembly {
      position: absolute;
      left: 50%;
      top: -24px;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 25;
    }

    .gothic-orb-sphere {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      box-shadow: 0 0 25px var(--orb-glow), inset 0 -6px 14px rgba(0, 0, 0, 0.8);
      position: relative;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease;
    }

    .gothic-orb-sphere:hover {
      transform: scale(1.08);
    }

    .gothic-orb-sphere.FIRE {
      background: radial-gradient(circle at 35% 30%, #ff7700 0%, #cc1100 50%, #440000 100%);
      --orb-glow: rgba(255, 60, 0, 0.85);
    }
    .gothic-orb-sphere.WATER {
      background: radial-gradient(circle at 35% 30%, #38bdf8 0%, #0284c7 50%, #082f49 100%);
      --orb-glow: rgba(56, 189, 248, 0.85);
    }
    .gothic-orb-sphere.DARK {
      background: radial-gradient(circle at 35% 30%, #c084fc 0%, #7e22ce 50%, #2e1065 100%);
      --orb-glow: rgba(192, 132, 252, 0.85);
    }
    .gothic-orb-sphere.WIND {
      background: radial-gradient(circle at 35% 30%, #34d399 0%, #059669 50%, #022c22 100%);
      --orb-glow: rgba(52, 211, 153, 0.85);
    }
    .gothic-orb-sphere.EARTH {
      background: radial-gradient(circle at 35% 30%, #fbbf24 0%, #b45309 50%, #451a03 100%);
      --orb-glow: rgba(251, 191, 36, 0.85);
    }
    .gothic-orb-sphere.LIGHTNING {
      background: radial-gradient(circle at 35% 30%, #fde047 0%, #eab308 50%, #713f12 100%);
      --orb-glow: rgba(253, 224, 71, 0.85);
    }
    .gothic-orb-sphere.LIGHT {
      background: radial-gradient(circle at 35% 30%, #ffffff 0%, #fef08a 50%, #a16207 100%);
      --orb-glow: rgba(254, 240, 138, 0.95);
    }

    .gothic-orb-element-img {
      width: 32px;
      height: 32px;
      object-fit: contain;
      filter: drop-shadow(0 0 6px #ffffff);
    }

    @media (max-width: 991px) {
      .gothic-dashboard-grid {
        grid-template-columns: 1fr;
      }
      .gothic-deck-slots-row {
        grid-template-columns: repeat(2, 1fr);
      }
      .gothic-orb-assembly {
        position: static;
        transform: none;
        margin: 10px auto;
      }
      .gothic-bottom-hotbar {
        flex-direction: column;
        gap: 20px;
      }
    }
  </style>
</head>
<body>
  <!-- Barra Superior de Navegação -->
  <%- include('../partials/navbar') %>

  <!-- Mapeamento Fiel da Imagem Real do Herói e das Cartas -->
  <%
    function getHeroLocalImage(name, id) {
      if (!name) return `/images/character/${id}`;
      const n = name.toLowerCase();
      let slug = 'default-avatar';
      if (n.includes('kage')) slug = 'kage';
      else if (n.includes('ignis')) slug = 'ignis';
      else if (n.includes('aegis')) slug = 'aegis';
      else if (n.includes('sylph')) slug = 'sylph';
      else if (n.includes('raikou')) slug = 'raikou';
      else if (n.includes('lumina')) slug = 'lumina';
      else if (n.includes('aqua')) slug = 'aqua';
      return `/images/characters/${slug}.png`;
    }

    function getCardDynamicImage(card, index) {
      let num = 1;
      if (card.type === 'ATTACK') num = 1;
      else if (card.type === 'DEFENSE') num = 2;
      else num = 3;
      return `/images/cards/card${num}.png`;
    }

    const heroArtworkPath = getHeroLocalImage(user.main_character_name, user.main_character_id);
    const elementCode = user.main_character_element ? user.main_character_element.toUpperCase() : 'FIRE';
  %>

  <!-- ========================================================================
       JANELA GÓTICA CHAPADA DO QUARTEL-GENERAL (COMMAND CORE)
       ======================================================================== -->
  <main class="gothic-dashboard-wrapper">
    <!-- Alertas Globais -->
    <%- include('../partials/messages') %>

    <div class="gothic-main-frame">
      <!-- Cantoneiras Ornamentais de Ferro e Ouro -->
      <span class="gothic-corner top-left"></span>
      <span class="gothic-corner top-right"></span>
      <span class="gothic-corner bottom-left"></span>
      <span class="gothic-corner bottom-right"></span>

      <!-- 1. Abas Superiores Góticas -->
      <header class="gothic-nav-bar">
        <div class="gothic-tabs-group">
          <a href="/dashboard" class="gothic-tab-link active">COMMAND (QG)</a>
          <a href="/battle" class="gothic-tab-link">ARENA</a>
          <a href="/characters" class="gothic-tab-link">HEROES</a>
          <a href="/decks" class="gothic-tab-link">DECKS</a>
          <a href="/cards" class="gothic-tab-link">CARDS</a>
          <a href="/ranking" class="gothic-tab-link">RANKING</a>
        </div>

        <button type="button" class="gothic-theme-toggle-btn" onclick="toggleGothicTheme()" title="Alternar Modo Claro e Escuro">
          <span class="material-symbols-outlined" style="font-size: 16px;">contrast</span>
          <span id="themeText">DARK</span>
        </button>
      </header>

      <!-- 2. Cabeçalho de Status: Nível do Jogador, Brasão Central e XP -->
      <section class="gothic-status-header">
        <div class="gothic-level-block">
          <h1 class="gothic-level-number"><%= user.level %> LEVEL</h1>
          <div class="gothic-class-title">COMMANDER &bull; <%= user.username %></div>
        </div>

        <!-- Medalhão Central Heraldico com o Elemento do Herói -->
        <div class="gothic-emblem-medallion">
          <span class="material-symbols-outlined" style="font-size: 30px; color: #ff3333; filter: drop-shadow(0 0 6px rgba(255,51,51,0.8));">shield</span>
        </div>

        <!-- Barra de Progresso de Nível e Ouro -->
        <div class="gothic-xp-box">
          <div class="gothic-xp-track" title="Progresso para o próximo nível">
            <div class="gothic-xp-fill" style="width: <%= user.xpProgressPercent %>%;"></div>
          </div>
          <div class="d-flex justify-content-between gothic-xp-label">
            <span>XP: <%= user.xp %> / <%= user.requiredXp %></span>
            <span class="text-warning fw-bold"><%= user.coins %> <span class="material-symbols-outlined" style="font-size: 13px;">monetization_on</span></span>
          </div>
        </div>
      </section>

      <!-- 3. Banner CTA de Duelo na Arena Tática -->
      <section class="gothic-arena-banner">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge" style="background: #ff3333; color: #fff; font-family: 'Cinzel', serif; font-size: 0.68rem;">TEMPORADA ATIVA</span>
            <h2 class="h5 fw-bold font-monospace text-main mb-0" style="font-family: 'Cinzel', serif; letter-spacing: 2px;">ARENA TÁTICA DE DUELOS</h2>
          </div>
          <p class="text-muted small mb-0 font-monospace" style="font-size: 0.8rem;">
            Ruptura de Postura (Break System) &bull; Combos Elementais &bull; Duelos Ranqueados ELO
          </p>
        </div>

        <a href="/battle" class="gothic-btn-cta">
          <span class="material-symbols-outlined">swords</span> ENTRAR NA ARENA
        </a>
      </section>

      <!-- 4. Grid Principal do Quartel-General -->
      <section class="gothic-dashboard-grid">
        
        <!-- COLUNA DA ESQUERDA: HERÓI TITULAR EM DESTAQUE -->
        <div class="gothic-panel-box">
          <div class="gothic-panel-title">
            <span>Herói Titular em Operação</span>
            <a href="/characters" class="small text-decoration-none" style="color: var(--gothic-text-gold); font-size: 0.75rem;">Trocar Herói</a>
          </div>

          <% if (user.main_character_id) { %>
            <div class="gothic-hero-portrait-frame">
              <img 
                src="<%= heroArtworkPath %>" 
                alt="<%= user.main_character_name %>" 
                class="gothic-hero-portrait-img" 
                onerror="this.onerror=null; this.src='/images/character/<%= user.main_character_id %>'; if(this.src.endsWith('/default-avatar.png')) this.src='/images/default-avatar.png';"
              >
            </div>

            <div class="d-flex align-items-center justify-content-between mb-2">
              <h3 class="h6 fw-bold mb-0 font-monospace text-main" style="font-family: 'Cinzel', serif;"><%= user.main_character_name %></h3>
              
              <div class="gothic-elem-pill-real">
                <img 
                  src="/images/icons/<%= user.main_character_element ? user.main_character_element.toLowerCase() : 'fire' %>.png" 
                  alt="<%= user.main_character_element %>" 
                  class="gothic-elem-real-icon"
                  onerror="this.style.display='none'"
                >
                <span><%= user.main_character_element %></span>
              </div>
            </div>

            <div class="d-flex justify-content-between p-2 rounded bg-black border border-secondary border-opacity-25 font-monospace small mb-3">
              <span class="text-dim">CLASSE: <strong class="text-main"><%= user.main_character_class %></strong></span>
              <span class="text-dim">PODER INDEX: <strong class="text-warning"><%= user.power_index %></strong></span>
            </div>

            <a href="/characters/<%= user.main_character_id %>" class="gothic-btn-cta w-100 justify-content-center py-2" style="font-size: 0.8rem;">
              <span class="material-symbols-outlined" style="font-size: 16px;">menu_book</span> Inspecionar Ficha Técnica
            </a>
          <% } else { %>
            <div class="text-center py-5 text-muted font-monospace small">
              <span class="material-symbols-outlined fs-1 text-dim mb-2 d-block">person_off</span>
              Nenhum herói definido como titular.
              <div class="mt-3">
                <a href="/characters" class="gothic-btn-cta py-1 px-3" style="font-size: 0.75rem;">Escolher Combatente</a>
              </div>
            </div>
          <% } %>
        </div>

        <!-- COLUNA DA DIREITA: BARALHO ATIVO COM IMAGENS REAIS, MISSÕES & HISTÓRICO -->
        <div class="d-flex flex-column gap-3">
          
          <!-- Box do Baralho Tático Ativo com Imagens Reais (card1, card2, card3) -->
          <div class="gothic-panel-box">
            <div class="gothic-panel-title">
              <span>Baralho Ativo (<%= activeDeck ? activeDeck.name : 'Nenhum' %>)</span>
              <a href="/decks" class="small text-decoration-none" style="color: var(--gothic-text-gold); font-size: 0.75rem;">Montador</a>
            </div>

            <% if (activeDeck && activeDeck.cards && activeDeck.cards.length > 0) { %>
              <div class="gothic-deck-slots-row">
                <% activeDeck.cards.forEach(function(card, idx) { %>
                  <% const cardImg = getCardDynamicImage(card, idx); %>
                  <div class="gothic-slot-mini" title="<%= card.name %> &bull; <%= card.type %>" onclick="window.location.href='/decks'">
                    <!-- Ilustração Real vinda de /images/cards/card1, card2 ou card3 -->
                    <img 
                      src="<%= cardImg %>" 
                      alt="<%= card.name %>" 
                      class="slot-mini-card-art" 
                      onerror="this.onerror=null; this.src='/images/card/<%= card.id %>'; if(this.src.endsWith('/card-back.png')) this.src='/images/card-back.png';"
                    >

                    <!-- Dados Sobrepostos Táticos -->
                    <div class="slot-mini-overlay-data">
                      <div class="d-flex justify-content-between align-items-center">
                        <span class="text-warning fw-bold">⚡ <%= card.energy_cost %></span>
                        <img src="/images/icons/<%= (card.element || 'fire').toLowerCase() %>.png" alt="<%= card.element %>" style="width: 13px; height: 13px; object-fit: contain;" onerror="this.style.display='none'">
                      </div>
                      
                      <span class="text-truncate fw-bold text-main d-block my-auto text-center" style="font-size: 0.62rem;"><%= card.name %></span>
                      
                      <div class="d-flex justify-content-between text-dim" style="font-size: 0.6rem;">
                        <span class="text-danger fw-bold">⚔ <%= card.damage || 0 %></span>
                        <span class="text-warning fw-bold">💥 <%= card.break_damage || 0 %></span>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
              <div class="d-flex justify-content-between font-monospace small text-dim">
                <span>Slots Preenchidos: <strong class="text-warning"><%= activeDeck.cards.length %>/10</strong></span>
                <span>Cartas na Coleção: <strong class="text-main"><%= totalCardsOwned %></strong></span>
              </div>
            <% } else { %>
              <div class="text-center py-4 text-muted font-monospace small">
                <span class="material-symbols-outlined fs-2 text-dim mb-1 d-block">layers_clear</span>
                Baralho ativo com menos de 10 cartas regulamentares.
                <div class="mt-2">
                  <a href="/decks" class="gothic-btn-cta py-1 px-3" style="font-size: 0.75rem;">Compor Baralho</a>
                </div>
              </div>
            <% } %>
          </div>

          <!-- Box de Missões Ativas -->
          <div class="gothic-panel-box">
            <div class="gothic-panel-title">
              <span>Diretrizes e Missões (<%= missions.totalClaimable %> Resgates)</span>
              <a href="/missions" class="small text-decoration-none" style="color: var(--gothic-text-gold); font-size: 0.75rem;">Ver Todas</a>
            </div>

            <% const previewMissions = [...missions.daily, ...missions.battle].slice(0, 2); %>
            <% if (previewMissions.length > 0) { %>
              <% previewMissions.forEach(function(m) { %>
                <div class="gothic-quest-row">
                  <div>
                    <span class="fw-bold font-monospace d-block small text-main"><%= m.title %></span>
                    <span class="text-dim font-monospace" style="font-size: 0.7rem;"><%= m.current_progress %>/<%= m.requirement_count %> &bull; +<%= m.reward_xp %> XP</span>
                  </div>
                  <% if (m.is_completed && !m.claimed_at) { %>
                    <form action="/missions/<%= m.mission_id %>/claim" method="POST" class="m-0">
                      <button type="submit" class="gothic-quest-btn-claim">Resgatar</button>
                    </form>
                  <% } else { %>
                    <span class="text-dim font-monospace" style="font-size: 0.7rem;"><%= m.is_completed ? 'Concluída' : 'Ativa' %></span>
                  <% } %>
                </div>
              <% }); %>
            <% } else { %>
              <p class="text-muted small font-monospace mb-0">Nenhuma missão em andamento.</p>
            <% } %>
          </div>

          <!-- Box de Status de Ranking e Duelos Recentes -->
          <div class="gothic-panel-box">
            <div class="gothic-panel-title">
              <span>Classificação Oficial</span>
              <a href="/ranking" class="small text-decoration-none" style="color: var(--gothic-text-gold); font-size: 0.75rem;">Quadro de Honra</a>
            </div>

            <div class="d-flex justify-content-between p-2 rounded bg-black border border-secondary border-opacity-25 font-monospace small mb-2">
              <span class="text-dim">POSIÇÃO: <strong class="text-primary fs-6">#<%= ranking.rank_position || 'N/A' %></strong></span>
              <span class="text-dim">RATING: <strong class="text-warning fs-6"><%= ranking.rating || 1000 %> ELO</strong></span>
              <span class="text-dim">CARTEL: <strong class="text-success"><%= ranking.wins || 0 %>V</strong> / <strong class="text-danger"><%= ranking.losses || 0 %>D</strong></span>
            </div>

            <% if (recentBattles && recentBattles.length > 0) { %>
              <% recentBattles.slice(0, 2).forEach(function(b) { %>
                <% const isWin = b.winner_id === user.id; %>
                <div class="gothic-battle-row <%= isWin ? 'win' : 'loss' %>">
                  <span class="fw-bold <%= isWin ? 'text-success' : 'text-danger' %>"><%= isWin ? 'VITÓRIA' : 'DERROTA' %></span>
                  <span class="text-dim"><%= b.mode %></span>
                  <span class="text-muted"><%= b.total_turns %> Turnos</span>
                </div>
              <% }); %>
            <% } %>
          </div>

        </div>

      </section>

      <!-- 5. Barra Inferior Ornamental com Orbe da Facção Central -->
      <footer class="gothic-bottom-hotbar">
        <!-- Ícones de Atalhos Rápidos à Esquerda -->
        <div class="d-flex align-items-center gap-2">
          <a href="/decks" class="gothic-tab-link" title="Baralhos">
            <span class="material-symbols-outlined" style="font-size: 22px;">backpack</span>
          </a>
          <a href="/cards" class="gothic-tab-link" title="Arsenal de Cartas">
            <span class="material-symbols-outlined" style="font-size: 22px;">view_carousel</span>
          </a>
          <a href="/missions" class="gothic-tab-link" title="Quadro de Missões">
            <span class="material-symbols-outlined" style="font-size: 22px;">task_alt</span>
          </a>
        </div>

        <!-- ORBE ELEMENTAL CENTRAL CONFORME A FACÇÃO DO HERÓI TITULAR -->
        <div class="gothic-orb-assembly">
          <div class="gothic-orb-sphere <%= elementCode %>" title="Facção Elemental Titular: <%= user.main_character_element || 'FIRE' %>">
            <img 
              src="/images/icons/<%= user.main_character_element ? user.main_character_element.toLowerCase() : 'fire' %>.png" 
              alt="<%= user.main_character_element %>" 
              class="gothic-orb-element-img"
              onerror="this.style.display='none'"
            >
          </div>
        </div>

        <!-- Ícones de Acesso Rápido à Direita -->
        <div class="d-flex align-items-center gap-2">
          <a href="/ranking" class="gothic-tab-link" title="Classificação">
            <span class="material-symbols-outlined" style="font-size: 22px;">military_tech</span>
          </a>
          <a href="/history" class="gothic-tab-link" title="Histórico de Combate">
            <span class="material-symbols-outlined" style="font-size: 22px;">history</span>
          </a>
          <a href="/profile" class="gothic-tab-link" title="Folha de Perfil">
            <span class="material-symbols-outlined" style="font-size: 22px;">manage_accounts</span>
          </a>
        </div>
      </footer>
    </div>
  </main>

  <!-- Lógica JavaScript do Tema Claro / Escuro -->
  <script>
    function applyGothicTheme() {
      const theme = localStorage.getItem('joker_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = theme === 'dark' ? 'DARK' : 'LIGHT';
    }

    function toggleGothicTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('joker_theme', next);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = next === 'dark' ? 'DARK' : 'LIGHT';

      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playUiClick();
      }
    }

    applyGothicTheme();
  </script>

  <!-- Rodapé Oficial -->
  <%- include('../partials/footer') %>
</body>
</html>