<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <%- include('../partials/head') %>

  <!-- Google Fonts: Plus Jakarta Sans, Outfit & Cinzel (Tipografia Gótica / Dark Fantasy) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Google Material Symbols Oficial (Sem Emojis) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Biblioteca SweetAlert2 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    /* ==========================================================================
       JOKER RPG — ARENA DE COMBATE DARK FANTASY (DESIGN CHAPADO DIABLO / MMO)
       Molduras de Ferro Forjado, Cantoneiras Douradas e Modos de Duelo em Pedra
       ========================================================================== */

    :root[data-theme="dark"] {
      --gothic-bg: #090404;
      --gothic-frame-bg: #140707;
      --gothic-panel: #0d0404;
      --gothic-panel-card: linear-gradient(180deg, #180808 0%, #0d0303 100%);
      --gothic-border-outer: #381010;
      --gothic-border-gold: #b38b4d;
      --gothic-border-gold-glow: rgba(179, 139, 77, 0.45);
      --gothic-filigree: #8a6530;
      --gothic-text: #eae0d5;
      --gothic-text-gold: #d4af37;
      --gothic-text-muted: #8e7a6d;
      --gothic-red-glow: rgba(220, 38, 38, 0.7);
      --gothic-slot-bg: #190505;
      --gothic-slot-border: #4a1515;
      --gothic-hotbar-bg: #100505;
    }

    :root[data-theme="light"] {
      --gothic-bg: #ece6dc;
      --gothic-frame-bg: #dcd3c3;
      --gothic-panel: #f4eee2;
      --gothic-panel-card: linear-gradient(180deg, #ffffff 0%, #f1e9dc 100%);
      --gothic-border-outer: #8a6e55;
      --gothic-border-gold: #966f2d;
      --gothic-border-gold-glow: rgba(150, 111, 45, 0.3);
      --gothic-filigree: #78531e;
      --gothic-text: #261c14;
      --gothic-text-gold: #825a17;
      --gothic-text-muted: #6e5a4c;
      --gothic-red-glow: rgba(185, 28, 28, 0.4);
      --gothic-slot-bg: #e2d7c5;
      --gothic-slot-border: #9c846e;
      --gothic-hotbar-bg: #cfc2ad;
    }

    body {
      background: var(--gothic-bg) !important;
      color: var(--gothic-text);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      margin: 0;
      padding: 0;
      transition: background-color 0.25s ease, color 0.25s ease;
      user-select: none;
    }

    .material-symbols-outlined {
      font-family: 'Material Symbols Outlined';
      font-weight: 500;
      font-size: 20px;
      line-height: 1;
      display: inline-block;
      vertical-align: middle;
    }

    .gothic-arena-wrapper {
      max-width: 1400px;
      margin: 20px auto 50px auto;
      padding: 0 16px;
    }

    /* Moldura Principal de Pedra de Ferro */
    .gothic-main-frame {
      background: var(--gothic-frame-bg);
      border: 4px solid var(--gothic-border-outer);
      border-radius: 4px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.95), inset 0 0 30px rgba(0, 0, 0, 0.8);
      position: relative;
      padding: 8px;
    }

    /* Cantoneiras Metálicas Ornamentais */
    .gothic-corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border: 2.5px solid var(--gothic-border-gold);
      z-index: 10;
      pointer-events: none;
    }
    .gothic-corner.top-left { top: 2px; left: 2px; border-right: none; border-bottom: none; }
    .gothic-corner.top-right { top: 2px; right: 2px; border-left: none; border-bottom: none; }
    .gothic-corner.bottom-left { bottom: 2px; left: 2px; border-right: none; border-top: none; }
    .gothic-corner.bottom-right { bottom: 2px; right: 2px; border-left: none; border-top: none; }

    /* Barra Superior de Abas */
    .gothic-nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #2d0b0b;
      background: #090202;
      padding: 6px 16px;
    }

    .gothic-tabs-group {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .gothic-tab-link {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.92rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #634f47;
      text-decoration: none;
      padding: 6px 12px;
      position: relative;
      transition: all 0.2s ease;
    }

    .gothic-tab-link:hover {
      color: #b58d60;
    }

    .gothic-tab-link.active {
      color: #ffffff;
      text-shadow: 0 0 10px var(--gothic-red-glow), 0 0 20px rgba(255, 30, 0, 0.8);
    }

    .gothic-tab-link.active::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent 0%, #ff3b30 50%, transparent 100%);
      box-shadow: 0 0 8px #ff3b30;
    }

    .gothic-theme-toggle-btn {
      background: transparent;
      border: 1px solid var(--gothic-filigree);
      color: var(--gothic-text-gold);
      padding: 4px 10px;
      border-radius: 2px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Cinzel', serif;
      font-size: 0.74rem;
      transition: all 0.15s ease;
    }

    .gothic-theme-toggle-btn:hover {
      box-shadow: 0 0 8px var(--gothic-border-gold-glow);
    }

    /* Cabeçalho de Status / Visão Geral da Arena */
    .gothic-arena-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 2px solid #2d0b0b;
      position: relative;
      flex-wrap: wrap;
      gap: 16px;
    }

    .gothic-header-title-box {
      text-align: left;
    }

    .gothic-header-main-title {
      font-family: 'Cinzel', serif;
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--gothic-text);
      line-height: 1.1;
      margin: 0;
    }

    .gothic-header-sub {
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      letter-spacing: 2px;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
      margin-top: 4px;
    }

    .gothic-emblem-medallion {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: radial-gradient(circle, #2e0909 0%, #0d0202 100%);
      border: 2px solid #5a1818;
      box-shadow: inset 0 0 10px #000, 0 0 15px rgba(220, 38, 38, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .gothic-stats-summary {
      font-family: 'Cinzel', serif;
      text-align: right;
    }

    .gothic-stats-numbers {
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: 1px;
    }

    /* Faixa de Prontidão Tática */
    .gothic-readiness-banner {
      background: var(--gothic-panel);
      border: 1px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.85);
      padding: 14px 20px;
      margin: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 14px;
    }

    .readiness-indicator {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .readiness-icon {
      font-size: 28px;
    }

    .readiness-icon.ready {
      color: #10b981;
      filter: drop-shadow(0 0 6px rgba(16, 185, 129, 0.6));
    }

    .readiness-icon.unready {
      color: #ef4444;
      filter: drop-shadow(0 0 6px rgba(239, 68, 68, 0.6));
    }

    .readiness-label {
      font-family: 'Cinzel', serif;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin: 0;
    }

    .readiness-sub {
      font-size: 0.76rem;
      color: var(--gothic-text-muted);
      margin: 2px 0 0 0;
    }

    /* Grid dos 3 Modos de Duelo (Cards Góticos Chapados) */
    .gothic-modes-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      padding: 0 14px 14px 14px;
    }

    .gothic-mode-card {
      background: var(--gothic-panel-card);
      border: 2px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.9), 0 8px 24px rgba(0, 0, 0, 0.7);
      border-radius: 2px;
      padding: 22px 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .gothic-mode-card:hover {
      transform: translateY(-4px);
      border-color: #ffaa00;
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.8), 0 12px 30px rgba(0, 0, 0, 0.9), 0 0 16px var(--gothic-border-gold-glow);
    }

    .mode-badge-pill {
      font-family: 'Cinzel', serif;
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 1px;
      padding: 3px 10px;
      border-radius: 2px;
      text-transform: uppercase;
      display: inline-block;
      margin-bottom: 12px;
    }

    .mode-badge-pill.pve {
      background: rgba(6, 182, 212, 0.15);
      border: 1px solid #06b6d4;
      color: #06b6d4;
    }

    .mode-badge-pill.casual {
      background: rgba(245, 158, 11, 0.15);
      border: 1px solid #f59e0b;
      color: #f59e0b;
    }

    .mode-badge-pill.ranked {
      background: rgba(220, 38, 38, 0.2);
      border: 1px solid #ef4444;
      color: #ef4444;
    }

    .mode-title {
      font-family: 'Cinzel', serif;
      font-weight: 800;
      font-size: 1.25rem;
      letter-spacing: 1.5px;
      color: var(--gothic-text);
      margin: 0 0 10px 0;
      line-height: 1.1;
    }

    .mode-desc {
      font-size: 0.82rem;
      color: var(--gothic-text-muted);
      line-height: 1.5;
      margin-bottom: 20px;
      min-height: 60px;
    }

    /* Box de Parâmetros do Modo */
    .mode-specs-box {
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(179, 139, 77, 0.25);
      border-radius: 2px;
      padding: 10px 12px;
      margin-bottom: 16px;
      font-family: 'Cinzel', serif;
      font-size: 0.74rem;
    }

    .mode-spec-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 4px;
    }

    .mode-spec-row:last-child {
      margin-bottom: 0;
    }

    .gothic-btn-launch {
      font-family: 'Cinzel', serif;
      font-weight: 800;
      font-size: 0.85rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 10px 18px;
      border-radius: 2px;
      border: 1px solid var(--gothic-border-gold);
      background: linear-gradient(180deg, #3d1414 0%, #170505 100%);
      color: #ffffff;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.6);
      transition: all 0.15s ease;
      width: 100%;
    }

    .gothic-btn-launch:hover:not(:disabled) {
      background: linear-gradient(180deg, #6c1c1c 0%, #2e0909 100%);
      border-color: #ffaa00;
      color: #ffdd44;
      transform: scale(1.02);
      box-shadow: 0 0 16px rgba(220, 38, 38, 0.6);
    }

    .gothic-btn-launch:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      border-color: var(--gothic-border-outer);
    }

    /* Modal / Overlay de Pareamento em Tempo Real (Gótico) */
    .gothic-mm-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(9, 2, 2, 0.94);
      backdrop-filter: blur(8px);
      z-index: 2000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .gothic-mm-box {
      background: var(--gothic-frame-bg);
      border: 3px solid var(--gothic-border-gold);
      border-radius: 4px;
      max-width: 440px;
      width: 100%;
      padding: 36px 28px;
      text-align: center;
      box-shadow: 0 0 40px rgba(220, 38, 38, 0.4), inset 0 0 20px rgba(0, 0, 0, 0.9);
      position: relative;
    }

    .gothic-radar-pulse {
      width: 80px;
      height: 80px;
      margin: 0 auto 20px auto;
      border: 2px solid var(--gothic-border-gold);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: gothicRadar 1.6s infinite ease-out;
    }

    @keyframes gothicRadar {
      0% {
        transform: scale(0.85);
        box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7);
      }
      70% {
        transform: scale(1.15);
        box-shadow: 0 0 0 24px rgba(220, 38, 38, 0);
      }
      100% {
        transform: scale(0.85);
        box-shadow: 0 0 0 0 rgba(220, 38, 38, 0);
      }
    }

    /* Barra Inferior com Orbe da Facção */
    .gothic-bottom-hotbar {
      background: var(--gothic-hotbar-bg);
      border-top: 2px solid #3d0c0c;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
    }

    .gothic-orb-assembly {
      position: absolute;
      left: 50%;
      top: -24px;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 25;
    }

    .gothic-orb-sphere {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #ff7700 0%, #cc1100 50%, #440000 100%);
      box-shadow: 0 0 25px rgba(255, 60, 0, 0.85), inset 0 -6px 14px rgba(0, 0, 0, 0.8);
      position: relative;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease;
    }

    .gothic-orb-sphere:hover {
      transform: scale(1.08);
    }

    @media (max-width: 991px) {
      .gothic-modes-grid {
        grid-template-columns: 1fr;
      }
      .gothic-orb-assembly {
        position: static;
        transform: none;
        margin: 10px auto;
      }
      .gothic-bottom-hotbar {
        flex-direction: column;
        gap: 16px;
      }
      .gothic-arena-header {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <!-- Barra de Navegação Superior Integrada -->
  <%- include('../partials/navbar') %>

  <!-- ========================================================================
       JANELA GÓTICA CHAPADA DA ARENA (DIABLO / CLASSIC RPG SHELL)
       ======================================================================== -->
  <main class="gothic-arena-wrapper">
    <!-- Alertas Globais -->
    <%- include('../partials/messages') %>

    <div class="gothic-main-frame">
      <!-- Cantoneiras Ornamentais de Ferro e Ouro -->
      <span class="gothic-corner top-left"></span>
      <span class="gothic-corner top-right"></span>
      <span class="gothic-corner bottom-left"></span>
      <span class="gothic-corner bottom-right"></span>

      <!-- 1. Abas Superiores Idênticas à Referência -->
      <header class="gothic-nav-bar">
        <div class="gothic-tabs-group">
          <a href="/battle" class="gothic-tab-link active">ARENA</a>
          <a href="/decks" class="gothic-tab-link">DECKS</a>
          <a href="/characters" class="gothic-tab-link">HEROES</a>
          <a href="/cards" class="gothic-tab-link">CARDS</a>
          <a href="/dashboard" class="gothic-tab-link">COMMAND (QG)</a>
        </div>

        <button type="button" class="gothic-theme-toggle-btn" onclick="toggleGothicTheme()" title="Alternar Modo Claro e Escuro">
          <span class="material-symbols-outlined" style="font-size: 16px;">contrast</span>
          <span id="themeText">DARK</span>
        </button>
      </header>

      <!-- 2. Cabeçalho de Status: Título, Medalhão Central e Cartel -->
      <section class="gothic-arena-header">
        <div class="gothic-header-title-box">
          <h1 class="gothic-header-main-title">Arena Tática de Duelos</h1>
          <div class="gothic-header-sub">Campo de Honra &bull; Resolução Autoritativa</div>
        </div>

        <div class="gothic-emblem-medallion">
          <span class="material-symbols-outlined" style="font-size: 28px; color: #ff3333; filter: drop-shadow(0 0 6px rgba(255,51,51,0.8));">swords</span>
        </div>

        <div class="gothic-stats-summary">
          <div class="gothic-stats-numbers">
            <span class="text-success"><%= stats.wins %>V</span>
            <span style="color: var(--gothic-text-muted);">/</span>
            <span class="text-danger"><%= stats.losses %>D</span>
          </div>
          <div class="small font-monospace" style="color: var(--gothic-text-gold); font-size: 0.68rem;">HISTÓRICO DE COMBATE</div>
        </div>
      </section>

      <!-- 3. Faixa de Prontidão Tática -->
      <section class="gothic-readiness-banner">
        <div class="readiness-indicator">
          <span class="material-symbols-outlined readiness-icon <%= (hasReadyDeck && hasMainCharacter) ? 'ready' : 'unready' %>">
            <%= (hasReadyDeck && hasMainCharacter) ? 'shield_with_heart' : 'gpp_maybe' %>
          </span>
          <div>
            <h2 class="readiness-label <%= (hasReadyDeck && hasMainCharacter) ? 'text-success' : 'text-danger' %>">
              <%= (hasReadyDeck && hasMainCharacter) ? 'Prontidão Confirmada para Combate' : 'Atenção: Arsenal Incompleto' %>
            </h2>
            <p class="readiness-sub">
              <%= (hasReadyDeck && hasMainCharacter) ? 'Herói titular equipado e baralho ativo de 10 cartas pronto para a disputa.' : 'Você precisa de um combatente titular e de um baralho ativo de 10 cartas.' %>
            </p>
          </div>
        </div>

        <div class="d-flex align-items-center gap-3">
          <% if (activeDeck) { %>
            <span class="small font-monospace" style="color: var(--gothic-text-muted);">
              DECK: <strong class="text-main"><%= activeDeck.name %></strong> (<%= activeDeck.cards ? activeDeck.cards.length : 0 %>/10)
            </span>
          <% } %>
          <a href="/decks" class="gothic-btn-launch py-1 px-3" style="width: auto; font-size: 0.72rem;">
            <span class="material-symbols-outlined" style="font-size: 15px;">layers</span> Ajustar Baralho
          </a>
        </div>
      </section>

      <!-- 4. Grid dos 3 Modos de Duelo (Tomes Góticos) -->
      <section class="gothic-modes-grid">
        <!-- Modo 1: PvE Treinamento Solo -->
        <article class="gothic-mode-card">
          <div>
            <span class="mode-badge-pill pve">SOLO / TREINO</span>
            <h3 class="mode-title">Treinamento Tático</h3>
            <p class="mode-desc">
              Enfrente o Autômato de Treinamento em confronto solo sem penalidades no seu Rating. 
              Ideal para testar combinações de cartas, sequências de combo e rupturas de postura (Break).
            </p>

            <div class="mode-specs-box">
              <div class="mode-spec-row">
                <span style="color: var(--gothic-text-muted);">OPONENTE:</span>
                <span class="text-primary fw-bold">Autômato IA</span>
              </div>
              <div class="mode-spec-row">
                <span style="color: var(--gothic-text-muted);">RECOMPENSA:</span>
                <span class="text-success fw-bold">XP Base + Ouro</span>
              </div>
              <div class="mode-spec-row">
                <span style="color: var(--gothic-text-muted);">IMPACTO ELO:</span>
                <span style="color: var(--gothic-text-gold);">Sem Penalidade</span>
              </div>
            </div>
          </div>

          <form action="/battle/create" method="POST" class="m-0">
            <input type="hidden" name="mode" value="PVE_TRAINING">
            <button type="submit" class="gothic-btn-launch" <%= (!hasReadyDeck || !hasMainCharacter) ? 'disabled' : '' %>>
              <span class="material-symbols-outlined">play_arrow</span> Iniciar Treino
            </button>
          </form>
        </article>

        <!-- Modo 2: PvP Duelo Casual -->
        <article class="gothic-mode-card">
          <div>
            <span class="mode-badge-pill casual">ONLINE SÍNCRONO</span>
            <h3 class="mode-title">Duelo Casual 1v1</h3>
            <p class="mode-desc">
              Confronte outros duelistas conectados em tempo real através da rede autoritativa de WebSockets. 
              Focado em avanço de missões diárias e prática competitiva livre.
            </p>

            <div class="mode-specs-box">
              <div class="mode-spec-row">
                <span style="color: var(--gothic-text-muted);">PAREAMENTO:</span>
                <span class="text-warning fw-bold">Disponibilidade</span>
              </div>
              <div class="mode-spec-row">
                <span style="color: var(--gothic-text-muted);">RECOMPENSA:</span>
                <span class="text-success fw-bold">XP Normal + Ouro</span>
              </div>
              <div class="mode-spec-row">
                <span style="color: var(--gothic-text-muted);">MISSÕES:</span>
                <span style="color: #10b981;">Progresso Ativo</span>
              </div>
            </div>
          </div>

          <button type="button" class="gothic-btn-launch" onclick="startGothicMatchmaking('PVP_CASUAL')" <%= (!hasReadyDeck || !hasMainCharacter) ? 'disabled' : '' %>>
            <span class="material-symbols-outlined">radar</span> Buscar Duelo Casual
          </button>
        </article>

        <!-- Modo 3: PvP Arena Ranqueada -->
        <article class="gothic-mode-card">
          <div>
            <span class="mode-badge-pill ranked">COMPETITIVO OFICIAL</span>
            <h3 class="mode-title">Arena Ranqueada ELO</h3>
            <p class="mode-desc">
              Disputa oficial valendo pontuação de classificação no Quadro de Honra da temporada. 
              Vitórias elevam sua posição global e concedem multiplicadores altos de recompensa.
            </p>

            <div class="mode-specs-box">
              <div class="mode-spec-row">
                <span style="color: var(--gothic-text-muted);">APOSTA ELO:</span>
                <span class="text-danger fw-bold">&plusmn;20 a 25 Pontos</span>
              </div>
              <div class="mode-spec-row">
                <span style="color: var(--gothic-text-muted);">RECOMPENSA:</span>
                <span class="text-success fw-bold">+50% XP & Moedas</span>
              </div>
              <div class="mode-spec-row">
                <span style="color: var(--gothic-text-muted);">TEMPORADA:</span>
                <span style="color: var(--gothic-text-gold);">Oficial Vigente</span>
              </div>
            </div>
          </div>

          <button type="button" class="gothic-btn-launch" style="border-color: #ef4444; color: #ff6666;" onclick="startGothicMatchmaking('PVP_RANKED')" <%= (!hasReadyDeck || !hasMainCharacter) ? 'disabled' : '' %>>
            <span class="material-symbols-outlined">military_tech</span> Fila Ranqueada
          </button>
        </article>
      </section>

      <!-- 5. Barra Inferior com Orbe da Facção -->
      <footer class="gothic-bottom-hotbar">
        <div class="d-flex align-items-center gap-2">
          <a href="/characters" class="gothic-tab-link" title="Heróis">
            <span class="material-symbols-outlined" style="font-size: 22px;">sports_martial_arts</span>
          </a>
          <a href="/decks" class="gothic-tab-link" title="Baralhos">
            <span class="material-symbols-outlined" style="font-size: 22px;">backpack</span>
          </a>
          <a href="/missions" class="gothic-tab-link" title="Missões">
            <span class="material-symbols-outlined" style="font-size: 22px;">task_alt</span>
          </a>
        </div>

        <!-- ORBE ELEMENTAL CENTRAL -->
        <div class="gothic-orb-assembly">
          <div class="gothic-orb-sphere" title="Arena de Combate">
            <span class="material-symbols-outlined text-white" style="font-size: 32px; filter: drop-shadow(0 0 8px #ffffff);">swords</span>
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/ranking" class="gothic-tab-link" title="Classificação">
            <span class="material-symbols-outlined" style="font-size: 22px;">military_tech</span>
          </a>
          <a href="/history" class="gothic-tab-link" title="Histórico de Combate">
            <span class="material-symbols-outlined" style="font-size: 22px;">history</span>
          </a>
          <a href="/dashboard" class="gothic-tab-link" title="Quartel-General">
            <span class="material-symbols-outlined" style="font-size: 22px;">dashboard</span>
          </a>
        </div>
      </footer>
    </div>
  </main>

  <!-- ========================================================================
       MODAL / OVERLAY DE PAREAMENTO EM TEMPO REAL VIA SOCKET.IO
       ======================================================================== -->
  <div class="gothic-mm-overlay" id="matchmakingOverlay">
    <div class="gothic-mm-box">
      <div class="gothic-radar-pulse">
        <span class="material-symbols-outlined text-danger fs-1">crosshair</span>
      </div>
      <h3 class="h5 fw-bold text-main font-monospace mb-1" id="mmStatusTitle" style="font-family: 'Cinzel', serif; letter-spacing: 2px;">Buscando Oponente</h3>
      <p class="text-muted small mb-3" id="mmStatusDesc">Sintonizando frequências na rede de duelo...</p>

      <div class="font-monospace text-warning fs-3 fw-bold mb-4" id="mmTimer">00:00</div>

      <button type="button" class="gothic-btn-launch py-2" onclick="cancelGothicMatchmaking()">
        <span class="material-symbols-outlined">cancel</span> Cancelar Busca
      </button>
    </div>
  </div>

  <!-- Lógica JavaScript: Tema, Áudio e Matchmaking Socket.IO -->
  <script>
    // 1. Motor de Alternância de Tema Claro e Escuro
    function applyGothicTheme() {
      const theme = localStorage.getItem('joker_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = theme === 'dark' ? 'DARK' : 'LIGHT';
    }

    function toggleGothicTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('joker_theme', next);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = next === 'dark' ? 'DARK' : 'LIGHT';

      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playUiClick();
      }
    }

    applyGothicTheme();

    // 2. Motor de Matchmaking PvP em Tempo Real
    let socket = null;
    let mmInterval = null;
    let mmSeconds = 0;

    function initGothicSocket() {
      if (!socket && typeof io !== 'undefined') {
        socket = io({
          transports: ['websocket', 'polling'],
          withCredentials: true
        });

        socket.on('pvp:queue_entered', (data) => {
          document.getElementById('mmStatusDesc').textContent = data.message || 'Aguardando oponente compatível...';
        });

        socket.on('battle:started', (data) => {
          if (data && data.battleId) {
            if (window.Joker && window.Joker.Audio) {
              window.Joker.Audio.playCritical();
            }
            clearInterval(mmInterval);
            document.getElementById('mmStatusTitle').textContent = 'Oponente Localizado!';
            document.getElementById('mmStatusDesc').textContent = 'Conectando ao campo de duelo...';
            setTimeout(() => {
              window.location.href = `/battle/room/${data.battleId}`;
            }, 600);
          }
        });

        socket.on('battle:error', (data) => {
          Swal.fire({
            title: 'Erro na Arena',
            text: data.message || 'Falha na conexão de combate.',
            icon: 'error',
            confirmButtonColor: '#781c2f',
            background: '#140707',
            color: '#eae0d5'
          });
          cancelGothicMatchmaking();
        });
      }
    }

    function startGothicMatchmaking(mode) {
      initGothicSocket();
      if (!socket) return;

      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playAttack();
      }

      mmSeconds = 0;
      document.getElementById('mmTimer').textContent = '00:00';
      document.getElementById('matchmakingOverlay').style.display = 'flex';

      mmInterval = setInterval(() => {
        mmSeconds++;
        const mins = String(Math.floor(mmSeconds / 60)).padStart(2, '0');
        const secs = String(mmSeconds % 60).padStart(2, '0');
        document.getElementById('mmTimer').textContent = `${mins}:${secs}`;
      }, 1000);

      socket.emit('pvp:join_queue', { mode });
    }

    function cancelGothicMatchmaking() {
      clearInterval(mmInterval);
      document.getElementById('matchmakingOverlay').style.display = 'none';

      if (socket) {
        socket.emit('pvp:leave_queue');
      }

      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playUiClick();
      }
    }
  </script>

  <!-- Rodapé Oficial -->
  <%- include('../partials/footer') %>
</body>
</html>