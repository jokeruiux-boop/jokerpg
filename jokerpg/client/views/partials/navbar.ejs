<!-- Google Fonts: Plus Jakarta Sans & Cinzel -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800;900&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

<!-- Google Material Symbols Oficial (Sem Emojis) -->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

<nav class="navbar navbar-expand-lg joker-gothic-navbar p-0">
  <!-- ========================================================================
       NÍVEL 1: BARRA SUPERIOR DE FERRO FORJADO & ABAS GÓTICAS ILUMINADAS
       ======================================================================== -->
  <div class="gothic-nav-core-strip w-100">
    <div class="container-fluid px-3 px-lg-4 d-flex align-items-center justify-content-between flex-wrap">
      
      <!-- LOGO2 MINIATURIZADO — SEM ÍCONE, SEM TEXTO -->
      <a class="gothic-brand-anchor" href="/" aria-label="Joker RPG - Home">
        <img src="/images/logo2.png" alt="JOKER RPG" class="gothic-brand-logo">
      </a>

      <!-- Botão Hambúrguer Mobile -->
      <button class="navbar-toggler gothic-toggler d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#jokerGothicMenu" aria-controls="jokerGothicMenu" aria-expanded="false" aria-label="Menu de Navegação">
        <span class="material-symbols-outlined" style="font-size: 26px;">menu</span>
      </button>

      <!-- Container Central de Navegação (Visibilidade Garantida no Desktop) -->
      <div class="collapse navbar-collapse flex-grow-1" id="jokerGothicMenu">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <ul class="gothic-nav-list me-auto mb-2 mb-lg-0 ms-lg-3" id="gothicNavList">
            <li class="gothic-nav-item">
              <a class="gothic-nav-link" href="/dashboard">
                <span>QG</span>
              </a>
            </li>
            <li class="gothic-nav-item">
              <a class="gothic-nav-link" href="/battle">
                <span>ARENA</span>
              </a>
            </li>
            <li class="gothic-nav-item">
              <a class="gothic-nav-link" href="/characters">
                <span>HERÓIS</span>
              </a>
            </li>
            <li class="gothic-nav-item">
              <a class="gothic-nav-link" href="/cards">
                <span>CARTAS</span>
              </a>
            </li>
            <li class="gothic-nav-item">
              <a class="gothic-nav-link" href="/decks">
                <span>DECKS</span>
              </a>
            </li>
            <li class="gothic-nav-item">
              <a class="gothic-nav-link" href="/missions">
                <span>MISSÕES</span>
              </a>
            </li>
            <li class="gothic-nav-item">
              <a class="gothic-nav-link" href="/ranking">
                <span>RANKING</span>
              </a>
            </li>
            <li class="gothic-nav-item">
              <a class="gothic-nav-link" href="/history">
                <span>HISTÓRICO</span>
              </a>
            </li>
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
              <li class="gothic-nav-item">
                <a class="gothic-nav-link admin-gold-link" href="/admin">
                  <span>ADMIN</span>
                </a>
              </li>
            <% } %>
          </ul>

          <!-- Medalhões Metálicos de Moedas, Nível e Perfil -->
          <div class="d-flex align-items-center gap-3 ms-lg-auto py-2 py-lg-0">
            <!-- Moedas de Ouro em Medalhão Heraldico -->
            <div class="gothic-coin-medallion" title="Moedas de Ouro">
              <span class="material-symbols-outlined text-warning" style="font-size: 18px;">monetization_on</span>
              <span class="gothic-stat-number text-warning"><%= currentUser.coins || 0 %></span>
            </div>

            <!-- Nível e Poder -->
            <div class="d-none d-md-flex align-items-center gap-2 font-monospace">
              <div class="gothic-stat-circle" title="Nível de Conta">
                <span>LV<%= currentUser.level || 1 %></span>
              </div>
              <div class="gothic-stat-circle power" title="Poder Ponderado">
                <span class="text-primary"><%= currentUser.power_index || 0 %>P</span>
              </div>
            </div>

            <!-- Avatar e Menu Suspenso do Jogador -->
            <div class="dropdown">
              <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle gothic-avatar-anchor" id="gothicUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="/images/avatar/<%= currentUser.id %>" alt="<%= currentUser.username %>" class="gothic-user-thumb" onerror="this.src='/images/default-avatar.png'">
                <span class="d-none d-sm-inline ms-2 gothic-user-name text-truncate"><%= currentUser.username %></span>
              </a>
              <ul class="dropdown-menu dropdown-menu-end gothic-dropdown-menu" aria-labelledby="gothicUserDropdown">
                <li><h6 class="dropdown-header font-monospace text-uppercase" style="color: #b38b4d;">Ficha do Duelista</h6></li>
                <li>
                  <a class="dropdown-item gothic-dropdown-item" href="/profile">
                    <span class="material-symbols-outlined me-2 fs-6 text-primary">manage_accounts</span> Folha de Perfil
                  </a>
                </li>
                <li>
                  <a class="dropdown-item gothic-dropdown-item" href="/decks">
                    <span class="material-symbols-outlined me-2 fs-6 text-warning">backpack</span> Meus Baralhos
                  </a>
                </li>
                <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                <li>
                  <form action="/auth/logout" method="POST" class="m-0">
                    <button type="submit" class="dropdown-item gothic-dropdown-item text-danger">
                      <span class="material-symbols-outlined me-2 fs-6">power_settings_new</span> Desconectar
                    </button>
                  </form>
                </li>
              </ul>
            </div>
          </div>
        <% } else { %>
          <!-- Visitantes Não Autenticados -->
          <div class="d-flex align-items-center gap-2 ms-auto mt-2 mt-lg-0">
            <a href="/auth/login" class="gothic-auth-btn">
              <span class="material-symbols-outlined fs-6">login</span> ACESSAR
            </a>
            <a href="/auth/register" class="gothic-auth-btn primary">
              <span class="material-symbols-outlined fs-6">person_add</span> ALISTAR
            </a>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ========================================================================
       NÍVEL 2: SUB-BARRA CARMESIM COM BADGE DE NOTÍCIAS E BUSCA EMBUTIDA
       ======================================================================== -->
  <div class="gothic-crimson-subbar w-100">
    <div class="container-fluid px-3 px-lg-4 d-flex align-items-center justify-content-between">
      
      <!-- Fita de Destaque / Ticker Noticioso -->
      <div class="d-flex align-items-center gap-3 overflow-hidden">
        <div class="gothic-ribbon-badge">
          <span>NOTÍCIAS</span>
        </div>
        <div class="gothic-ticker-text text-truncate">
          <span>⚔ Temporada Ativa &bull; Domine a ruptura de postura (Break System) e dispute o topo do Quadro de Honra.</span>
        </div>
      </div>

      <!-- Campo de Busca Embutido da Referência -->
      <div class="gothic-search-box d-none d-md-flex align-items-center">
        <input type="text" class="gothic-search-input" placeholder="Search..." onkeydown="if(event.key==='Enter') window.location.href='/cards?search=' + encodeURIComponent(this.value)">
        <span class="material-symbols-outlined gothic-search-icon" onclick="const val = this.previousElementSibling.value; if(val) window.location.href='/cards?search=' + encodeURIComponent(val);">search</span>
      </div>

    </div>
  </div>
</nav>

<style>
  /* ========================================================================
     ESTILIZAÇÃO TOTAL AUTOCONTIDA: NAVBAR GÓTICA DARK FANTASY (DIABLO HUD)
     ======================================================================== */

  .joker-gothic-navbar {
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 1050;
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.95);
    display: block !important;
    user-select: none;
  }

  /* Nível Superior: Barra de Ferro Escuro com Bordas em Ouro Forjado */
  .gothic-nav-core-strip {
    background: 
      radial-gradient(ellipse at 50% 0%, rgba(179, 139, 77, 0.15) 0%, transparent 70%),
      linear-gradient(180deg, #160707 0%, #0d0303 50%, #150505 100%);
    border-top: 2px solid #5a1414;
    border-bottom: 2px solid #381010;
    padding: 8px 0;
    position: relative;
    box-shadow: inset 0 1px 0 rgba(212, 175, 55, 0.25);
  }

  .gothic-brand-anchor {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  /* ========================================================================
     LOGO2 MINIATURIZADO — SUBSTITUI O ÍCONE DE ESCUDO E OS TEXTOS
     ======================================================================== */
  .gothic-brand-logo {
    height: 44px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    filter: 
      drop-shadow(0 0 6px rgba(212, 175, 55, 0.9))
      drop-shadow(0 0 16px rgba(179, 139, 77, 0.6))
      drop-shadow(0 0 28px rgba(220, 38, 38, 0.3));
    transition: transform 0.25s ease, filter 0.25s ease;
    display: block;
  }

  .gothic-brand-logo:hover {
    transform: scale(1.06);
    filter: 
      drop-shadow(0 0 10px rgba(255, 215, 100, 1))
      drop-shadow(0 0 22px rgba(212, 175, 55, 0.85))
      drop-shadow(0 0 40px rgba(220, 38, 38, 0.5));
  }

  .gothic-toggler {
    background: #140707;
    border: 1px solid #b38b4d;
    color: #d4af37;
    padding: 4px 8px;
    border-radius: 2px;
  }

  /* ========================================================================
     REGRAS ESTRITAS DE VISIBILIDADE NO DESKTOP
     ======================================================================== */
  @media (min-width: 992px) {
    #jokerGothicMenu.collapse,
    .navbar-expand-lg .navbar-collapse {
      display: flex !important;
      visibility: visible !important;
      opacity: 1 !important;
      height: auto !important;
      flex-basis: auto !important;
    }

    .gothic-nav-list {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      gap: 6px !important;
    }
  }

  /* Lista de Navegação e Abas em Estilo 'CARACTER' da Imagem */
  .gothic-nav-list {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .gothic-nav-item {
    position: relative;
    border-radius: 2px;
    transition: all 0.18s ease;
  }

  .gothic-nav-link {
    display: block;
    padding: 8px 14px;
    font-family: 'Cinzel', serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    color: #8e7a6d !important;
    transition: all 0.18s ease;
    position: relative;
  }

  .gothic-nav-link:hover {
    color: #d4af37 !important;
    text-shadow: 0 0 8px rgba(212, 175, 55, 0.6);
  }

  /* Aba Dinamicamente Ativa (Idêntica à aba CARACTER da referência com brilho vermelho) */
  .gothic-nav-item.active-tab .gothic-nav-link {
    color: #ffffff !important;
    text-shadow: 0 0 10px rgba(220, 38, 38, 0.8), 0 0 20px rgba(255, 30, 0, 0.9);
  }

  .gothic-nav-item.active-tab::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, #ff3b30 50%, transparent 100%);
    box-shadow: 0 0 8px #ff3b30;
  }

  .admin-gold-link {
    color: #ffaa00 !important;
  }

  /* Medalhões Circulares de Status */
  .gothic-coin-medallion {
    background: radial-gradient(circle, #2a0b0b 0%, #100404 100%);
    border: 1.5px solid #b38b4d;
    border-radius: 20px;
    padding: 4px 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    box-shadow: inset 0 0 8px #000, 0 2px 6px rgba(0, 0, 0, 0.8);
  }

  .gothic-stat-number {
    font-family: 'Cinzel', serif;
    font-weight: 800;
    font-size: 0.88rem;
  }

  .gothic-stat-circle {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #190505;
    border: 1.5px solid #b38b4d;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d4af37;
    font-size: 0.72rem;
    box-shadow: inset 0 0 6px #000;
  }

  .gothic-stat-circle.power {
    border-color: #00d2ff;
  }

  .gothic-avatar-anchor {
    padding: 3px 8px;
    background: #150606;
    border: 1.5px solid #b38b4d;
    border-radius: 2px;
    transition: all 0.15s ease;
  }

  .gothic-avatar-anchor:hover {
    border-color: #ffaa00;
    box-shadow: 0 0 10px rgba(179, 139, 77, 0.45);
  }

  .gothic-user-thumb {
    width: 32px;
    height: 32px;
    border-radius: 2px;
    object-fit: cover;
    border: 1px solid #b38b4d;
  }

  .gothic-user-name {
    font-family: 'Cinzel', serif;
    font-size: 0.88rem;
    color: #eae0d5;
    letter-spacing: 1px;
    max-width: 140px;
  }

  .gothic-dropdown-menu {
    background: #120404;
    border: 1.5px solid #b38b4d;
    border-radius: 2px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.95);
  }

  .gothic-dropdown-item {
    color: #eae0d5;
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 1px;
    padding: 8px 16px;
    display: flex;
    align-items: center;
    transition: all 0.15s ease;
  }

  .gothic-dropdown-item:hover {
    background: #2e0909;
    color: #d4af37;
  }

  .gothic-auth-btn {
    font-family: 'Cinzel', serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 6px 14px;
    border-radius: 2px;
    border: 1px solid var(--gothic-border-gold);
    background: linear-gradient(180deg, #3d1414 0%, #170505 100%);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.15s ease;
  }

  .gothic-auth-btn:hover {
    border-color: #ffaa00;
    color: #ffdd44;
  }

  .gothic-auth-btn.primary {
    background: linear-gradient(180deg, #6c1c1c 0%, #2e0909 100%);
    border-color: #ffaa00;
    box-shadow: 0 0 12px rgba(220, 38, 38, 0.5);
  }

  /* Nível 2: Sub-Barra Carmesim com Ticker Noticioso e Busca */
  .gothic-crimson-subbar {
    background: linear-gradient(180deg, #5c0d10 0%, #3a080a 100%);
    border-top: 1px solid #7d171b;
    border-bottom: 2px solid #200405;
    padding: 6px 0;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.7);
  }

  .gothic-ribbon-badge {
    background: #fbf7ee;
    color: #5c0d10;
    font-family: 'Cinzel', serif;
    font-weight: 900;
    font-size: 0.72rem;
    letter-spacing: 1.5px;
    padding: 2px 14px;
    border-radius: 2px;
    clip-path: polygon(8% 0%, 92% 0%, 100% 50%, 92% 100%, 8% 100%, 0% 50%);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
    flex-shrink: 0;
  }

  .gothic-ticker-text {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.86rem;
    font-weight: 600;
    color: #ffd8d8;
    letter-spacing: 0.5px;
  }

  .gothic-search-box {
    background: #250406;
    border: 1px solid #6b1216;
    border-radius: 20px;
    padding: 2px 12px;
    width: 220px;
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.7);
    flex-shrink: 0;
  }

  .gothic-search-input {
    background: transparent;
    border: none;
    color: #ffe6e6;
    font-family: 'Cinzel', serif;
    font-size: 0.78rem;
    letter-spacing: 1px;
    width: 100%;
    outline: none;
  }

  .gothic-search-input::placeholder {
    color: #9f4f52;
  }

  .gothic-search-icon {
    color: #fca5a5;
    font-size: 18px;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .gothic-search-icon:hover {
    color: #ffffff;
  }

  /* Responsividade Mobile */
  @media (max-width: 991.98px) {
    .gothic-nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      margin-top: 12px;
      padding-bottom: 8px;
    }
    .gothic-nav-item {
      width: 100%;
    }
    .gothic-nav-link {
      padding: 8px 12px;
    }
    .gothic-brand-logo {
      height: 36px;
      max-width: 100px;
    }
  }
</style>

<!-- ========================================================================
     MOTOR DE DETECÇÃO AUTOMÁTICA DA ABA ATIVA
     ======================================================================== -->
<script>
  (function () {
    function highlightCurrentActiveTab() {
      const currentPath = window.location.pathname.toLowerCase();
      const navItems = document.querySelectorAll('#gothicNavList .gothic-nav-item');

      navItems.forEach(function (item) {
        const link = item.querySelector('.gothic-nav-link');
        if (!link) return;

        const href = link.getAttribute('href');
        if (!href) return;

        const target = href.toLowerCase();
        let isMatch = false;

        if (target === '/dashboard') {
          isMatch = (currentPath === '/dashboard' || currentPath === '/');
        } else if (target === '/battle') {
          isMatch = currentPath.startsWith('/battle');
        } else if (target === '/characters') {
          isMatch = currentPath.startsWith('/characters');
        } else if (target === '/cards') {
          isMatch = currentPath.startsWith('/cards');
        } else if (target === '/decks') {
          isMatch = currentPath.startsWith('/decks');
        } else if (target === '/missions') {
          isMatch = currentPath.startsWith('/missions');
        } else if (target === '/ranking') {
          isMatch = currentPath.startsWith('/ranking');
        } else if (target === '/history') {
          isMatch = currentPath.startsWith('/history');
        } else if (target === '/admin') {
          isMatch = currentPath.startsWith('/admin');
        }

        if (isMatch) {
          item.classList.add('active-tab');
        } else {
          item.classList.remove('active-tab');
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', highlightCurrentActiveTab);
    } else {
      highlightCurrentActiveTab();
    }
  })();
</script>