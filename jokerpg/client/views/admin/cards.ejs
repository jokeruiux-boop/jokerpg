<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <%- include('../partials/head') %>

  <!-- Google Fonts: Plus Jakarta Sans, Outfit & Cinzel (Tipografia Gótica / Dark Fantasy) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Google Material Symbols Oficial (Sem Emojis) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Biblioteca SweetAlert2 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    /* ==========================================================================
       JOKER RPG — GESTÃO DE CARTAS DARK FANTASY (DESIGN CHAPADO DIABLO / MMO)
       Molduras em Ferro Forjado, Tábua do Arsenal Mestre e Cantoneiras de Ouro
       ========================================================================== */

    :root[data-theme="dark"] {
      --gothic-bg: #090404;
      --gothic-bg-overlay: radial-gradient(circle at 50% 30%, rgba(50, 15, 15, 0.6) 0%, rgba(10, 3, 3, 0.92) 65%, #050101 100%);
      --gothic-frame-bg: #140707;
      --gothic-panel: #0d0404;
      --gothic-panel-card: linear-gradient(180deg, #180808 0%, #0d0303 100%);
      --gothic-border-outer: #381010;
      --gothic-border-gold: #b38b4d;
      --gothic-border-gold-glow: rgba(179, 139, 77, 0.45);
      --gothic-filigree: #8a6530;
      --gothic-text: #eae0d5;
      --gothic-text-gold: #d4af37;
      --gothic-text-muted: #8e7a6d;
      --gothic-red-glow: rgba(220, 38, 38, 0.7);
      --gothic-slot-bg: #190505;
      --gothic-slot-border: #4a1515;
      --gothic-hotbar-bg: #100505;
    }

    :root[data-theme="light"] {
      --gothic-bg: #ece6dc;
      --gothic-bg-overlay: radial-gradient(circle at 50% 30%, rgba(240, 230, 218, 0.75) 0%, rgba(215, 200, 185, 0.9) 65%, #c8bcae 100%);
      --gothic-frame-bg: #dcd3c3;
      --gothic-panel: #f4eee2;
      --gothic-panel-card: linear-gradient(180deg, #ffffff 0%, #f1e9dc 100%);
      --gothic-border-outer: #8a6e55;
      --gothic-border-gold: #966f2d;
      --gothic-border-gold-glow: rgba(150, 111, 45, 0.3);
      --gothic-filigree: #78531e;
      --gothic-text: #261c14;
      --gothic-text-gold: #825a17;
      --gothic-text-muted: #6e5a4c;
      --gothic-red-glow: rgba(185, 28, 28, 0.4);
      --gothic-slot-bg: #e2d7c5;
      --gothic-slot-border: #9c846e;
      --gothic-hotbar-bg: #cfc2ad;
    }

    body {
      background: var(--gothic-bg) !important;
      color: var(--gothic-text);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      margin: 0;
      padding: 0;
      transition: background-color 0.25s ease, color 0.25s ease;
      user-select: none;
      position: relative;
    }

    .material-symbols-outlined {
      font-family: 'Material Symbols Outlined';
      font-weight: 500;
      font-size: 20px;
      line-height: 1;
      display: inline-block;
      vertical-align: middle;
    }

    /* Cenário de Fundo da Arena */
    .gothic-viewport-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-image: var(--gothic-bg-overlay), url('/images/backgrounds/arena-bg.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: 1;
      pointer-events: none;
    }

    .gothic-admin-wrapper {
      position: relative;
      z-index: 10;
      max-width: 1440px;
      margin: 20px auto 50px auto;
      padding: 0 16px;
    }

    /* Moldura Principal de Ferro e Pedra */
    .gothic-main-frame {
      background: var(--gothic-frame-bg);
      border: 4px solid var(--gothic-border-outer);
      border-radius: 4px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.95), inset 0 0 30px rgba(0, 0, 0, 0.85);
      position: relative;
      padding: 8px;
    }

    /* Cantoneiras Metálicas Ornamentais */
    .gothic-corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border: 2.5px solid var(--gothic-border-gold);
      z-index: 10;
      pointer-events: none;
    }
    .gothic-corner.top-left { top: 2px; left: 2px; border-right: none; border-bottom: none; }
    .gothic-corner.top-right { top: 2px; right: 2px; border-left: none; border-bottom: none; }
    .gothic-corner.bottom-left { bottom: 2px; left: 2px; border-right: none; border-top: none; }
    .gothic-corner.bottom-right { bottom: 2px; right: 2px; border-left: none; border-top: none; }

    /* Barra Superior de Abas */
    .gothic-nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #2d0b0b;
      background: #090202;
      padding: 6px 16px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .gothic-tabs-group {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .gothic-tab-link {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.86rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #634f47;
      text-decoration: none;
      padding: 6px 10px;
      position: relative;
      transition: all 0.2s ease;
    }

    .gothic-tab-link:hover {
      color: #b58d60;
    }

    .gothic-tab-link.active {
      color: #ffffff;
      text-shadow: 0 0 10px var(--gothic-red-glow), 0 0 20px rgba(255, 30, 0, 0.8);
    }

    .gothic-tab-link.active::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent 0%, #ff3b30 50%, transparent 100%);
      box-shadow: 0 0 8px #ff3b30;
    }

    .gothic-theme-toggle-btn {
      background: transparent;
      border: 1px solid var(--gothic-filigree);
      color: var(--gothic-text-gold);
      padding: 4px 10px;
      border-radius: 2px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Cinzel', serif;
      font-size: 0.74rem;
      transition: all 0.15s ease;
    }

    /* Cabeçalho de Gestão */
    .gothic-admin-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 2px solid #2d0b0b;
      position: relative;
      flex-wrap: wrap;
      gap: 16px;
    }

    .gothic-header-title-box {
      text-align: left;
    }

    .gothic-header-main-title {
      font-family: 'Cinzel', serif;
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--gothic-text);
      line-height: 1.1;
      margin: 0;
    }

    .gothic-header-sub {
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      letter-spacing: 2px;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
      margin-top: 4px;
    }

    .gothic-emblem-medallion {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: radial-gradient(circle, #2e0909 0%, #0d0202 100%);
      border: 2px solid #5a1818;
      box-shadow: inset 0 0 10px #000, 0 0 15px rgba(220, 38, 38, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Painel de Filtros e Busca Gótico */
    .gothic-filter-strip {
      background: var(--gothic-panel);
      border: 1px solid var(--gothic-border-gold);
      padding: 14px 18px;
      margin: 14px;
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.85);
    }

    .gothic-input, .gothic-select, .gothic-textarea {
      background: var(--gothic-slot-bg);
      border: 1px solid var(--gothic-slot-border);
      color: var(--gothic-text);
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      letter-spacing: 1px;
      padding: 6px 12px;
      border-radius: 2px;
      outline: none;
      width: 100%;
      transition: all 0.15s ease;
    }

    .gothic-input:focus, .gothic-select:focus, .gothic-textarea:focus {
      border-color: var(--gothic-border-gold);
      box-shadow: 0 0 8px var(--gothic-border-gold-glow);
    }

    /* Tabela Gótica de Cartas */
    .gothic-table-container {
      background: var(--gothic-panel);
      border: 2px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.9);
      margin: 0 14px 14px 14px;
      overflow: hidden;
    }

    .gothic-card-table {
      width: 100%;
      border-collapse: collapse;
      margin: 0;
      color: var(--gothic-text);
      font-family: 'Cinzel', serif;
    }

    .gothic-card-table th {
      background: #110404;
      color: var(--gothic-text-gold);
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      padding: 14px 16px;
      border-bottom: 2px solid var(--gothic-border-gold);
    }

    .gothic-card-table td {
      padding: 12px 16px;
      vertical-align: middle;
      border-bottom: 1px solid rgba(179, 139, 77, 0.2);
      font-size: 0.86rem;
      transition: background 0.15s ease;
    }

    .gothic-card-table tr:hover td {
      background: rgba(179, 139, 77, 0.1);
    }

    .card-thumb-gothic {
      width: 36px;
      height: 48px;
      border-radius: 2px;
      object-fit: cover;
      border: 1px solid var(--gothic-border-gold);
      background: #000;
    }

    .elem-table-icon {
      width: 14px;
      height: 14px;
      object-fit: contain;
    }

    .gothic-btn {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.76rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 6px 14px;
      border-radius: 2px;
      border: 1px solid var(--gothic-border-gold);
      background: linear-gradient(180deg, #3d1414 0%, #170505 100%);
      color: #ffffff;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
      transition: all 0.15s ease;
    }

    .gothic-btn:hover {
      background: linear-gradient(180deg, #6c1c1c 0%, #2e0909 100%);
      border-color: #ffaa00;
      color: #ffdd44;
      transform: scale(1.02);
    }

    .gothic-btn.secondary {
      background: transparent;
      border-color: var(--gothic-border-gold);
      color: var(--gothic-text-gold);
    }

    .gothic-btn.secondary:hover {
      background: rgba(179, 139, 77, 0.15);
      color: #ffffff;
    }

    /* Paginação Gótica */
    .gothic-pagination-bar {
      padding: 16px 20px;
      border-top: 2px solid #2d0b0b;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
    }

    .gothic-page-link {
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--gothic-text-gold);
      border: 1px solid var(--gothic-border-gold);
      background: var(--gothic-slot-bg);
      padding: 5px 12px;
      text-decoration: none;
      border-radius: 2px;
      transition: all 0.15s ease;
    }

    .gothic-page-link:hover {
      background: #4a1515;
      color: #ffffff;
    }

    /* Barra Inferior com Orbe */
    .gothic-bottom-hotbar {
      background: var(--gothic-hotbar-bg);
      border-top: 2px solid #3d0c0c;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
    }

    .gothic-orb-assembly {
      position: absolute;
      left: 50%;
      top: -24px;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 25;
    }

    .gothic-orb-sphere {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #ffaa00 0%, #cc7700 50%, #442200 100%);
      box-shadow: 0 0 25px rgba(255, 170, 0, 0.85), inset 0 -6px 14px rgba(0, 0, 0, 0.8);
      position: relative;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease;
    }

    .gothic-orb-sphere:hover {
      transform: scale(1.08);
    }

    @media (max-width: 991px) {
      .gothic-admin-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .gothic-orb-assembly {
        position: static;
        transform: none;
        margin: 10px auto;
      }
      .gothic-bottom-hotbar {
        flex-direction: column;
        gap: 16px;
      }
    }
  </style>
</head>
<body>
  <!-- Fundo Atmosférico Real da Pasta /images/backgrounds/arena-bg.jpg -->
  <div class="gothic-viewport-bg"></div>

  <!-- Barra Superior de Navegação -->
  <%- include('../partials/navbar') %>

  <!-- Mapeamento Fiel das Imagens card1.png, card2.png, card3.png -->
  <%
    function getCardArtByType(type) {
      if (type === 'ATTACK') return '/images/cards/card1.png';
      if (type === 'DEFENSE') return '/images/cards/card2.png';
      return '/images/cards/card3.png';
    }
  %>

  <!-- ========================================================================
       JANELA GÓTICA CHAPADA DE GESTÃO DE CARTAS (ADMIN ARSENAL)
       ======================================================================== -->
  <main class="gothic-admin-wrapper">
    <!-- Alertas Globais -->
    <%- include('../partials/messages') %>

    <div class="gothic-main-frame">
      <!-- Cantoneiras Ornamentais de Ferro e Ouro -->
      <span class="gothic-corner top-left"></span>
      <span class="gothic-corner top-right"></span>
      <span class="gothic-corner bottom-left"></span>
      <span class="gothic-corner bottom-right"></span>

      <!-- 1. Abas Superiores do Admin -->
      <header class="gothic-nav-bar">
        <div class="gothic-tabs-group">
          <a href="/admin/cards" class="gothic-tab-link active">CARTAS (ARSENAL)</a>
          <a href="/admin" class="gothic-tab-link">CONSOLE</a>
          <a href="/admin/users" class="gothic-tab-link">JOGADORES</a>
          <a href="/admin/characters" class="gothic-tab-link">HERÓIS</a>
          <a href="/admin/battles" class="gothic-tab-link">BATALHAS</a>
          <a href="/admin/missions" class="gothic-tab-link">MISSÕES</a>
          <a href="/admin/logs" class="gothic-tab-link">AUDITORIA</a>
        </div>

        <button type="button" class="gothic-theme-toggle-btn" onclick="toggleGothicTheme()" title="Alternar Modo Claro e Escuro">
          <span class="material-symbols-outlined" style="font-size: 16px;">contrast</span>
          <span id="themeText">DARK</span>
        </button>
      </header>

      <!-- 2. Cabeçalho de Gestão de Cartas -->
      <section class="gothic-admin-header">
        <div class="gothic-header-title-box">
          <h1 class="gothic-header-main-title">Catálogo Mestre de Cartas Táticas</h1>
          <div class="gothic-header-sub">Gestão Autoritativa de Manobras &bull; Parâmetros de Dano e Ruptura</div>
        </div>

        <div class="gothic-emblem-medallion">
          <span class="material-symbols-outlined" style="font-size: 28px; color: #ff3333; filter: drop-shadow(0 0 6px rgba(255,51,51,0.8));">style</span>
        </div>

        <button class="gothic-btn" data-bs-toggle="modal" data-bs-target="#createCardModal">
          <span class="material-symbols-outlined" style="font-size: 16px;">add_card</span> Cadastrar Nova Carta
        </button>
      </section>

      <!-- 3. Painel de Busca Gótico -->
      <section class="gothic-filter-strip">
        <form action="/admin/cards" method="GET" class="row g-2 align-items-center">
          <div class="col-12 col-md-8">
            <input 
              type="text" 
              class="gothic-input" 
              name="search" 
              placeholder="BUSCAR CARTA POR NOME OU EFEITO..." 
              value="<%= typeof search !== 'undefined' ? search : '' %>"
            >
          </div>

          <div class="col-12 col-md-4 d-flex gap-1">
            <button type="submit" class="gothic-btn w-100 py-1" style="font-size: 0.72rem;">
              <span class="material-symbols-outlined" style="font-size: 15px;">search</span> LOCALIZAR
            </button>
            <a href="/admin/cards" class="gothic-btn secondary py-1 px-3" title="Limpar Busca" style="width: auto;">
              <span class="material-symbols-outlined" style="font-size: 15px;">close</span>
            </a>
          </div>
        </form>
      </section>

      <!-- 4. Tabela Gótica de Cartas Táticas -->
      <section class="gothic-table-container">
        <% if (cards && cards.length > 0) { %>
          <div class="table-responsive">
            <table class="gothic-card-table">
              <thead>
                <tr>
                  <th>Carta</th>
                  <th class="text-center">Tipo</th>
                  <th class="text-center">Raridade</th>
                  <th class="text-center">Elemento</th>
                  <th class="text-center">Energia</th>
                  <th class="text-center">Dano</th>
                  <th class="text-center">DEF</th>
                  <th class="text-center">Break</th>
                  <th class="text-center">Cooldown</th>
                  <th class="text-end">Ações</th>
                </tr>
              </thead>
              <tbody>
                <% cards.forEach(function(card) { %>
                  <% const cardArt = getCardArtByType(card.type); %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center gap-3">
                        <img 
                          src="<%= cardArt %>" 
                          alt="<%= card.name %>" 
                          class="card-thumb-gothic" 
                          onerror="this.onerror=null; this.src='/images/card/<%= card.id %>'; if(this.src.endsWith('/card-back.png')) this.src='/images/card-back.png';"
                        >
                        <div>
                          <span class="fw-bold text-main d-block font-monospace"><%= card.name %></span>
                          <span class="text-dim small font-monospace" style="font-size: 0.7rem;">Efeito: <%= card.effect_code || 'NONE' %></span>
                        </div>
                      </div>
                    </td>
                    <td class="text-center">
                      <span class="badge" style="background: #190505; border: 1px solid var(--gothic-border-gold); color: var(--gothic-text-gold); font-size: 0.65rem;">
                        <%= card.type %>
                      </span>
                    </td>
                    <td class="text-center">
                      <span class="badge" style="background: #190505; border: 1px solid var(--gothic-border-gold); color: var(--gothic-text-gold); font-size: 0.65rem;">
                        <%= card.rarity %>
                      </span>
                    </td>
                    <td class="text-center">
                      <div class="d-inline-flex align-items-center gap-1 px-2 py-1 rounded" style="background: #190505; border: 1px solid var(--gothic-border-gold); font-size: 0.65rem;">
                        <img src="/images/icons/<%= card.element.toLowerCase() %>.png" alt="<%= card.element %>" class="elem-table-icon" onerror="this.style.display='none'">
                        <span><%= card.element %></span>
                      </div>
                    </td>
                    <td class="text-center font-monospace text-warning fw-bold">
                      ⚡ <%= card.energy_cost %>
                    </td>
                    <td class="text-center font-monospace text-danger fw-bold">
                      <%= card.damage || 0 %>
                    </td>
                    <td class="text-center font-monospace text-info fw-bold">
                      <%= card.defense || 0 %>
                    </td>
                    <td class="text-center font-monospace text-warning fw-bold">
                      <%= card.break_damage || 0 %>
                    </td>
                    <td class="text-center font-monospace text-dim">
                      <%= card.cooldown %>R
                    </td>
                    <td class="text-end">
                      <div class="d-flex justify-content-end gap-2">
                        <button class="gothic-btn secondary py-1 px-2" onclick="openEditModal('<%= card.id %>')" title="Editar Carta">
                          <span class="material-symbols-outlined" style="font-size: 15px;">edit_note</span>
                        </button>
                        <form action="/admin/cards/<%= card.id %>/delete" method="POST" class="m-0" data-confirm="Deseja realmente remover esta carta do catálogo mestre?">
                          <button type="submit" class="gothic-btn secondary py-1 px-2" style="border-color: #990000; color: #ff6666;" title="Excluir Carta">
                            <span class="material-symbols-outlined" style="font-size: 15px;">delete</span>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <!-- Paginação -->
          <% if (pagination.totalPages > 1) { %>
            <div class="gothic-pagination-bar">
              <% if (pagination.currentPage > 1) { %>
                <a class="gothic-page-link" href="/admin/cards?page=<%= pagination.currentPage - 1 %>">&laquo; ANTERIOR</a>
              <% } %>

              <span class="small font-monospace" style="color: var(--gothic-text-muted);">
                PÁGINA <%= pagination.currentPage %> DE <%= pagination.totalPages %>
              </span>

              <% if (pagination.currentPage < pagination.totalPages) { %>
                <a class="gothic-page-link" href="/admin/cards?page=<%= pagination.currentPage + 1 %>">PRÓXIMA &raquo;</a>
              <% } %>
            </div>
          <% } %>
        <% } else { %>
          <div class="p-5 text-center text-muted font-monospace small">
            <span class="material-symbols-outlined" style="font-size: 48px; opacity: 0.3; margin-bottom: 12px;">style</span>
            <p class="mb-0">Nenhuma carta tática registrada no catálogo mestre.</p>
