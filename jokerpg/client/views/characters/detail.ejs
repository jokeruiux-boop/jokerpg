<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <%- include('../partials/head') %>

  <!-- Google Fonts: Plus Jakarta Sans, Outfit & Cinzel (Tipografia Gótica / Dark Fantasy) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Google Material Symbols Oficial (Sem Emojis) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Biblioteca SweetAlert2 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    /* ==========================================================================
       JOKER RPG — FICHA TÉCNICA CLÁSSICA DARK FANTASY (ESTILO DIABLO / MMO)
       Design Chapado Fiel à Referência: Molduras em Pedra, Brasões e Orbe Central
       ========================================================================== */

    :root[data-theme="dark"] {
      --gothic-bg: #090404;
      --gothic-frame-bg: #140707;
      --gothic-panel: #0d0404;
      --gothic-border-outer: #381010;
      --gothic-border-gold: #b38b4d;
      --gothic-border-gold-glow: rgba(179, 139, 77, 0.45);
      --gothic-filigree: #8a6530;
      --gothic-text: #eae0d5;
      --gothic-text-gold: #d4af37;
      --gothic-text-muted: #8e7a6d;
      --gothic-red-glow: rgba(220, 38, 38, 0.7);
      --gothic-slot-bg: #1a0808;
      --gothic-slot-border: #421818;
      --gothic-hotbar-bg: #100505;
    }

    :root[data-theme="light"] {
      --gothic-bg: #ece6dc;
      --gothic-frame-bg: #dcd3c3;
      --gothic-panel: #f4eee2;
      --gothic-border-outer: #8a6e55;
      --gothic-border-gold: #966f2d;
      --gothic-border-gold-glow: rgba(150, 111, 45, 0.3);
      --gothic-filigree: #78531e;
      --gothic-text: #261c14;
      --gothic-text-gold: #825a17;
      --gothic-text-muted: #6e5a4c;
      --gothic-red-glow: rgba(185, 28, 28, 0.4);
      --gothic-slot-bg: #e2d7c5;
      --gothic-slot-border: #9c846e;
      --gothic-hotbar-bg: #cfc2ad;
    }

    body {
      background: var(--gothic-bg) !important;
      color: var(--gothic-text);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      margin: 0;
      padding: 0;
      transition: background-color 0.25s ease, color 0.25s ease;
      user-select: none;
    }

    .material-symbols-outlined {
      font-family: 'Material Symbols Outlined';
      font-weight: 500;
      font-size: 20px;
      line-height: 1;
      display: inline-block;
      vertical-align: middle;
    }

    /* Container Chapado da Janela de Personagem */
    .gothic-window-wrapper {
      max-width: 980px;
      margin: 20px auto 40px auto;
      padding: 0 16px;
    }

    /* Borda Mestre Externa com Textura de Ferro Escuro */
    .gothic-main-frame {
      background: var(--gothic-frame-bg);
      border: 4px solid var(--gothic-border-outer);
      border-radius: 4px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.95), inset 0 0 30px rgba(0, 0, 0, 0.8);
      position: relative;
      padding: 6px;
    }

    /* Cantoneiras Metálicas Ornamentais */
    .gothic-corner {
      position: absolute;
      width: 18px;
      height: 18px;
      border: 2px solid var(--gothic-border-gold);
      z-index: 10;
      pointer-events: none;
    }
    .gothic-corner.top-left { top: 2px; left: 2px; border-right: none; border-bottom: none; }
    .gothic-corner.top-right { top: 2px; right: 2px; border-left: none; border-bottom: none; }
    .gothic-corner.bottom-left { bottom: 2px; left: 2px; border-right: none; border-top: none; }
    .gothic-corner.bottom-right { bottom: 2px; right: 2px; border-left: none; border-top: none; }

    /* ==========================================================================
       1. ABAS SUPERIORES NATIVAS (CARACTER, SKILLS, ARENA, GALERIA)
       ========================================================================== */
    .gothic-nav-tabs-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #2d0b0b;
      background: #090202;
      padding: 4px 14px;
    }

    .gothic-tabs-group {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .gothic-tab-link {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #634f47;
      text-decoration: none;
      padding: 6px 12px;
      position: relative;
      transition: all 0.2s ease;
    }

    .gothic-tab-link:hover {
      color: #b58d60;
    }

    /* Aba Ativa Estilo 'CARACTER' da Imagem */
    .gothic-tab-link.active {
      color: #ffffff;
      text-shadow: 0 0 10px var(--gothic-red-glow), 0 0 20px rgba(255, 30, 0, 0.8);
    }

    .gothic-tab-link.active::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent 0%, #ff3b30 50%, transparent 100%);
      box-shadow: 0 0 8px #ff3b30;
    }

    .gothic-theme-toggle-btn {
      background: transparent;
      border: 1px solid var(--gothic-filigree);
      color: var(--gothic-text-gold);
      padding: 3px 8px;
      border-radius: 2px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 4px;
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      transition: all 0.15s ease;
    }

    .gothic-theme-toggle-btn:hover {
      box-shadow: 0 0 8px var(--gothic-border-gold-glow);
    }

    /* ==========================================================================
       2. FAIXA SUPERIOR DE NÍVEL, MEDALHÃO E BARRA DE PROGRESSÃO
       ========================================================================== */
    .gothic-status-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 2px solid #2d0b0b;
      position: relative;
    }

    .gothic-level-block {
      text-align: left;
    }

    .gothic-level-number {
      font-family: 'Cinzel', serif;
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--gothic-text);
      line-height: 1;
      margin: 0;
    }

    .gothic-class-title {
      font-family: 'Cinzel', serif;
      font-size: 0.75rem;
      letter-spacing: 2px;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
      margin-top: 4px;
    }

    /* Medalhão Central com Brasão */
    .gothic-emblem-medallion {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: radial-gradient(circle, #2e0909 0%, #0d0202 100%);
      border: 2px solid #5a1818;
      box-shadow: inset 0 0 10px #000, 0 0 15px rgba(220, 38, 38, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .gothic-emblem-icon {
      color: #ff3333;
      font-size: 30px;
      filter: drop-shadow(0 0 6px rgba(255, 51, 51, 0.8));
    }

    /* Barra de Progresso Ornamental */
    .gothic-xp-box {
      text-align: right;
      width: 240px;
    }

    .gothic-xp-track {
      height: 14px;
      background: #110505;
      border: 1.5px solid var(--gothic-border-gold);
      border-radius: 2px;
      position: relative;
      overflow: hidden;
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.9);
      margin-bottom: 4px;
    }

    .gothic-xp-fill {
      height: 100%;
      background: linear-gradient(90deg, #990000 0%, #ff2a2a 70%, #ff6666 100%);
      box-shadow: 0 0 10px rgba(255, 42, 42, 0.8);
      transition: width 0.4s ease;
    }

    .gothic-xp-label {
      font-family: 'Cinzel', serif;
      font-size: 0.7rem;
      letter-spacing: 1px;
      color: var(--gothic-text-muted);
      text-transform: uppercase;
    }

    /* ==========================================================================
       3. PALCO DUPLO (PAINEL DE ATRIBUTOS À ESQUERDA & ARTE À DIREITA)
       ========================================================================== */
    .gothic-body-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      padding: 14px;
    }

    /* Painel da Esquerda: Atributos com Moldura Dourada Clássica */
    .gothic-attributes-panel {
      background: var(--gothic-panel);
      border: 2px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.8);
      padding: 18px 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
    }

    .gothic-stat-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 0;
      position: relative;
    }

    .gothic-stat-name {
      font-family: 'Cinzel', serif;
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: 2px;
      color: var(--gothic-text);
      text-transform: uppercase;
    }

    .gothic-stat-value {
      font-family: 'Cinzel', serif;
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: 1px;
      color: var(--gothic-text-gold);
    }

    /* Divisor com Losango Ornamental da Imagem */
    .gothic-divider-line {
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      margin: 2px 0;
    }
    .gothic-divider-line::before,
    .gothic-divider-line::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent 0%, var(--gothic-filigree) 50%, transparent 100%);
    }
    .gothic-divider-line .filigree-glyph {
      color: var(--gothic-border-gold);
      font-size: 0.65rem;
      padding: 0 6px;
    }

    /* Bloco dos 4 Números Dourados com Ícones Circulares Abaixo */
    .gothic-core-stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      text-align: center;
      padding: 14px 0 10px 0;
      border-top: 1px solid rgba(179, 139, 77, 0.25);
      border-bottom: 1px solid rgba(179, 139, 77, 0.25);
      margin-top: 8px;
    }

    .gothic-gold-number {
      font-family: 'Cinzel', serif;
      font-weight: 900;
      font-size: 1.1rem;
      color: #ffcc00;
      text-shadow: 0 0 6px rgba(255, 204, 0, 0.5);
      line-height: 1;
      margin-bottom: 6px;
    }

    .gothic-stat-circle-icon {
      width: 30px;
      height: 30px;
      margin: 0 auto;
      border-radius: 50%;
      background: #190505;
      border: 1px solid var(--gothic-border-gold);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gothic-text-gold);
    }

    .gothic-stat-circle-icon span {
      font-size: 16px;
    }

    /* Três Ícones de Atalho: Awards, Backpack, Spellbook */
    .gothic-shortcuts-row {
      display: flex;
      align-items: center;
      justify-content: space-around;
      padding: 12px 0 6px 0;
    }

    .gothic-shortcut-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-decoration: none;
      color: var(--gothic-text-muted);
      transition: all 0.15s ease;
      cursor: pointer;
    }

    .gothic-shortcut-item:hover {
      color: var(--gothic-text-gold);
      transform: translateY(-2px);
    }

    .gothic-shortcut-icon {
      font-size: 26px;
      margin-bottom: 4px;
      color: var(--gothic-border-gold);
    }

    .gothic-shortcut-label {
      font-family: 'Cinzel', serif;
      font-size: 0.68rem;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* Contador de Moedas de Ouro */
    .gothic-coins-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding-top: 8px;
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 1.05rem;
      color: #ffaa00;
    }

    /* Painel da Direita: Retrato Real da Arqueira / Herói */
    .gothic-portrait-panel {
      background: #000000;
      border: 2px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.95);
      height: 480px;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .gothic-portrait-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      transition: transform 0.4s ease;
    }

    .gothic-portrait-panel:hover .gothic-portrait-image {
      transform: scale(1.03);
    }

    /* Faixa de Informação do Herói sobre a Imagem */
    .gothic-hero-tag-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: linear-gradient(180deg, transparent 0%, rgba(10, 2, 2, 0.95) 85%);
      padding: 16px 14px 10px 14px;
      text-align: center;
    }

    .gothic-hero-name {
      font-family: 'Cinzel', serif;
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: #ffffff;
      text-shadow: 0 0 10px rgba(0, 0, 0, 0.9);
      margin: 0;
    }

    .gothic-hero-meta {
      font-size: 0.75rem;
      color: var(--gothic-text-gold);
      letter-spacing: 1px;
      text-transform: uppercase;
      font-family: 'Cinzel', serif;
    }

    /* ==========================================================================
       4. BARRA DE AÇÃO INFERIOR ESTILO DIABLO COM ORBE ELEMENTAL CENTRAL
       ========================================================================== */
    .gothic-bottom-hotbar {
      background: var(--gothic-hotbar-bg);
      border-top: 2px solid #3d0c0c;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
    }

    .gothic-slots-group {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .gothic-skill-slot {
      width: 44px;
      height: 44px;
      background: var(--gothic-slot-bg);
      border: 1.5px solid var(--gothic-slot-border);
      border-radius: 2px;
      box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.9);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      cursor: pointer;
      transition: all 0.15s ease;
      color: var(--gothic-text-gold);
    }

    .gothic-skill-slot:hover {
      border-color: var(--gothic-border-gold);
      box-shadow: 0 0 10px var(--gothic-border-gold-glow);
      transform: translateY(-2px);
    }

    .gothic-slot-key {
      position: absolute;
      bottom: -16px;
      font-family: 'Cinzel', serif;
      font-size: 0.65rem;
      color: var(--gothic-text-muted);
      font-weight: 700;
    }

    /* ORBE ELEMENTAL CENTRAL QUE SUBSTITUI A CAVEIRA CONFORME O HEROI */
    .gothic-orb-assembly {
      position: absolute;
      left: 50%;
      top: -24px;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 25;
    }

    .gothic-orb-sphere {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      box-shadow: 0 0 25px var(--orb-glow), inset 0 -6px 14px rgba(0, 0, 0, 0.8);
      position: relative;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease;
    }

    .gothic-orb-sphere:hover {
      transform: scale(1.08);
    }

    /* Variações de Cor do Orbe por Elemento */
    .gothic-orb-sphere.FIRE {
      background: radial-gradient(circle at 35% 30%, #ff7700 0%, #cc1100 50%, #440000 100%);
      --orb-glow: rgba(255, 60, 0, 0.85);
    }
    .gothic-orb-sphere.WATER {
      background: radial-gradient(circle at 35% 30%, #38bdf8 0%, #0284c7 50%, #082f49 100%);
      --orb-glow: rgba(56, 189, 248, 0.85);
    }
    .gothic-orb-sphere.DARK {
      background: radial-gradient(circle at 35% 30%, #c084fc 0%, #7e22ce 50%, #2e1065 100%);
      --orb-glow: rgba(192, 132, 252, 0.85);
    }
    .gothic-orb-sphere.WIND {
      background: radial-gradient(circle at 35% 30%, #34d399 0%, #059669 50%, #022c22 100%);
      --orb-glow: rgba(52, 211, 153, 0.85);
    }
    .gothic-orb-sphere.EARTH {
      background: radial-gradient(circle at 35% 30%, #fbbf24 0%, #b45309 50%, #451a03 100%);
      --orb-glow: rgba(251, 191, 36, 0.85);
    }
    .gothic-orb-sphere.LIGHTNING {
      background: radial-gradient(circle at 35% 30%, #fde047 0%, #eab308 50%, #713f12 100%);
      --orb-glow: rgba(253, 224, 71, 0.85);
    }
    .gothic-orb-sphere.LIGHT {
      background: radial-gradient(circle at 35% 30%, #ffffff 0%, #fef08a 50%, #a16207 100%);
      --orb-glow: rgba(254, 240, 138, 0.95);
    }

    .gothic-orb-element-img {
      width: 32px;
      height: 32px;
      object-fit: contain;
      filter: drop-shadow(0 0 6px #ffffff);
    }

    .gothic-orb-pedestal-crest {
      font-size: 26px;
      color: var(--gothic-border-gold);
      margin-top: -6px;
      filter: drop-shadow(0 2px 4px #000);
    }

    /* Painel de Ações e Gestão do Herói */
    .gothic-action-strip {
      padding: 12px 16px;
      background: #080202;
      border-top: 1px solid var(--gothic-border-outer);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

    .gothic-btn {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.85rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 8px 18px;
      border-radius: 2px;
      border: 1px solid var(--gothic-border-gold);
      background: linear-gradient(180deg, #3d1414 0%, #170505 100%);
      color: #ffffff;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.6);
      transition: all 0.15s ease;
    }

    .gothic-btn:hover {
      background: linear-gradient(180deg, #6c1c1c 0%, #2e0909 100%);
      border-color: #ffaa00;
      color: #ffdd44;
      transform: scale(1.02);
    }

    .gothic-btn.active-main {
      border-color: #10b981;
      color: #10b981;
      background: rgba(16, 185, 129, 0.1);
      cursor: default;
    }

    @media (max-width: 768px) {
      .gothic-body-split {
        grid-template-columns: 1fr;
      }
      .gothic-portrait-panel {
        height: 340px;
      }
      .gothic-orb-assembly {
        position: static;
        transform: none;
        margin: 10px 0;
      }
      .gothic-bottom-hotbar {
        flex-direction: column;
        gap: 24px;
      }
      .gothic-xp-box {
        width: 140px;
      }
    }
  </style>
</head>
<body>
  <!-- Barra de Navegação Superior Integrada -->
  <%- include('../partials/navbar') %>

  <!-- Mapeamento Fiel da Arte Real do Personagem -->
  <%
    function getHeroLocalImage(name, id) {
      if (!name) return `/images/character/${id}`;
      const n = name.toLowerCase();
      let slug = 'default-avatar';
      if (n.includes('kage')) slug = 'kage';
      else if (n.includes('ignis')) slug = 'ignis';
      else if (n.includes('aegis')) slug = 'aegis';
      else if (n.includes('sylph')) slug = 'sylph';
      else if (n.includes('raikou')) slug = 'raikou';
      else if (n.includes('lumina')) slug = 'lumina';
      else if (n.includes('aqua')) slug = 'aqua';
      return `/images/characters/${slug}.png`;
    }

    const heroArtworkPath = getHeroLocalImage(character.name, character.id);
    const elementCode = character.element ? character.element.toUpperCase() : 'FIRE';

    const passive = typeof character.passive_ability === 'string' ? JSON.parse(character.passive_ability) : (character.passive_ability || {});
    const active = typeof character.active_ability === 'string' ? JSON.parse(character.active_ability) : (character.active_ability || {});
    const ultimate = typeof character.ultimate_ability === 'string' ? JSON.parse(character.ultimate_ability) : (character.ultimate_ability || {});
  %>

  <!-- ========================================================================
       JANELA GÓTICA CHAPADA DE PERSONAGEM (DIABLO / CLASSIC RPG SHELL)
       ======================================================================== -->
  <main class="gothic-window-wrapper">
    <!-- Alertas Globais -->
    <%- include('../partials/messages') %>

    <div class="gothic-main-frame">
      <!-- Cantoneiras Ornamentais de Ferro e Ouro -->
      <span class="gothic-corner top-left"></span>
      <span class="gothic-corner top-right"></span>
      <span class="gothic-corner bottom-left"></span>
      <span class="gothic-corner bottom-right"></span>

      <!-- 1. Abas Superiores Idênticas à Imagem -->
      <header class="gothic-nav-tabs-bar">
        <div class="gothic-tabs-group">
          <a href="javascript:void(0)" class="gothic-tab-link active">CARACTER</a>
          <a href="javascript:void(0)" class="gothic-tab-link" onclick="openGrimoireModal()">SKILLS</a>
          <a href="/missions" class="gothic-tab-link">QUESTS</a>
          <a href="/characters" class="gothic-tab-link">TEAM</a>
        </div>

        <button type="button" class="gothic-theme-toggle-btn" onclick="toggleGothicTheme()" title="Alternar Modo Claro e Escuro">
          <span class="material-symbols-outlined" style="font-size: 16px;">contrast</span>
          <span id="themeText">DARK</span>
        </button>
      </header>

      <!-- 2. Cabeçalho de Status: Nível, Brasão Central e Barra de XP -->
      <section class="gothic-status-header">
        <!-- Nível e Classe -->
        <div class="gothic-level-block">
          <h1 class="gothic-level-number"><%= userProgress ? userProgress.level : 1 %> LEVEL</h1>
          <div class="gothic-class-title"><%= character.class %> &bull; <%= character.rarity %></div>
        </div>

        <!-- Medalhão Central Heraldico -->
        <div class="gothic-emblem-medallion">
          <span class="material-symbols-outlined gothic-emblem-icon">local_fire_department</span>
        </div>

        <!-- Barra de Progresso de Nível / XP -->
        <div class="gothic-xp-box">
          <div class="gothic-xp-track" title="Power Rating">
            <div class="gothic-xp-fill" style="width: <%= Math.min(100, (character.power_rating / 2000) * 100) %>%;"></div>
          </div>
          <div class="gothic-xp-label">
            POWER: <span class="text-warning fw-bold"><%= character.power_rating %></span>
          </div>
        </div>
      </section>

      <!-- 3. Corpo Duplo Chapado: Atributos à Esquerda & Retrato à Direita -->
      <section class="gothic-body-split">
        
        <!-- PAINEL DA ESQUERDA: ATRIBUTOS BÁSICOS & CONTADORES -->
        <div class="gothic-attributes-panel">
          <!-- Linhas de Atributos com Divisores Ornamentais da Imagem -->
          <div>
            <div class="gothic-stat-row">
              <span class="gothic-stat-name">STRENGTH (ATK)</span>
              <span class="gothic-stat-value"><%= character.attack %></span>
            </div>
            <div class="gothic-divider-line"><span class="filigree-glyph">&#10070;</span></div>

            <div class="gothic-stat-row">
              <span class="gothic-stat-name">DEXTERITY (SPD)</span>
              <span class="gothic-stat-value"><%= character.speed %></span>
            </div>
            <div class="gothic-divider-line"><span class="filigree-glyph">&#10070;</span></div>

            <div class="gothic-stat-row">
              <span class="gothic-stat-name">ENERGY (MANA)</span>
              <span class="gothic-stat-value"><%= character.energy %></span>
            </div>
            <div class="gothic-divider-line"><span class="filigree-glyph">&#10070;</span></div>

            <div class="gothic-stat-row">
              <span class="gothic-stat-name">VITALITY (HP)</span>
              <span class="gothic-stat-value"><%= character.base_hp %></span>
            </div>
          </div>

          <!-- Os 4 Valores Dourados com Ícones Circulares Abaixo (Idêntico à Foto) -->
          <div class="gothic-core-stats-grid">
            <div>
              <div class="gothic-gold-number"><%= character.attack %></div>
              <div class="gothic-stat-circle-icon" title="Poder Ofensivo">
                <span class="material-symbols-outlined">swords</span>
              </div>
            </div>
            <div>
              <div class="gothic-gold-number"><%= character.defense %></div>
              <div class="gothic-stat-circle-icon" title="Defesa / Armadura">
                <span class="material-symbols-outlined">shield</span>
              </div>
            </div>
            <div>
              <div class="gothic-gold-number"><%= character.base_hp %></div>
              <div class="gothic-stat-circle-icon" title="Pontos de Vida">
                <span class="material-symbols-outlined text-danger">favorite</span>
              </div>
            </div>
            <div>
              <div class="gothic-gold-number"><%= character.critical_chance %>%</div>
              <div class="gothic-stat-circle-icon" title="Golpe Crítico">
                <span class="material-symbols-outlined text-warning">crisis_alert</span>
              </div>
            </div>
          </div>

          <!-- Atalhos Visuais: Conquistas, Arsenal e Grimório -->
          <div class="gothic-shortcuts-row">
            <div class="gothic-shortcut-item" onclick="openAwardsModal()">
              <span class="material-symbols-outlined gothic-shortcut-icon">military_tech</span>
              <span class="gothic-shortcut-label">Awards</span>
            </div>
            <a href="/decks" class="gothic-shortcut-item">
              <span class="material-symbols-outlined gothic-shortcut-icon">backpack</span>
              <span class="gothic-shortcut-label">Backpack</span>
            </a>
            <div class="gothic-shortcut-item" onclick="openGrimoireModal()">
              <span class="material-symbols-outlined gothic-shortcut-icon">menu_book</span>
              <span class="gothic-shortcut-label">Spell book</span>
            </div>
          </div>

          <!-- Contador de Moedas de Ouro -->
          <div class="gothic-coins-row">
            <span><%= character.power_rating * 10 %></span>
            <span class="material-symbols-outlined" style="font-size: 20px;">monetization_on</span>
          </div>
        </div>

        <!-- PAINEL DA DIREITA: RETRATO REAL DO HERÓI -->
        <div class="gothic-portrait-panel">
          <img 
            src="<%= heroArtworkPath %>" 
            alt="<%= character.name %>" 
            class="gothic-portrait-image" 
            onerror="this.onerror=null; this.src='/images/character/<%= character.id %>'; if(this.src.endsWith('/default-avatar.png')) this.src='/images/default-avatar.png';"
          >

          <!-- Nome e Informação do Herói na Base da Imagem -->
          <div class="gothic-hero-tag-overlay">
            <h2 class="gothic-hero-name"><%= character.name %></h2>
            <div class="gothic-hero-meta"><%= character.element %> &bull; <%= character.class %></div>
          </div>
        </div>

      </section>

      <!-- 4. Barra de Ação Inferior (Diablo Hotbar) com Orbe da Facção no Centro -->
      <footer class="gothic-bottom-hotbar">
        <!-- Slots de Habilidade da Esquerda (W, S, A, D) -->
        <div class="gothic-slots-group">
          <!-- Passiva -->
          <div class="gothic-skill-slot" onclick="openSkillDetail('PASSIVA', '<%= passive.name || 'Inata' %>', '<%= passive.description || 'Efeito passivo contínuo.' %>')">
            <span class="material-symbols-outlined">auto_fix_high</span>
            <span class="gothic-slot-key">W</span>
          </div>
          <!-- Ativa -->
          <div class="gothic-skill-slot" onclick="openSkillDetail('ATIVA', '<%= active.name || 'Técnica' %>', '<%= active.description || 'Habilidade ativa com recarga.' %>')">
            <span class="material-symbols-outlined">bolt</span>
            <span class="gothic-slot-key">S</span>
          </div>
          <!-- Ultimate -->
          <div class="gothic-skill-slot" onclick="openSkillDetail('ULTIMATE', '<%= ultimate.name || 'Suprema' %>', '<%= ultimate.description || 'Dano devastador e ruptura de postura.' %>')">
            <span class="material-symbols-outlined text-danger">skull</span>
            <span class="gothic-slot-key">A</span>
          </div>
          <!-- Cartas -->
          <a href="/cards" class="gothic-skill-slot text-decoration-none">
            <span class="material-symbols-outlined">view_carousel</span>
            <span class="gothic-slot-key">D</span>
          </a>
        </div>

        <!-- ORBE ELEMENTAL CENTRAL QUE SUBSTITUI A CAVEIRA CONFORME A FACÇÃO/ELEMENTO DO HERÓI -->
        <div class="gothic-orb-assembly">
          <div class="gothic-orb-sphere <%= elementCode %>" title="Facção Elemental: <%= character.element %>">
            <img 
              src="/images/icons/<%= character.element ? character.element.toLowerCase() : 'fire' %>.png" 
              alt="<%= character.element %>" 
              class="gothic-orb-element-img"
              onerror="this.style.display='none'"
            >
          </div>
          <span class="material-symbols-outlined gothic-orb-pedestal-crest">shield</span>
        </div>

        <!-- Slots da Direita (Q, E, 1, 2) -->
        <div class="gothic-slots-group">
          <!-- Vida -->
          <div class="gothic-skill-slot" title="Reserva de HP">
            <span class="material-symbols-outlined text-danger">favorite</span>
            <span class="gothic-slot-key">Q</span>
          </div>
          <!-- Poção Vermelha -->
          <div class="gothic-skill-slot" title="Elixir de Combate">
            <span class="material-symbols-outlined text-danger">vital_signs</span>
            <span class="gothic-slot-key">E</span>
          </div>
          <!-- Poção Azul / Mana -->
          <div class="gothic-skill-slot" title="Elixir de Energia">
            <span class="material-symbols-outlined text-info">science</span>
            <span class="gothic-slot-key">1</span>
          </div>
          <!-- Arena -->
          <a href="/battle" class="gothic-skill-slot text-decoration-none" title="Ir para a Arena">
            <span class="material-symbols-outlined text-warning">swords</span>
            <span class="gothic-slot-key">2</span>
          </a>
        </div>
      </footer>

      <!-- 5. Barra Inferior de Comandos de Gestão da Ficha -->
      <section class="gothic-action-strip">
        <a href="/characters" class="gothic-btn">
          <span class="material-symbols-outlined">arrow_back</span> Galeria
        </a>

        <div class="d-flex align-items-center gap-2">
          <% if (!isUnlocked) { %>
            <form action="/characters/<%= character.id %>/unlock" method="POST" class="m-0" id="gothicUnlockForm">
              <button type="submit" class="gothic-btn">
                <span class="material-symbols-outlined">lock_open</span> Desbloquear Herói
              </button>
            </form>
          <% } else if (!isMain) { %>
            <form action="/characters/<%= character.id %>/select-main" method="POST" class="m-0">
              <button type="submit" class="gothic-btn" style="border-color: #10b981; color: #10b981;">
                <span class="material-symbols-outlined">verified</span> Equipar como Titular
              </button>
            </form>
          <% } else { %>
            <div class="gothic-btn active-main">
              <span class="material-symbols-outlined">verified</span> Titular Ativo no QG
            </div>
          <% } %>

          <a href="/battle" class="gothic-btn" style="border-color: #ff3333; color: #ff6666;">
            <span class="material-symbols-outlined">swords</span> Duelo na Arena
          </a>
        </div>
      </section>
    </div>
  </main>

  <!-- ========================================================================
       MODAIS INTEGRADOS VIA SWEETALERT2 PARA SKILLS E AWARDS
       ======================================================================== -->
  <script>
    // 1. Motor de Alternância de Tema Claro e Escuro
    function applyGothicTheme() {
      const theme = localStorage.getItem('joker_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      document.getElementById('themeText').textContent = theme === 'dark' ? 'DARK' : 'LIGHT';
    }

    function toggleGothicTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('joker_theme', next);
      document.getElementById('themeText').textContent = next === 'dark' ? 'DARK' : 'LIGHT';

      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playUiClick();
      }
    }

    applyGothicTheme();

    // 2. Modal de Detalhe de Habilidade
    function openSkillDetail(type, name, desc) {
      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playCardSelect();
      }

      Swal.fire({
        title: `<span style="font-family: 'Cinzel', serif; letter-spacing: 2px;">${type}: ${name}</span>`,
        html: `
          <div style="font-family: 'Rajdhani', sans-serif; font-size: 1.05rem; line-height: 1.6; text-align: left; padding: 10px;">
            <p style="color: #d4af37; margin-bottom: 8px;"><strong>Efeito da Habilidade:</strong></p>
            <p style="color: #eae0d5;">${desc}</p>
          </div>
        `,
        confirmButtonText: 'Fechar',
        confirmButtonColor: '#781c2f',
        background: '#120505',
        color: '#eae0d5'
      });
    }

    // 3. Modal do Grimório (Spellbook) com as 3 Habilidades Juntas
    function openGrimoireModal() {
      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playCardSelect();
      }

      Swal.fire({
        title: `<span style="font-family: 'Cinzel', serif; letter-spacing: 2px;">Grimório do Combatente</span>`,
        html: `
          <div style="font-family: 'Rajdhani', sans-serif; font-size: 0.95rem; line-height: 1.5; text-align: left; padding: 6px;">
            <div style="margin-bottom: 12px; border-left: 3px solid #10b981; padding-left: 8px;">
              <strong style="color: #10b981;">Passiva: <%= passive.name || 'Inata' %></strong>
              <p style="color: #aaa; margin: 0;"><%= passive.description || 'Efeito permanente ativo em todas as rodadas.' %></p>
            </div>
            <div style="margin-bottom: 12px; border-left: 3px solid #00d2ff; padding-left: 8px;">
              <strong style="color: #00d2ff;">Ativa: <%= active.name || 'Técnica' %></strong>
              <p style="color: #aaa; margin: 0;"><%= active.description || 'Habilidade com tempo de recarga utilizável em combate.' %></p>
            </div>
            <div style="border-left: 3px solid #ef4444; padding-left: 8px;">
              <strong style="color: #ef4444;">Ultimate: <%= ultimate.name || 'Suprema' %></strong>
              <p style="color: #aaa; margin: 0;"><%= ultimate.description || 'Dano devastador e alta quebra de postura.' %></p>
            </div>
          </div>
        `,
        confirmButtonText: 'Fechar Grimório',
        confirmButtonColor: '#b38b4d',
        background: '#140707',
        color: '#eae0d5'
      });
    }

    // 4. Modal de Conquistas (Awards)
    function openAwardsModal() {
      Swal.fire({
        title: `<span style="font-family: 'Cinzel', serif; letter-spacing: 2px;">Insígnias e Prêmios</span>`,
        html: `
          <div style="text-align: center; padding: 10px 0;">
            <p style="color: #d4af37; font-family: 'Cinzel', serif; font-size: 1.1rem; margin-bottom: 6px;">
              Combatente <%= character.rarity %>
            </p>
            <p style="color: #9e8d80; font-size: 0.9rem;">
              Herói forjado sob a afinidade elemental de <strong><%= character.element %></strong> com índice de poder indexado em <strong><%= character.power_rating %></strong>.
            </p>
          </div>
        `,
        confirmButtonText: 'Dispensar',
        confirmButtonColor: '#781c2f',
        background: '#120505',
        color: '#eae0d5'
      });
    }
  </script>

  <!-- Rodapé Oficial -->
  <%- include('../partials/footer') %>
</body>
</html>