  <!-- Lógica JavaScript: Tema e Modal de Edição -->
  <script>
    function applyGothicTheme() {
      const theme = localStorage.getItem('joker_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = theme === 'dark' ? 'DARK' : 'LIGHT';
    }

    function toggleGothicTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('joker_theme', next);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = next === 'dark' ? 'DARK' : 'LIGHT';

      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playUiClick();
      }
    }

    applyGothicTheme();

    const cardsData = <%- JSON.stringify(cards || []) %>;

    function openEditModal(cardId) {
      const c = cardsData.find(item => item.id === cardId);
      if (!c) return;

      document.getElementById('editCardForm').action = `/admin/cards/${c.id}/update`;
      document.getElementById('edit_card_name').value = c.name;
      document.getElementById('edit_card_type').value = c.type;
      document.getElementById('edit_card_element').value = c.element;
      document.getElementById('edit_card_rarity').value = c.rarity;
      document.getElementById('edit_card_description').value = c.description;
      document.getElementById('edit_card_energy_cost').value = c.energy_cost;
      document.getElementById('edit_card_damage').value = c.damage;
      document.getElementById('edit_card_defense').value = c.defense;
      document.getElementById('edit_card_break_damage').value = c.break_damage;
      document.getElementById('edit_card_effect_code').value = c.effect_code || 'NONE';
      document.getElementById('edit_card_cooldown').value = c.cooldown;
      document.getElementById('edit_card_combo_modifier').value = c.combo_modifier || 'STANDARD';

      const editModal = new bootstrap.Modal(document.getElementById('editCardModal'));
      editModal.show();
    }
  </script>

  <!-- Rodapé Oficial -->
  <%- include('../partials/footer') %>
</body>
