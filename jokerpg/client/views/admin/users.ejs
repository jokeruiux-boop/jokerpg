<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
  <%- include('../partials/head') %>

  <!-- Google Fonts: Plus Jakarta Sans, Outfit & Cinzel (Tipografia Gótica / Dark Fantasy) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Google Material Symbols Oficial (Sem Emojis) -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <!-- Biblioteca SweetAlert2 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    /* ==========================================================================
       JOKER RPG — MODERAÇÃO DE JOGADORES DARK FANTASY (DESIGN CHAPADO DIABLO / MMO)
       Molduras em Ferro Forjado, Tábua de Contas e Cantoneiras de Ouro
       ========================================================================== */

    :root[data-theme="dark"] {
      --gothic-bg: #090404;
      --gothic-bg-overlay: radial-gradient(circle at 50% 30%, rgba(50, 15, 15, 0.6) 0%, rgba(10, 3, 3, 0.92) 65%, #050101 100%);
      --gothic-frame-bg: #140707;
      --gothic-panel: #0d0404;
      --gothic-panel-card: linear-gradient(180deg, #180808 0%, #0d0303 100%);
      --gothic-border-outer: #381010;
      --gothic-border-gold: #b38b4d;
      --gothic-border-gold-glow: rgba(179, 139, 77, 0.45);
      --gothic-filigree: #8a6530;
      --gothic-text: #eae0d5;
      --gothic-text-gold: #d4af37;
      --gothic-text-muted: #8e7a6d;
      --gothic-red-glow: rgba(220, 38, 38, 0.7);
      --gothic-slot-bg: #190505;
      --gothic-slot-border: #4a1515;
      --gothic-hotbar-bg: #100505;
    }

    :root[data-theme="light"] {
      --gothic-bg: #ece6dc;
      --gothic-bg-overlay: radial-gradient(circle at 50% 30%, rgba(240, 230, 218, 0.75) 0%, rgba(215, 200, 185, 0.9) 65%, #c8bcae 100%);
      --gothic-frame-bg: #dcd3c3;
      --gothic-panel: #f4eee2;
      --gothic-panel-card: linear-gradient(180deg, #ffffff 0%, #f1e9dc 100%);
      --gothic-border-outer: #8a6e55;
      --gothic-border-gold: #966f2d;
      --gothic-border-gold-glow: rgba(150, 111, 45, 0.3);
      --gothic-filigree: #78531e;
      --gothic-text: #261c14;
      --gothic-text-gold: #825a17;
      --gothic-text-muted: #6e5a4c;
      --gothic-red-glow: rgba(185, 28, 28, 0.4);
      --gothic-slot-bg: #e2d7c5;
      --gothic-slot-border: #9c846e;
      --gothic-hotbar-bg: #cfc2ad;
    }

    body {
      background: var(--gothic-bg) !important;
      color: var(--gothic-text);
      font-family: 'Plus Jakarta Sans', sans-serif;
      min-height: 100vh;
      margin: 0;
      padding: 0;
      transition: background-color 0.25s ease, color 0.25s ease;
      user-select: none;
      position: relative;
    }

    .material-symbols-outlined {
      font-family: 'Material Symbols Outlined';
      font-weight: 500;
      font-size: 20px;
      line-height: 1;
      display: inline-block;
      vertical-align: middle;
    }

    /* Cenário de Fundo da Arena */
    .gothic-viewport-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-image: var(--gothic-bg-overlay), url('/images/backgrounds/arena-bg.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: 1;
      pointer-events: none;
    }

    .gothic-admin-wrapper {
      position: relative;
      z-index: 10;
      max-width: 1440px;
      margin: 20px auto 50px auto;
      padding: 0 16px;
    }

    /* Moldura Principal de Ferro e Pedra */
    .gothic-main-frame {
      background: var(--gothic-frame-bg);
      border: 4px solid var(--gothic-border-outer);
      border-radius: 4px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.95), inset 0 0 30px rgba(0, 0, 0, 0.85);
      position: relative;
      padding: 8px;
    }

    /* Cantoneiras Metálicas Ornamentais */
    .gothic-corner {
      position: absolute;
      width: 20px;
      height: 20px;
      border: 2.5px solid var(--gothic-border-gold);
      z-index: 10;
      pointer-events: none;
    }
    .gothic-corner.top-left { top: 2px; left: 2px; border-right: none; border-bottom: none; }
    .gothic-corner.top-right { top: 2px; right: 2px; border-left: none; border-bottom: none; }
    .gothic-corner.bottom-left { bottom: 2px; left: 2px; border-right: none; border-top: none; }
    .gothic-corner.bottom-right { bottom: 2px; right: 2px; border-left: none; border-top: none; }

    /* Barra Superior de Abas */
    .gothic-nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 2px solid #2d0b0b;
      background: #090202;
      padding: 6px 16px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .gothic-tabs-group {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .gothic-tab-link {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.86rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #634f47;
      text-decoration: none;
      padding: 6px 10px;
      position: relative;
      transition: all 0.2s ease;
    }

    .gothic-tab-link:hover {
      color: #b58d60;
    }

    .gothic-tab-link.active {
      color: #ffffff;
      text-shadow: 0 0 10px var(--gothic-red-glow), 0 0 20px rgba(255, 30, 0, 0.8);
    }

    .gothic-tab-link.active::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent 0%, #ff3b30 50%, transparent 100%);
      box-shadow: 0 0 8px #ff3b30;
    }

    .gothic-theme-toggle-btn {
      background: transparent;
      border: 1px solid var(--gothic-filigree);
      color: var(--gothic-text-gold);
      padding: 4px 10px;
      border-radius: 2px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      font-family: 'Cinzel', serif;
      font-size: 0.74rem;
      transition: all 0.15s ease;
    }

    /* Cabeçalho de Moderação */
    .gothic-admin-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 2px solid #2d0b0b;
      position: relative;
      flex-wrap: wrap;
      gap: 16px;
    }

    .gothic-header-title-box {
      text-align: left;
    }

    .gothic-header-main-title {
      font-family: 'Cinzel', serif;
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--gothic-text);
      line-height: 1.1;
      margin: 0;
    }

    .gothic-header-sub {
      font-family: 'Cinzel', serif;
      font-size: 0.72rem;
      letter-spacing: 2px;
      color: var(--gothic-text-gold);
      text-transform: uppercase;
      margin-top: 4px;
    }

    .gothic-emblem-medallion {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: radial-gradient(circle, #2e0909 0%, #0d0202 100%);
      border: 2px solid #5a1818;
      box-shadow: inset 0 0 10px #000, 0 0 15px rgba(220, 38, 38, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Painel de Filtros e Busca Gótico */
    .gothic-filter-strip {
      background: var(--gothic-panel);
      border: 1px solid var(--gothic-border-gold);
      padding: 14px 18px;
      margin: 14px;
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.85);
    }

    .gothic-input, .gothic-select {
      background: var(--gothic-slot-bg);
      border: 1px solid var(--gothic-slot-border);
      color: var(--gothic-text);
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      letter-spacing: 1px;
      padding: 6px 12px;
      border-radius: 2px;
      outline: none;
      width: 100%;
      transition: all 0.15s ease;
    }

    .gothic-input:focus, .gothic-select:focus {
      border-color: var(--gothic-border-gold);
      box-shadow: 0 0 8px var(--gothic-border-gold-glow);
    }

    /* Tabela Gótica de Usuários */
    .gothic-table-container {
      background: var(--gothic-panel);
      border: 2px solid var(--gothic-border-gold);
      box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.9);
      margin: 0 14px 14px 14px;
      overflow: hidden;
    }

    .gothic-users-table {
      width: 100%;
      border-collapse: collapse;
      margin: 0;
      color: var(--gothic-text);
      font-family: 'Cinzel', serif;
    }

    .gothic-users-table th {
      background: #110404;
      color: var(--gothic-text-gold);
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      padding: 14px 16px;
      border-bottom: 2px solid var(--gothic-border-gold);
    }

    .gothic-users-table td {
      padding: 12px 16px;
      vertical-align: middle;
      border-bottom: 1px solid rgba(179, 139, 77, 0.2);
      font-size: 0.86rem;
      transition: background 0.15s ease;
    }

    .gothic-users-table tr:hover td {
      background: rgba(179, 139, 77, 0.1);
    }

    .user-avatar-gothic {
      width: 36px;
      height: 36px;
      border-radius: 4px;
      object-fit: cover;
      border: 1px solid var(--gothic-border-gold);
      background: #000;
    }

    .gothic-btn {
      font-family: 'Cinzel', serif;
      font-weight: 700;
      font-size: 0.76rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 6px 14px;
      border-radius: 2px;
      border: 1px solid var(--gothic-border-gold);
      background: linear-gradient(180deg, #3d1414 0%, #170505 100%);
      color: #ffffff;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
      transition: all 0.15s ease;
    }

    .gothic-btn:hover {
      background: linear-gradient(180deg, #6c1c1c 0%, #2e0909 100%);
      border-color: #ffaa00;
      color: #ffdd44;
      transform: scale(1.02);
    }

    .gothic-btn.secondary {
      background: transparent;
      border-color: var(--gothic-border-gold);
      color: var(--gothic-text-gold);
    }

    .gothic-btn.secondary:hover {
      background: rgba(179, 139, 77, 0.15);
      color: #ffffff;
    }

    .gothic-btn.unlock-btn {
      border-color: #10b981;
      color: #10b981;
    }

    .gothic-btn.unlock-btn:hover {
      background: linear-gradient(180deg, #10593b 0%, #062b1c 100%);
      color: #ffffff;
    }

    .gothic-btn.block-btn {
      border-color: #ef4444;
      color: #ef4444;
    }

    .gothic-btn.block-btn:hover {
      background: linear-gradient(180deg, #991b1b 0%, #450a0a 100%);
      color: #ffffff;
    }

    /* Paginação Gótica */
    .gothic-pagination-bar {
      padding: 16px 20px;
      border-top: 2px solid #2d0b0b;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
    }

    .gothic-page-link {
      font-family: 'Cinzel', serif;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--gothic-text-gold);
      border: 1px solid var(--gothic-border-gold);
      background: var(--gothic-slot-bg);
      padding: 5px 12px;
      text-decoration: none;
      border-radius: 2px;
      transition: all 0.15s ease;
    }

    .gothic-page-link:hover {
      background: #4a1515;
      color: #ffffff;
    }

    /* Barra Inferior com Orbe */
    .gothic-bottom-hotbar {
      background: var(--gothic-hotbar-bg);
      border-top: 2px solid #3d0c0c;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
    }

    .gothic-orb-assembly {
      position: absolute;
      left: 50%;
      top: -24px;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 25;
    }

    .gothic-orb-sphere {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #ffaa00 0%, #cc7700 50%, #442200 100%);
      box-shadow: 0 0 25px rgba(255, 170, 0, 0.85), inset 0 -6px 14px rgba(0, 0, 0, 0.8);
      position: relative;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s ease;
    }

    .gothic-orb-sphere:hover {
      transform: scale(1.08);
    }

    @media (max-width: 991px) {
      .gothic-admin-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .gothic-orb-assembly {
        position: static;
        transform: none;
        margin: 10px auto;
      }
      .gothic-bottom-hotbar {
        flex-direction: column;
        gap: 16px;
      }
    }
  </style>
</head>
<body>
  <!-- Fundo Atmosférico Real da Pasta /images/backgrounds/arena-bg.jpg -->
  <div class="gothic-viewport-bg"></div>

  <!-- Barra Superior de Navegação -->
  <%- include('../partials/navbar') %>

  <!-- ========================================================================
       JANELA GÓTICA CHAPADA DE MODERAÇÃO DE JOGADORES (ADMIN CORE)
       ======================================================================== -->
  <main class="gothic-admin-wrapper">
    <!-- Alertas Globais -->
    <%- include('../partials/messages') %>

    <div class="gothic-main-frame">
      <!-- Cantoneiras Ornamentais de Ferro e Ouro -->
      <span class="gothic-corner top-left"></span>
      <span class="gothic-corner top-right"></span>
      <span class="gothic-corner bottom-left"></span>
      <span class="gothic-corner bottom-right"></span>

      <!-- 1. Abas Superiores do Admin -->
      <header class="gothic-nav-bar">
        <div class="gothic-tabs-group">
          <a href="/admin/users" class="gothic-tab-link active">JOGADORES (MODERAÇÃO)</a>
          <a href="/admin" class="gothic-tab-link">CONSOLE</a>
          <a href="/admin/characters" class="gothic-tab-link">HERÓIS</a>
          <a href="/admin/cards" class="gothic-tab-link">CARTAS</a>
          <a href="/admin/battles" class="gothic-tab-link">BATALHAS</a>
          <a href="/admin/missions" class="gothic-tab-link">MISSÕES</a>
          <a href="/admin/logs" class="gothic-tab-link">AUDITORIA</a>
        </div>

        <button type="button" class="gothic-theme-toggle-btn" onclick="toggleGothicTheme()" title="Alternar Modo Claro e Escuro">
          <span class="material-symbols-outlined" style="font-size: 16px;">contrast</span>
          <span id="themeText">DARK</span>
        </button>
      </header>

      <!-- 2. Cabeçalho de Moderação -->
      <section class="gothic-admin-header">
        <div class="gothic-header-title-box">
          <h1 class="gothic-header-main-title">Tribunal de Moderação de Contas</h1>
          <div class="gothic-header-sub">Supervisão de Duelistas &bull; Bloqueio e Restrição de Acesso</div>
        </div>

        <div class="gothic-emblem-medallion">
          <span class="material-symbols-outlined" style="font-size: 28px; color: #ff3333; filter: drop-shadow(0 0 6px rgba(255,51,51,0.8));">group</span>
        </div>

        <div class="font-monospace small" style="color: var(--gothic-text-gold);">
          REGISTROS: <strong class="text-main"><%= pagination.total %></strong> JOGADORES
        </div>
      </section>

      <!-- 3. Painel de Filtros e Busca Gótico -->
      <section class="gothic-filter-strip">
        <form action="/admin/users" method="GET" class="row g-2 align-items-center">
          <div class="col-12 col-md-5">
            <input 
              type="text" 
              class="gothic-input" 
              name="search" 
              placeholder="BUSCAR POR NOME OU E-MAIL..." 
              value="<%= filters.search %>"
            >
          </div>

          <div class="col-6 col-md-3">
            <select name="role" class="gothic-select">
              <option value="">TODOS OS PAPÉIS</option>
              <option value="USER_NORMAL" <%= filters.role === 'USER_NORMAL' ? 'selected' : '' %>>USER_NORMAL</option>
              <option value="ADMIN_SUPREMO" <%= filters.role === 'ADMIN_SUPREMO' ? 'selected' : '' %>>ADMIN_SUPREMO</option>
            </select>
          </div>

          <div class="col-6 col-md-2">
            <select name="isBlocked" class="gothic-select">
              <option value="">STATUS: TODOS</option>
              <option value="false" <%= filters.isBlocked === 'false' ? 'selected' : '' %>>ATIVOS</option>
              <option value="true" <%= filters.isBlocked === 'true' ? 'selected' : '' %>>BLOQUEADOS</option>
            </select>
          </div>

          <div class="col-12 col-md-2 d-flex gap-1">
            <button type="submit" class="gothic-btn w-100 py-1" style="font-size: 0.72rem;">
              <span class="material-symbols-outlined" style="font-size: 15px;">filter_alt</span> FILTRAR
            </button>
            <% if (filters.search || filters.role || filters.isBlocked) { %>
              <a href="/admin/users" class="gothic-btn secondary py-1 px-2" title="Limpar Filtros" style="width: auto;">
                <span class="material-symbols-outlined" style="font-size: 15px;">close</span>
              </a>
            <% } %>
          </div>
        </form>
      </section>

      <!-- 4. Tabela Gótica de Jogadores -->
      <section class="gothic-table-container">
        <% if (users && users.length > 0) { %>
          <div class="table-responsive">
            <table class="gothic-users-table">
              <thead>
                <tr>
                  <th>Combatente</th>
                  <th>E-mail</th>
                  <th class="text-center">Papel</th>
                  <th class="text-center">Nível</th>
                  <th class="text-center">Poder</th>
                  <th class="text-center">Moedas</th>
                  <th class="text-center">Status</th>
                  <th class="text-center">Ingresso</th>
                  <th class="text-end">Moderação</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(function(u) { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <img src="/images/avatar/<%= u.id %>" alt="<%= u.username %>" class="user-avatar-gothic" onerror="this.onerror=null; this.src='/images/default-avatar.png';">
                        <span class="fw-bold text-main font-monospace"><%= u.username %></span>
                      </div>
                    </td>
                    <td class="text-muted font-monospace small"><%= u.email %></td>
                    <td class="text-center">
                      <span class="badge" style="background: <%= u.role === 'ADMIN_SUPREMO' ? '#b38b4d' : '#250808' %>; color: <%= u.role === 'ADMIN_SUPREMO' ? '#000' : '#eae0d5' %>; border: 1px solid var(--gothic-border-gold); font-size: 0.65rem;">
                        <%= u.role %>
                      </span>
                    </td>
                    <td class="text-center font-monospace" style="color: var(--gothic-text-gold);">
                      LV <%= u.level %>
                    </td>
                    <td class="text-center font-monospace fw-bold text-primary">
                      <%= u.power_index %>
                    </td>
                    <td class="text-center font-monospace text-warning">
                      <%= u.coins %>
                    </td>
                    <td class="text-center font-monospace">
                      <% if (u.is_blocked) { %>
                        <span class="badge bg-danger" style="font-size: 0.62rem;">BLOQUEADO</span>
                      <% } else { %>
                        <span class="badge bg-success" style="font-size: 0.62rem;">ATIVO</span>
                      <% } %>
                    </td>
                    <td class="text-center text-dim font-monospace" style="font-size: 0.72rem;">
                      <%= new Date(u.created_at).toLocaleDateString('pt-BR') %>
                    </td>
                    <td class="text-end">
                      <% if (u.role !== 'ADMIN_SUPREMO') { %>
                        <form action="/admin/users/<%= u.id %>/toggle-block" method="POST" class="m-0" data-confirm="Deseja realmente <%= u.is_blocked ? 'desbloquear' : 'bloquear' %> o acesso deste combatente?">
                          <button type="submit" class="gothic-btn <%= u.is_blocked ? 'unlock-btn' : 'block-btn' %> py-1 px-3" style="font-size: 0.7rem;">
                            <span class="material-symbols-outlined" style="font-size: 14px;"><%= u.is_blocked ? 'lock_open' : 'lock' %></span>
                            <%= u.is_blocked ? 'Desbloquear' : 'Bloquear' %>
                          </button>
                        </form>
                      <% } else { %>
                        <span class="text-dim small font-monospace">Protegido</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <!-- Paginação -->
          <% if (pagination.totalPages > 1) { %>
            <div class="gothic-pagination-bar">
              <% if (pagination.currentPage > 1) { %>
                <a class="gothic-page-link" href="/admin/users?page=<%= pagination.currentPage - 1 %>&search=<%= filters.search %>&role=<%= filters.role %>&isBlocked=<%= filters.isBlocked %>">&laquo; ANTERIOR</a>
              <% } %>

              <span class="small font-monospace" style="color: var(--gothic-text-muted);">
                PÁGINA <%= pagination.currentPage %> DE <%= pagination.totalPages %>
              </span>

              <% if (pagination.currentPage < pagination.totalPages) { %>
                <a class="gothic-page-link" href="/admin/users?page=<%= pagination.currentPage + 1 %>&search=<%= filters.search %>&role=<%= filters.role %>&isBlocked=<%= filters.isBlocked %>">PRÓXIMA &raquo;</a>
              <% } %>
            </div>
          <% } %>
        <% } else { %>
          <div class="p-5 text-center text-muted font-monospace small">
            <span class="material-symbols-outlined" style="font-size: 48px; opacity: 0.3; margin-bottom: 12px;">group_off</span>
            <p class="mb-0">Nenhum jogador localizado com os filtros selecionados.</p>
          </div>
        <% } %>
      </section>

      <!-- 5. Barra Inferior com Orbe de Comando -->
      <footer class="gothic-bottom-hotbar">
        <div class="d-flex align-items-center gap-2">
          <a href="/admin" class="gothic-tab-link" title="Console">
            <span class="material-symbols-outlined" style="font-size: 22px;">dashboard</span>
          </a>
          <a href="/admin/characters" class="gothic-tab-link" title="Heróis">
            <span class="material-symbols-outlined" style="font-size: 22px;">sports_martial_arts</span>
          </a>
          <a href="/admin/cards" class="gothic-tab-link" title="Cartas">
            <span class="material-symbols-outlined" style="font-size: 22px;">style</span>
          </a>
        </div>

        <!-- ORBE CENTRAL DE COMANDO -->
        <div class="gothic-orb-assembly">
          <div class="gothic-orb-sphere" title="Moderação de Jogadores">
            <span class="material-symbols-outlined text-white" style="font-size: 32px; filter: drop-shadow(0 0 8px #ffffff);">group</span>
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/admin/battles" class="gothic-tab-link" title="Batalhas">
            <span class="material-symbols-outlined" style="font-size: 22px;">swords</span>
          </a>
          <a href="/admin/logs" class="gothic-tab-link" title="Auditoria">
            <span class="material-symbols-outlined" style="font-size: 22px;">receipt_long</span>
          </a>
          <a href="/dashboard" class="gothic-tab-link" title="Quartel-General">
            <span class="material-symbols-outlined" style="font-size: 22px;">sports_esports</span>
          </a>
        </div>
      </footer>
    </div>
  </main>

  <!-- Lógica JavaScript do Tema -->
  <script>
    function applyGothicTheme() {
      const theme = localStorage.getItem('joker_theme') || 'dark';
      document.documentElement.setAttribute('data-theme', theme);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = theme === 'dark' ? 'DARK' : 'LIGHT';
    }

    function toggleGothicTheme() {
      const current = document.documentElement.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('joker_theme', next);
      const txt = document.getElementById('themeText');
      if (txt) txt.textContent = next === 'dark' ? 'DARK' : 'LIGHT';

      if (window.Joker && window.Joker.Audio) {
        window.Joker.Audio.playUiClick();
      }
    }

    applyGothicTheme();
  </script>

  <!-- Rodapé Oficial -->
  <%- include('../partials/footer') %>
</body>
</html>